<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="cacLuotKhamBanBaoCao" spacing="20" minWidth="0" prefHeight="1177">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="bao-cao-bo-loc-the">
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="bao-cao-truong">
            <Label text="Từ ngày" styleClass="bao-cao-truong-nhan"/>
            <DatePicker fx:id="dpCacLuotKhamTu" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="bao-cao-ngay">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="bao-cao-truong">
            <Label text="Đến ngày" styleClass="bao-cao-truong-nhan"/>
            <DatePicker fx:id="dpCacLuotKhamDen" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="bao-cao-ngay">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="bao-cao-truong">
            <Label text="Nha sĩ" styleClass="bao-cao-truong-nhan"/>
            <ComboBox fx:id="cboCacLuotKhamNhaSi" maxWidth="Infinity" minWidth="0" styleClass="bao-cao-bo-loc" accessibleText="Lọc nha sĩ, dữ liệu mẫu" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="bao-cao-truong">
            <Label text="Trạng thái" styleClass="bao-cao-truong-nhan"/>
            <ComboBox fx:id="cboCacLuotKhamTinhTrang" maxWidth="Infinity" minWidth="0" styleClass="bao-cao-bo-loc" accessibleText="Lọc trạng thái, dữ liệu mẫu" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                        <String fx:value="Đã hoàn tất"/>
                        <String fx:value="Đã hủy"/>
                        <String fx:value="Không đến"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <Button fx:id="btnApDungCacLuotKhamBanBaoCao" text="Áp dụng" minWidth="-Infinity" styleClass="chinh-nut" disable="true"/>
    </HBox>
    <GridPane fx:id="cacLuotKhamCacChiSo" hgap="16" minHeight="132" prefHeight="132" maxHeight="132">
        <rowConstraints>
            <RowConstraints percentHeight="100" fillHeight="true"/>
        </rowConstraints>
        <columnConstraints>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="8" minWidth="0" styleClass="bao-cao-the" GridPane.columnIndex="0">
            <Label text="Tổng lượt khám" styleClass="bao-cao-chi-so-nhan" wrapText="true"/>
            <Label fx:id="lblCacLuotKhamTong" text="—" styleClass="bao-cao-chi-so-gia-tri" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblCacLuotKhamTongGhiChu" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="bao-cao-the" GridPane.columnIndex="1">
            <Label text="Lượt khám hôm nay" styleClass="bao-cao-chi-so-nhan" wrapText="true"/>
            <Label fx:id="lblCacLuotKhamHomNay" text="—" styleClass="bao-cao-chi-so-gia-tri" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblCacLuotKhamHomNayGhiChu" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="bao-cao-the" GridPane.columnIndex="2">
            <Label text="Trung bình lượt/ngày" styleClass="bao-cao-chi-so-nhan" wrapText="true"/>
            <Label fx:id="lblCacLuotKhamTrungBinh" text="—" styleClass="bao-cao-chi-so-gia-tri" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblCacLuotKhamTrungBinhGhiChu" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="bao-cao-the" GridPane.columnIndex="3">
            <Label text="Tỷ lệ hoàn tất" styleClass="bao-cao-chi-so-nhan" wrapText="true"/>
            <Label fx:id="lblCacLuotKhamHoanTatTyLe" text="—" styleClass="bao-cao-chi-so-gia-tri" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblCacLuotKhamHoanTatTyLeGhiChu" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich" minHeight="-Infinity" wrapText="true"/>
        </VBox>
    </GridPane>
    <VBox spacing="16" minWidth="0" styleClass="bao-cao-the">
        <Label fx:id="lblCacLuotKhamBieuDoTieuDe" text="Lượt khám theo ngày" styleClass="bao-cao-the-tieu-de"/>
        <Label fx:id="lblCacLuotKhamBieuDoPhuDe" text="Tổng lượt khám theo ngày, gồm các trạng thái" styleClass="bao-cao-chu-thich" wrapText="true"/>
        <!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
        <HBox fx:id="bieuDoCacLuotKham" spacing="20" alignment="BOTTOM_CENTER" minHeight="222" prefHeight="222" maxHeight="222" styleClass="bao-cao-bieu-do" accessibleText="Lượt khám theo ngày, dữ liệu minh họa">
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri1" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham1" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri2" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham2" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri3" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham3" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri4" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham4" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri5" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham5" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri6" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham6" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri7" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham7" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri8" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham8" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblCacLuotKhamThanhGiaTri9" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhCacLuotKham9" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh, bao-cao-thanh-nhan-manh"/>
                <Label text="—" styleClass="bao-cao-truc-nhan"/>
            </VBox>
        </HBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="bao-cao-duong-phan-cach"/>
        <Label fx:id="lblCacLuotKhamBieuDoGhiChu" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="16" minWidth="0" styleClass="bao-cao-the">
        <Label text="Dữ liệu chi tiết" styleClass="bao-cao-the-tieu-de"/>
        <VBox styleClass="bao-cao-bang-vien">
            <!-- Chỉ đọc; không mở chi tiết, không hover/selected highlight.
                 editable=false không tắt selection: Nhi tự setSelectionModel(null) khi nối Controller. -->
            <TableView fx:id="tblCacLuotKham" editable="false" focusTraversable="false" fixedCellSize="72" minHeight="326" prefHeight="326" maxHeight="326" styleClass="bao-cao-bang">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colCacLuotKhamNgay" text="Ngày" prefWidth="185" minWidth="130" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="date"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colCacLuotKhamTong" text="Tổng lượt khám" prefWidth="185" minWidth="135" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="total"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colCacLuotKhamDaHoanTat" text="Đã hoàn tất" prefWidth="185" minWidth="120" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="completed"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colCacLuotKhamDaHuy" text="Đã hủy" prefWidth="185" minWidth="100" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="cancelled"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colCacLuotKhamKhongCoHien" text="Không đến" prefWidth="185" minWidth="110" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="noShow"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colCacLuotKhamHoanTatTyLe" text="Tỷ lệ hoàn tất" prefWidth="185" minWidth="130" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="rate"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="6" alignment="CENTER_LEFT" minHeight="40" prefHeight="40" styleClass="bao-cao-bang-chan">
                <Label fx:id="lblCacLuotKhamHoSoSoLuong" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCacLuotKhamTruocTrang" text="‹" disable="true" accessibleText="Trang báo cáo trước" styleClass="bao-cao-trang-nut"/>
                <Label fx:id="lblCacLuotKhamHienTaiTrang" text="—" styleClass="bao-cao-chu-thich"/>
                <Button fx:id="btnCacLuotKhamTiepTrang" text="›" disable="true" accessibleText="Trang báo cáo tiếp theo, chưa có xử lý" styleClass="bao-cao-trang-nut"/>
            </HBox>
        </VBox>
    </VBox>
    <VBox spacing="2">
        <Label fx:id="lblCacLuotKhamTheoNhaSi" text="—" styleClass="bao-cao-chu-thich" wrapText="true" minHeight="-Infinity"/>
    </VBox>
</VBox>
