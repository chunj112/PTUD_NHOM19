<?xml version="1.0" encoding="UTF-8"?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="quanLyTongQuan" stylesheets="@/css/quan-ly-tong-quan.css" styleClass="quan-ly-tong-quan" spacing="20" minWidth="980">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0">
            <Label fx:id="lblTongQuanTieuDe" text="Tổng quan phòng khám" wrapText="true" styleClass="tong-quan-tieu-de"/>
        </VBox>
        <Button fx:id="btnXemBaoCao" id="btnXemBaoCao" text="Xem báo cáo" graphicTextGap="8" styleClass="phu-nut" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/shell/dashboard-reports.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <!-- Bốn chỉ số ngang nhau, khoảng cách 16px như 1:2924. -->
    <GridPane fx:id="cacChiSoLuoi" hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <VBox GridPane.columnIndex="0" spacing="8" minWidth="0" styleClass="tong-quan-the, tong-quan-chi-so-the">
            <Label text="Bệnh nhân hôm nay" styleClass="tong-quan-chi-so-nhan"/>
            <Label fx:id="lblDanhSachBenhNhanHomNay" text="—" styleClass="tong-quan-chi-so-gia-tri"/>
            <Label fx:id="lblDanhSachBenhNhanGoiY" text="Chưa tải dữ liệu" styleClass="tong-quan-chu-thich"/>
        </VBox>
        <VBox GridPane.columnIndex="1" spacing="8" minWidth="0" styleClass="tong-quan-the, tong-quan-chi-so-the">
            <Label text="Lịch hẹn hôm nay" styleClass="tong-quan-chi-so-nhan"/>
            <Label fx:id="lblDanhSachLichHenHomNay" text="—" styleClass="tong-quan-chi-so-gia-tri"/>
            <Label fx:id="lblDanhSachLichHenGoiY" text="Chưa tải dữ liệu" styleClass="tong-quan-chu-thich"/>
        </VBox>
        <VBox GridPane.columnIndex="2" spacing="8" minWidth="0" styleClass="tong-quan-the, tong-quan-chi-so-the">
            <Label text="Doanh thu hôm nay" styleClass="tong-quan-chi-so-nhan"/>
            <Label fx:id="lblDoanhThuHomNay" text="—" styleClass="tong-quan-chi-so-gia-tri"/>
            <Label fx:id="lblDoanhThuXuHuong" text="—" styleClass="tong-quan-chu-thich"/>
        </VBox>
        <VBox GridPane.columnIndex="3" spacing="8" minWidth="0" styleClass="tong-quan-the, tong-quan-chi-so-the">
            <Label text="Dịch vụ đã thực hiện hôm nay" wrapText="true" minHeight="-Infinity" styleClass="tong-quan-chi-so-nhan"/>
            <Label fx:id="lblDanhMucDichVuHomNay" text="—" styleClass="tong-quan-chi-so-gia-tri"/>
            <Label fx:id="lblDanhMucDichVuXuHuong" text="—" styleClass="tong-quan-chu-thich"/>
        </VBox>
    </GridPane>
    <!-- Cột trái co giãn, cột phải 320px. Không bọc ScrollPane thứ hai. -->
    <HBox fx:id="tongQuanCacCot" spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS">
            <VBox spacing="16" styleClass="tong-quan-the">
                <Label text="Lịch khám gần nhất" styleClass="tong-quan-the-tieu-de"/>
                <Label text="Các lịch hẹn trong ca sáng" styleClass="tong-quan-chu-thich"/>
                <VBox styleClass="tong-quan-bang-vien">
                    <!-- Chỉ xem: không gắn click/double-click mở chi tiết.
                         CSS bỏ highlight; Controller sau này gọi
                         tblRecentAppointments.setSelectionModel(null) nếu cần tắt chọn dòng thực sự.
                         Không disable/mouseTransparent để vẫn cuộn bảng bình thường. -->
                    <TableView fx:id="tblGanNhatDanhSachLichHen" fixedCellSize="72" minHeight="330" prefHeight="330" maxHeight="330" editable="false" focusTraversable="false" styleClass="tong-quan-bang, chi-doc-bang">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colGio" text="Giờ" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="time"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colBenhNhan" text="Bệnh nhân" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="patient"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colNhaSi" text="Nha sĩ" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="dentist"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colLyDo" text="Lý do khám" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="reason"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colTinhTrang" text="Trạng thái" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="status"/>
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_LEFT" spacing="6" minHeight="38" prefHeight="38" styleClass="tong-quan-bang-chan">
                        <Label fx:id="lblDanhSachLichHenSoLuong" text="Chưa tải dữ liệu" styleClass="tong-quan-chu-thich"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
                        <Button fx:id="btnTruocDanhSachLichHen" text="‹" disable="true" accessibleText="Trang lịch khám trước" styleClass="tong-quan-trang-nut"/>
                        <Label fx:id="lblDanhSachLichHenTrang" text="—" styleClass="tong-quan-chu-thich"/>
                        <Button fx:id="btnTiepDanhSachLichHen" text="›" disable="true" accessibleText="Trang lịch khám tiếp theo" styleClass="tong-quan-trang-nut"/>
                    </HBox>
                </VBox>
            </VBox>
            <VBox spacing="16" styleClass="tong-quan-the">
                <Label text="Hoạt động hôm nay" styleClass="tong-quan-the-tieu-de"/>
                <TableView fx:id="tblHomNayHoatDong" fixedCellSize="72" minHeight="330" prefHeight="330" maxHeight="330" styleClass="tong-quan-bang, tong-quan-hoat-dong-bang">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colHoatDongGio" text="Thời gian" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="time"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colHoatDong" text="Hoạt động" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="activity"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colNguoiThucHien" text="Người thực hiện" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="actor"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
        <!-- Chỉ giữ một card bên phải, tự co chiều cao theo nội dung. -->
        <VBox spacing="16" minWidth="320" prefWidth="320" maxWidth="320" maxHeight="-Infinity" styleClass="tong-quan-the">
            <Label text="Tình hình trong ngày" styleClass="tong-quan-the-tieu-de"/>
            <VBox spacing="6">
                <Label text="Đã tiếp nhận" styleClass="tong-quan-chu-thich"/>
                <Label fx:id="lblDaNhan" text="—" styleClass="tong-quan-tom-tat"/>
            </VBox>
            <Separator/>
            <VBox spacing="6">
                <Label text="Phiếu khám hoàn tất" styleClass="tong-quan-chu-thich"/>
                <Label fx:id="lblDaHoanTat" text="—" styleClass="tong-quan-tom-tat"/>
            </VBox>
            <Separator/>
            <VBox spacing="6">
                <Label text="Hóa đơn chờ thu" styleClass="tong-quan-chu-thich"/>
                <Label fx:id="lblChuaThanhToan" text="—" styleClass="tong-quan-tom-tat"/>
            </VBox>
            <Label fx:id="lblChoXuLyDanhSachLichHen" text="—" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="tong-quan-cung-dong-ghi-chu"/>
        </VBox>
    </HBox>
</VBox>
