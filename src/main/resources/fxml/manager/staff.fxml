<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="staffPage" stylesheets="@/css/manager-staff.css" styleClass="staff-page" spacing="20" minWidth="960">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblStaffTitle" text="Nhân sự" styleClass="staff-page-title"/>
            <Label fx:id="lblStaffSubtitle" text="Quản lý thông tin nhân viên, lịch làm việc và tài khoản theo vai trò" wrapText="true" minHeight="-Infinity" styleClass="staff-page-subtitle"/>
        </VBox>
        <Button fx:id="btnAddStaff" text="Thêm nhân viên" graphicTextGap="8" styleClass="primary-button" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/staff/add-staff.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <!-- Thanh tìm kiếm/lọc đúng ba ô trong frame; chưa có xử lý lọc dữ liệu. -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtStaffSearch" promptText="Tìm mã nhân viên / họ tên / SĐT" minWidth="0" HBox.hgrow="ALWAYS" styleClass="staff-search" accessibleText="Tìm nhân viên theo mã, họ tên hoặc số điện thoại"/>
        <ComboBox fx:id="cboPositionFilter" minWidth="180" prefWidth="180" maxWidth="180" styleClass="staff-filter" accessibleText="Lọc theo chức vụ" promptText="Tất cả chức vụ" value="Tất cả chức vụ">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả chức vụ"/>
                    <String fx:value="Quản lý"/>
                    <String fx:value="Nha sĩ"/>
                    <String fx:value="Lễ tân"/>
                    <String fx:value="Y tá"/>
                </FXCollections>
            </items>
        </ComboBox>
        <ComboBox fx:id="cboStatusFilter" minWidth="180" prefWidth="180" maxWidth="180" styleClass="staff-filter" accessibleText="Lọc theo trạng thái nhân viên" promptText="Tất cả trạng thái" value="Tất cả trạng thái">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả trạng thái"/>
                    <String fx:value="Hoạt động"/>
                    <String fx:value="Ngừng hoạt động"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>
    <HBox fx:id="staffColumns" spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" styleClass="staff-card">
            <Label text="Danh sách nhân viên" styleClass="staff-card-title"/>
            <Label fx:id="lblStaffCount" text="Chưa tải dữ liệu" styleClass="staff-caption"/>
            <VBox styleClass="staff-table-frame">
                <TableView fx:id="tblStaff" editable="false" fixedCellSize="72" minHeight="616" prefHeight="616" maxHeight="616" styleClass="staff-table">
                    <!-- Phân bố các cột theo chiều ngang bảng khi panel mặc định ẩn. -->
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colStaffId" text="Mã NV" prefWidth="65" minWidth="60" sortable="false" reorderable="false" styleClass="staff-id-column">
                            <cellValueFactory>
                                <MapValueFactory key="staffId"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colStaffName" text="Họ tên" prefWidth="135" minWidth="125" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="fullName"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colPosition" text="Chức vụ" prefWidth="75" minWidth="70" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="position"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colPhone" text="SĐT" prefWidth="115" minWidth="110" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="phone"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="180" minWidth="175" sortable="false" reorderable="false" styleClass="staff-email-column">
                            <cellValueFactory>
                                <MapValueFactory key="email"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colStaffStatus" text="Trạng thái" prefWidth="130" minWidth="125" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="status"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="6" minHeight="38" prefHeight="38" styleClass="staff-table-footer">
                    <Label fx:id="lblRecordCount" text="Chưa tải dữ liệu" styleClass="staff-caption"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
                    <Button fx:id="btnPreviousPage" text="‹" disable="true" accessibleText="Trang nhân viên trước" styleClass="staff-page-button"/>
                    <Label fx:id="lblCurrentPage" text="—" styleClass="staff-caption"/>
                    <Button fx:id="btnNextPage" text="›" disable="true" accessibleText="Trang nhân viên tiếp theo" styleClass="staff-page-button"/>
                </HBox>
            </VBox>
        </VBox>
        <!-- Chưa chọn nhân viên: ẩn cả panel và không giữ chỗ bên phải.
             Controller điền dữ liệu rồi hiện staffDetailsPane + staffSelectedDetails
             bằng cả visible/managed; bỏ chọn thì ẩn lại. Không hiện panel lời nhắc. -->
        <VBox fx:id="staffDetailsPane" spacing="16" minWidth="370" prefWidth="370" maxWidth="370" maxHeight="-Infinity" visible="false" managed="false" styleClass="staff-card">
            <VBox fx:id="staffEmptyDetails" spacing="16" visible="false" managed="false">
                <Label fx:id="lblDetailsTitle" text="Thông tin chi tiết nhân viên" styleClass="staff-card-title"/>
                <Separator/>
                <Label fx:id="lblDetailsPlaceholder" text="Chọn một nhân viên để xem thông tin chi tiết." wrapText="true" minHeight="-Infinity" styleClass="staff-details-hint"/>
                <Separator/>
            </VBox>
            <fx:include fx:id="staffSelectedDetails" source="staff-details.fxml" visible="false" managed="false"/>
        </VBox>
    </HBox>
    <Label fx:id="lblStaffDemoNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." wrapText="true" minHeight="-Infinity" styleClass="staff-caption"/>
</VBox>
