<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="servicesPage" stylesheets="@/css/manager-services.css" styleClass="services-page" spacing="20" minWidth="960" minHeight="-Infinity" maxHeight="-Infinity" fx:controller="vn.edu.nhom19.nhakhoa.view.manager.QuanLyDichVuController">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblServicesTitle" text="Dịch vụ" styleClass="services-title"/>
            <Label fx:id="lblServicesSubtitle" text="Danh mục và bảng giá sử dụng trong chỉ định điều trị" wrapText="true" minHeight="-Infinity" styleClass="services-subtitle"/>
        </VBox>
        <Button fx:id="btnAddService" text="Thêm dịch vụ" graphicTextGap="8" styleClass="primary-button" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/staff/add-staff.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtServiceSearch" promptText="Tìm mã / tên dịch vụ" minWidth="0" HBox.hgrow="ALWAYS" accessibleText="Tìm dịch vụ theo mã hoặc tên" styleClass="services-search"/>
        <ComboBox fx:id="cboServiceGroupFilter" minWidth="200" prefWidth="200" maxWidth="200" accessibleText="Lọc nhóm dịch vụ, dữ liệu mẫu" styleClass="services-filter" promptText="Tất cả nhóm dịch vụ" value="Tất cả nhóm dịch vụ">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả nhóm dịch vụ"/>
                    <String fx:value="Khám"/>
                    <String fx:value="Phục hồi"/>
                    <String fx:value="Dự phòng"/>
                    <String fx:value="Phẫu thuật"/>
                    <String fx:value="Nội nha"/>
                    <String fx:value="Thẩm mỹ"/>
                </FXCollections>
            </items>
        </ComboBox>
        <ComboBox fx:id="cboServiceStatusFilter" minWidth="180" prefWidth="180" maxWidth="180" accessibleText="Lọc trạng thái sử dụng dịch vụ" styleClass="services-filter" promptText="Chọn dịch vụ">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Đang hoạt động"/>
                    <String fx:value="Ngừng hoạt động"/>
                    <String fx:value="Tất cả trạng thái"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>
    <!-- Chưa chọn: bảng toàn chiều ngang theo 15:511.
         Khi Khang chọn dịch vụ: cập nhật Label, bật visible/managed của panel bên phải.
         Không có handler Java trong lượt UI này. -->
    <HBox fx:id="servicesContent" spacing="20" alignment="TOP_LEFT" minWidth="0">
        <VBox fx:id="servicesListCard" spacing="16" minWidth="0" styleClass="services-card" HBox.hgrow="ALWAYS">
            <Label fx:id="lblServicesListTitle" text="Danh mục dịch vụ" styleClass="services-card-title"/>
            <Label fx:id="lblServicesCurrencyHint" text="Đơn giá tính bằng VNĐ" styleClass="services-caption"/>
            <VBox styleClass="services-table-frame">
                <TableView fx:id="tblServices" editable="false" fixedCellSize="72" minHeight="472" prefHeight="472" maxHeight="472" styleClass="services-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colServiceId" text="Mã" minWidth="60" prefWidth="155" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="serviceId"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colServiceName" text="Tên" minWidth="125" prefWidth="260" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="name"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colServiceGroup" text="Nhóm dịch vụ" minWidth="98" prefWidth="211" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="group"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colServiceUnit" text="Đơn vị" minWidth="60" prefWidth="155" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="unit"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colServicePrice" text="Giá" minWidth="90" prefWidth="193" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="price"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colServiceStatus" text="Trạng thái" minWidth="110" prefWidth="135" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="status"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox spacing="6" alignment="CENTER_LEFT" minHeight="38" prefHeight="38" styleClass="services-table-footer">
                    <Label fx:id="lblServicesRecordCount" text="Chưa tải dữ liệu" styleClass="services-caption"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnServicesPreviousPage" text="‹" disable="true" accessibleText="Trang dịch vụ trước" styleClass="services-page-button"/>
                    <Label fx:id="lblServicesCurrentPage" text="—" styleClass="services-caption"/>
                    <Button fx:id="btnServicesNextPage" text="›" disable="true" accessibleText="Trang dịch vụ tiếp theo" styleClass="services-page-button"/>
                </HBox>
            </VBox>
        </VBox>
        <VBox fx:id="serviceDetailsPane" visible="false" managed="false" minWidth="356" prefWidth="356" maxWidth="356">
            <fx:include fx:id="selectedServiceDetails" source="service-details.fxml"/>
        </VBox>
    </HBox>
    <Label fx:id="lblServicesDemoNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." wrapText="true" minHeight="-Infinity" styleClass="services-caption"/>
</VBox>
