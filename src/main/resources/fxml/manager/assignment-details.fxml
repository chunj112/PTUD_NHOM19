<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="assignmentSelectedDetails" stylesheets="@/css/theme.css, @/css/assignment-forms.css" styleClass="assignment-detail" spacing="16" minWidth="222" prefWidth="222" maxWidth="222" maxHeight="-Infinity">
    <Label fx:id="lblSelectedAssignmentEmployee" text="—" wrapText="true" styleClass="assignment-detail-title"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="lblSelectedAssignmentEmployeeSummary" text="—" wrapText="true" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="assignment-detail-summary"/>
        <Label fx:id="lblSelectedEmployeeStatus" text="—" styleClass="assignment-status-badge"/>
    </HBox>
    <Separator/>
    <HBox spacing="12" alignment="TOP_LEFT">
        <VBox spacing="3" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS">
            <Label text="Ngày" styleClass="assignment-field-caption"/>
            <Label fx:id="lblAssignmentDate" text="—" wrapText="true" minHeight="-Infinity" styleClass="assignment-detail-value"/>
        </VBox>
        <VBox spacing="3" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS">
            <Label text="Ca làm việc" styleClass="assignment-field-caption"/>
            <Label fx:id="lblAssignmentShift" text="—" styleClass="assignment-detail-value"/>
        </VBox>
    </HBox>
    <VBox spacing="3">
        <Label text="Thời gian" styleClass="assignment-field-caption"/>
        <Label fx:id="lblAssignmentTime" text="—" styleClass="assignment-detail-value"/>
    </VBox>
    <VBox spacing="3">
        <Label text="Phòng" styleClass="assignment-field-caption"/>
        <Label fx:id="lblAssignmentRoom" text="—" styleClass="assignment-detail-value"/>
    </VBox>
    <VBox spacing="3">
        <Label text="Công việc" styleClass="assignment-field-caption"/>
        <Label fx:id="lblAssignmentWork" text="—" wrapText="true" minHeight="-Infinity" styleClass="assignment-detail-value"/>
    </VBox>
    <Separator/>
    <Label text="Trạng thái" styleClass="assignment-field-caption"/>
    <Label fx:id="lblAssignmentStatus" text="—" styleClass="assignment-status-badge"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnEditAssignment" text="Sửa" graphicTextGap="8" styleClass="secondary-button" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/staff/edit-staff.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnRequestCancelAssignment" text="Hủy" styleClass="secondary-button, assignment-danger-button" disable="true"/>
    </HBox>
</VBox>
