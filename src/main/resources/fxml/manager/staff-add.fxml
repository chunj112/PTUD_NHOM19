<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="addStaffForm" stylesheets="@/css/theme.css, @/css/staff-form.css" styleClass="staff-form" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" maxHeight="-Infinity">
    <HBox alignment="CENTER_LEFT" minHeight="32" prefHeight="32" maxHeight="32">
        <Label fx:id="lblStaffFormTitle" text="Thêm nhân viên" styleClass="staff-form-title" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCloseStaffForm" minWidth="32" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng thêm nhân viên" styleClass="staff-form-close" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/staff/close-staff.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <HBox spacing="12">
        <VBox spacing="0" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS" styleClass="staff-form-field, staff-form-readonly">
            <Label text="Mã nhân viên · Chỉ đọc" styleClass="staff-form-field-label"/>
            <TextField fx:id="txtStaffId" text="" editable="false" focusTraversable="false" accessibleText="Mã nhân viên chỉ đọc" styleClass="staff-form-input"/>
        </VBox>
        <VBox spacing="0" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS" styleClass="staff-form-field">
            <Label text="Chức vụ *" styleClass="staff-form-field-label"/>
            <ComboBox fx:id="cboStaffPosition" maxWidth="Infinity" styleClass="staff-form-choice" promptText="Chọn thông tin">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Quản lý"/>
                        <String fx:value="NHASI · Nha sĩ"/>
                        <String fx:value="Lễ tân"/>
                        <String fx:value="Y tá"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
    </HBox>
    <VBox spacing="0" styleClass="staff-form-field">
        <Label text="Họ tên *" styleClass="staff-form-field-label"/>
        <TextField fx:id="txtStaffFullName" text="" styleClass="staff-form-input"/>
    </VBox>
    <HBox spacing="12">
        <VBox spacing="0" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS" styleClass="staff-form-field">
            <Label text="Ngày sinh" styleClass="staff-form-field-label"/>
            <DatePicker fx:id="dpStaffBirthDate" promptText="dd/MM/yyyy" maxWidth="Infinity" styleClass="staff-form-date">
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="0" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS" styleClass="staff-form-field">
            <Label text="Giới tính" styleClass="staff-form-field-label"/>
            <ComboBox fx:id="cboStaffGender" maxWidth="Infinity" styleClass="staff-form-choice" promptText="Chọn giới tính">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Nam"/>
                        <String fx:value="Nữ"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
    </HBox>
    <VBox spacing="0" styleClass="staff-form-field">
        <Label text="Điện thoại *" styleClass="staff-form-field-label"/>
        <TextField fx:id="txtStaffPhone" text="" styleClass="staff-form-input"/>
    </VBox>
    <VBox spacing="0" styleClass="staff-form-field">
        <Label text="Email" styleClass="staff-form-field-label"/>
        <TextField fx:id="txtStaffEmail" text="" styleClass="staff-form-input"/>
    </VBox>
    <VBox spacing="0" styleClass="staff-form-field">
        <Label text="Địa chỉ" styleClass="staff-form-field-label"/>
        <TextField fx:id="txtStaffAddress" text="" styleClass="staff-form-input"/>
    </VBox>
    <VBox spacing="0" styleClass="staff-form-field">
        <Label text="Trạng thái *" styleClass="staff-form-field-label"/>
        <ComboBox fx:id="cboStaffStatus" maxWidth="Infinity" styleClass="staff-form-choice" promptText="Chọn trạng thái">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Hoạt động"/>
                    <String fx:value="Ngừng hoạt động"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancelStaffForm" text="Hủy" cancelButton="true" styleClass="secondary-button" disable="true"/>
        <Button fx:id="btnSaveStaff" text="Lưu nhân viên" styleClass="primary-button" disable="true"/>
    </HBox>
</VBox>
