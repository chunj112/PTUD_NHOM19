<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="suaDichVuBieuMau" stylesheets="@/css/chu-de.css, @/css/bieu-mau-dich-vu.css" styleClass="dich-vu-bieu-mau" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" minHeight="-Infinity" prefHeight="802" maxHeight="-Infinity">
    <HBox alignment="CENTER_LEFT" minHeight="32" prefHeight="32" maxHeight="32">
        <Label fx:id="lblDichVuBieuMauTieuDe" text="Sửa dịch vụ" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="dich-vu-bieu-mau-tieu-de"/>
        <!-- Figma dùng ký tự ×, không thay bằng icon tự vẽ. -->
        <Button fx:id="btnDongDichVuBieuMau" text="×" accessibleText="Đóng sửa dịch vụ" minWidth="32" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" styleClass="dich-vu-bieu-mau-dong" disable="true"/>
    </HBox>
    <VBox styleClass="dich-vu-bieu-mau-truong, dich-vu-bieu-mau-chi-doc">
        <Label text="Mã dịch vụ · Chỉ đọc" styleClass="dich-vu-bieu-mau-truong-nhan"/>
        <TextField fx:id="txtDichVuMa" text="" editable="false" focusTraversable="false" accessibleText="Chưa tải dữ liệu" styleClass="dich-vu-bieu-mau-nhap"/>
    </VBox>
    <VBox styleClass="dich-vu-bieu-mau-truong">
        <Label text="Tên dịch vụ *" styleClass="dich-vu-bieu-mau-truong-nhan"/>
        <TextField fx:id="txtDichVuTen" text="" styleClass="dich-vu-bieu-mau-nhap"/>
    </VBox>
    <VBox styleClass="dich-vu-bieu-mau-truong">
        <Label text="Nhóm dịch vụ *" styleClass="dich-vu-bieu-mau-truong-nhan"/>
        <ComboBox fx:id="cboDichVuNhom" maxWidth="Infinity" styleClass="dich-vu-bieu-mau-lua-chon" promptText="Chọn dịch vụ">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Khám"/>
                    <String fx:value="Phục hồi"/>
                    <String fx:value="Dự phòng"/>
                    <String fx:value="Phẫu thuật"/>
                    <String fx:value="Nội nha"/>
                    <String fx:value="Thẩm mỹ"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    <HBox spacing="12">
        <VBox prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS" styleClass="dich-vu-bieu-mau-truong">
            <Label text="Đơn vị *" styleClass="dich-vu-bieu-mau-truong-nhan"/>
            <ComboBox fx:id="cboDichVuDonVi" maxWidth="Infinity" styleClass="dich-vu-bieu-mau-lua-chon" promptText="Chọn dịch vụ">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Răng"/>
                        <String fx:value="Lần"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <VBox prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS" styleClass="dich-vu-bieu-mau-truong">
            <Label text="Thời gian thực hiện *" styleClass="dich-vu-bieu-mau-truong-nhan"/>
            <TextField fx:id="txtDichVuThoiLuong" text="" styleClass="dich-vu-bieu-mau-nhap"/>
        </VBox>
    </HBox>
    <VBox styleClass="dich-vu-bieu-mau-truong">
        <Label text="Đơn giá (₫) *" styleClass="dich-vu-bieu-mau-truong-nhan"/>
        <TextField fx:id="txtDichVuDonGia" text="" styleClass="dich-vu-bieu-mau-nhap"/>
    </VBox>
    <VBox styleClass="dich-vu-bieu-mau-truong">
        <Label text="Yêu cầu vị trí FDI" styleClass="dich-vu-bieu-mau-truong-nhan"/>
        <ComboBox fx:id="cboDichVuFdiDieuKien" maxWidth="Infinity" styleClass="dich-vu-bieu-mau-lua-chon" promptText="Chọn dịch vụ">
            <!-- Figma chỉ thể hiện giá trị này, chưa có frame mở danh sách lựa chọn. -->
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Bắt buộc chọn răng"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    <VBox styleClass="dich-vu-bieu-mau-mo-ta-truong">
        <Label text="Mô tả" styleClass="dich-vu-bieu-mau-truong-nhan"/>
        <TextArea fx:id="txtDichVuMoTa" text="" wrapText="true" prefRowCount="3" VBox.vgrow="ALWAYS" styleClass="dich-vu-bieu-mau-mo-ta"/>
    </VBox>
    <VBox styleClass="dich-vu-bieu-mau-truong">
        <Label text="Trạng thái" styleClass="dich-vu-bieu-mau-truong-nhan"/>
        <ComboBox fx:id="cboDichVuTinhTrang" maxWidth="Infinity" styleClass="dich-vu-bieu-mau-lua-chon" promptText="Chọn dịch vụ">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Hoạt động"/>
                    <String fx:value="Ngừng hoạt động"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="40" prefHeight="40" maxHeight="40">
        <Button fx:id="btnHuyDichVuBieuMau" text="Hủy" cancelButton="true" minWidth="-Infinity" styleClass="phu-nut" disable="true"/>
        <Button fx:id="btnLuuDichVu" text="Lưu thay đổi" minWidth="-Infinity" styleClass="chinh-nut" disable="true"/>
    </HBox>
</VBox>
