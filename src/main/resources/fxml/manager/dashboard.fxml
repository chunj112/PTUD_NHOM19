<?xml version="1.0" encoding="UTF-8"?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="managerDashboard" stylesheets="@/css/manager-dashboard.css" styleClass="manager-dashboard" spacing="20" minWidth="980">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0">
            <Label fx:id="lblDashboardTitle" text="Tổng quan phòng khám" wrapText="true" styleClass="dashboard-title"/>
            <Label fx:id="lblDashboardSubtitle" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." wrapText="true" minHeight="-Infinity" styleClass="dashboard-subtitle"/>
        </VBox>
        <Button fx:id="btnViewReports" id="btnViewReports" text="Xem báo cáo" graphicTextGap="8" styleClass="secondary-button" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/shell/dashboard-reports.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <!-- Bốn chỉ số ngang nhau, khoảng cách 16px như 1:2924. -->
    <GridPane fx:id="metricsGrid" hgap="16">
        <columnConstraints>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
            <ColumnConstraints percentWidth="25"/>
        </columnConstraints>
        <VBox GridPane.columnIndex="0" spacing="8" minWidth="0" styleClass="dashboard-card, dashboard-metric-card">
            <Label text="Bệnh nhân hôm nay" styleClass="dashboard-metric-label"/>
            <Label fx:id="lblPatientsToday" text="—" styleClass="dashboard-metric-value"/>
            <Label fx:id="lblPatientsHint" text="Chưa tải dữ liệu" styleClass="dashboard-caption"/>
        </VBox>
        <VBox GridPane.columnIndex="1" spacing="8" minWidth="0" styleClass="dashboard-card, dashboard-metric-card">
            <Label text="Lịch hẹn hôm nay" styleClass="dashboard-metric-label"/>
            <Label fx:id="lblAppointmentsToday" text="—" styleClass="dashboard-metric-value"/>
            <Label fx:id="lblAppointmentsHint" text="Chưa tải dữ liệu" styleClass="dashboard-caption"/>
        </VBox>
        <VBox GridPane.columnIndex="2" spacing="8" minWidth="0" styleClass="dashboard-card, dashboard-metric-card">
            <Label text="Doanh thu hôm nay" styleClass="dashboard-metric-label"/>
            <Label fx:id="lblRevenueToday" text="—" styleClass="dashboard-metric-value"/>
            <Label fx:id="lblRevenueTrend" text="—" styleClass="dashboard-caption"/>
        </VBox>
        <VBox GridPane.columnIndex="3" spacing="8" minWidth="0" styleClass="dashboard-card, dashboard-metric-card">
            <Label text="Dịch vụ đã thực hiện hôm nay" wrapText="true" minHeight="-Infinity" styleClass="dashboard-metric-label"/>
            <Label fx:id="lblServicesToday" text="—" styleClass="dashboard-metric-value"/>
            <Label fx:id="lblServicesTrend" text="—" styleClass="dashboard-caption"/>
        </VBox>
    </GridPane>
    <!-- Cột trái co giãn, cột phải 320px. Không bọc ScrollPane thứ hai. -->
    <HBox fx:id="dashboardColumns" spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS">
            <VBox spacing="16" styleClass="dashboard-card">
                <Label text="Lịch khám gần nhất" styleClass="dashboard-card-title"/>
                <Label text="Các lịch hẹn trong ca sáng" styleClass="dashboard-caption"/>
                <VBox styleClass="dashboard-table-frame">
                    <!-- Chỉ xem: không gắn click/double-click mở chi tiết.
                         CSS bỏ highlight; Controller sau này gọi
                         tblRecentAppointments.setSelectionModel(null) nếu cần tắt chọn dòng thực sự.
                         Không disable/mouseTransparent để vẫn cuộn bảng bình thường. -->
                    <TableView fx:id="tblRecentAppointments" fixedCellSize="72" minHeight="330" prefHeight="330" maxHeight="330" editable="false" focusTraversable="false" styleClass="dashboard-table, readonly-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colTime" text="Giờ" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="time"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colPatient" text="Bệnh nhân" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="patient"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colDentist" text="Nha sĩ" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="dentist"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colReason" text="Lý do khám" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="reason"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colStatus" text="Trạng thái" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="status"/>
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_LEFT" spacing="6" minHeight="38" prefHeight="38" styleClass="dashboard-table-footer">
                        <Label fx:id="lblAppointmentsCount" text="Chưa tải dữ liệu" styleClass="dashboard-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
                        <Button fx:id="btnPreviousAppointments" text="‹" disable="true" accessibleText="Trang lịch khám trước" styleClass="dashboard-page-button"/>
                        <Label fx:id="lblAppointmentsPage" text="—" styleClass="dashboard-caption"/>
                        <Button fx:id="btnNextAppointments" text="›" disable="true" accessibleText="Trang lịch khám tiếp theo" styleClass="dashboard-page-button"/>
                    </HBox>
                </VBox>
            </VBox>
            <VBox spacing="16" styleClass="dashboard-card">
                <Label text="Hoạt động hôm nay" styleClass="dashboard-card-title"/>
                <TableView fx:id="tblTodayActivity" fixedCellSize="72" minHeight="330" prefHeight="330" maxHeight="330" styleClass="dashboard-table, dashboard-activity-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colActivityTime" text="Thời gian" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="time"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colActivity" text="Hoạt động" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="activity"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colActor" text="Người thực hiện" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="actor"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
        <!-- Chỉ giữ một card bên phải, tự co chiều cao theo nội dung. -->
        <VBox spacing="16" minWidth="320" prefWidth="320" maxWidth="320" maxHeight="-Infinity" styleClass="dashboard-card">
            <Label text="Tình hình trong ngày" styleClass="dashboard-card-title"/>
            <VBox spacing="6">
                <Label text="Đã tiếp nhận" styleClass="dashboard-caption"/>
                <Label fx:id="lblReceived" text="—" styleClass="dashboard-summary"/>
            </VBox>
            <Separator/>
            <VBox spacing="6">
                <Label text="Phiếu khám hoàn tất" styleClass="dashboard-caption"/>
                <Label fx:id="lblCompleted" text="—" styleClass="dashboard-summary"/>
            </VBox>
            <Separator/>
            <VBox spacing="6">
                <Label text="Hóa đơn chờ thu" styleClass="dashboard-caption"/>
                <Label fx:id="lblUnpaid" text="—" styleClass="dashboard-summary"/>
            </VBox>
            <Label fx:id="lblPendingAppointments" text="—" wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="dashboard-inline-note"/>
        </VBox>
    </HBox>
    <Label fx:id="lblDemoDataNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." wrapText="true" minHeight="-Infinity" styleClass="dashboard-caption"/>
</VBox>
