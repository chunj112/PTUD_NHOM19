<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="editAssignmentForm" stylesheets="@/css/theme.css, @/css/assignment-forms.css" styleClass="assignment-form" spacing="16" minWidth="480" prefWidth="480" maxWidth="480" maxHeight="-Infinity">
    <Label fx:id="lblAssignmentFormTitle" text="Sửa phân công" styleClass="assignment-form-title"/>
    <VBox styleClass="assignment-form-field">
        <Label text="Nhân viên *" styleClass="assignment-field-caption"/>
        <ComboBox fx:id="cboAssignmentEmployee" maxWidth="Infinity" styleClass="assignment-form-choice" accessibleText="Nhân viên được phân công" promptText="Chọn nhân viên">
            <items>
                <FXCollections fx:factory="observableArrayList"/>
            </items>
        </ComboBox>
    </VBox>
    <VBox styleClass="assignment-form-field">
        <Label text="Ngày *" styleClass="assignment-field-caption"/>
        <DatePicker fx:id="dpAssignmentDate" maxWidth="Infinity" promptText="dd/MM/yyyy" styleClass="assignment-form-date" accessibleText="Ngày phân công">
            <editor text=""/>
        </DatePicker>
    </VBox>
    <HBox spacing="12">
        <VBox prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS" styleClass="assignment-form-field">
            <Label text="Giờ bắt đầu *" styleClass="assignment-field-caption"/>
            <ComboBox fx:id="cboAssignmentStartTime" maxWidth="Infinity" styleClass="assignment-form-choice" accessibleText="Giờ bắt đầu ca" promptText="Chọn thông tin">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="08:00"/>
                        <String fx:value="13:30"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <VBox prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS" styleClass="assignment-form-field">
            <Label text="Giờ kết thúc *" styleClass="assignment-field-caption"/>
            <ComboBox fx:id="cboAssignmentEndTime" maxWidth="Infinity" styleClass="assignment-form-choice" accessibleText="Giờ kết thúc ca" promptText="Chọn thông tin">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="12:00"/>
                        <String fx:value="17:00"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
    </HBox>
    <VBox styleClass="assignment-form-field">
        <Label text="Phòng / Khu vực *" styleClass="assignment-field-caption"/>
        <ComboBox fx:id="cboAssignmentRoom" maxWidth="Infinity" styleClass="assignment-form-choice" accessibleText="Phòng hoặc khu vực được phân công" promptText="Chọn phòng">
            <items>
                <FXCollections fx:factory="observableArrayList"/>
            </items>
        </ComboBox>
    </VBox>
    <VBox styleClass="assignment-form-field">
        <Label text="Công việc" styleClass="assignment-field-caption"/>
        <TextField fx:id="txtAssignmentWork" text="" styleClass="assignment-form-input"/>
    </VBox>
    <HBox spacing="12">
        <Button fx:id="btnCancelAssignmentForm" text="Hủy" cancelButton="true" styleClass="secondary-button" disable="true"/>
        <Button fx:id="btnSaveAssignment" text="Lưu thay đổi" styleClass="primary-button" disable="true"/>
    </HBox>
</VBox>
