<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="visitsReport" spacing="20" minWidth="0" prefHeight="1177">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="reports-filter-card">
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Từ ngày" styleClass="reports-field-label"/>
            <DatePicker fx:id="dpVisitsFrom" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="reports-date">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Đến ngày" styleClass="reports-field-label"/>
            <DatePicker fx:id="dpVisitsTo" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="reports-date">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Nha sĩ" styleClass="reports-field-label"/>
            <ComboBox fx:id="cboVisitsDentist" maxWidth="Infinity" minWidth="0" styleClass="reports-filter" accessibleText="Lọc nha sĩ, dữ liệu mẫu" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Trạng thái" styleClass="reports-field-label"/>
            <ComboBox fx:id="cboVisitsStatus" maxWidth="Infinity" minWidth="0" styleClass="reports-filter" accessibleText="Lọc trạng thái, dữ liệu mẫu" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                        <String fx:value="Đã hoàn tất"/>
                        <String fx:value="Đã hủy"/>
                        <String fx:value="Không đến"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <Button fx:id="btnApplyVisitsReport" text="Áp dụng" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
    </HBox>
    <GridPane fx:id="VisitsMetrics" hgap="16" minHeight="132" prefHeight="132" maxHeight="132">
        <rowConstraints>
            <RowConstraints percentHeight="100" fillHeight="true"/>
        </rowConstraints>
        <columnConstraints>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="0">
            <Label text="Tổng lượt khám" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblVisitsTotal" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblVisitsTotalNote" text="Chưa tải dữ liệu" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="1">
            <Label text="Lượt khám hôm nay" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblVisitsToday" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblVisitsTodayNote" text="Chưa tải dữ liệu" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="2">
            <Label text="Trung bình lượt/ngày" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblVisitsAverage" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblVisitsAverageNote" text="Chưa tải dữ liệu" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="3">
            <Label text="Tỷ lệ hoàn tất" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblVisitsCompletionRate" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblVisitsCompletionRateNote" text="Chưa tải dữ liệu" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
    </GridPane>
    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label fx:id="lblVisitsChartTitle" text="Lượt khám theo ngày" styleClass="reports-card-title"/>
        <Label fx:id="lblVisitsChartSubtitle" text="Tổng lượt khám theo ngày, gồm các trạng thái" styleClass="reports-caption" wrapText="true"/>
        <!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
        <HBox fx:id="chartVisits" spacing="20" alignment="BOTTOM_CENTER" minHeight="222" prefHeight="222" maxHeight="222" styleClass="reports-chart" accessibleText="Lượt khám theo ngày, dữ liệu minh họa">
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue1" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits1" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue2" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits2" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue3" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits3" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue4" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits4" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue5" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits5" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue6" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits6" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue7" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits7" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue8" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits8" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblVisitsBarValue9" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barVisits9" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar, reports-bar-accent"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
        </HBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="reports-divider"/>
        <Label fx:id="lblVisitsChartNote" text="Chưa tải dữ liệu" styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label text="Dữ liệu chi tiết" styleClass="reports-card-title"/>
        <VBox styleClass="reports-table-frame">
            <!-- Chỉ đọc; không mở chi tiết, không hover/selected highlight.
                 editable=false không tắt selection: Nhi tự setSelectionModel(null) khi nối Controller. -->
            <TableView fx:id="tblVisits" editable="false" focusTraversable="false" fixedCellSize="72" minHeight="326" prefHeight="326" maxHeight="326" styleClass="reports-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colVisitsDate" text="Ngày" prefWidth="185" minWidth="130" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="date"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colVisitsTotal" text="Tổng lượt khám" prefWidth="185" minWidth="135" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="total"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colVisitsCompleted" text="Đã hoàn tất" prefWidth="185" minWidth="120" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="completed"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colVisitsCancelled" text="Đã hủy" prefWidth="185" minWidth="100" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="cancelled"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colVisitsNoShow" text="Không đến" prefWidth="185" minWidth="110" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="noShow"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colVisitsCompletionRate" text="Tỷ lệ hoàn tất" prefWidth="185" minWidth="130" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="rate"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="6" alignment="CENTER_LEFT" minHeight="40" prefHeight="40" styleClass="reports-table-footer">
                <Label fx:id="lblVisitsRecordCount" text="Chưa tải dữ liệu" styleClass="reports-caption"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVisitsPreviousPage" text="‹" disable="true" accessibleText="Trang báo cáo trước" styleClass="reports-page-button"/>
                <Label fx:id="lblVisitsCurrentPage" text="—" styleClass="reports-caption"/>
                <Button fx:id="btnVisitsNextPage" text="›" disable="true" accessibleText="Trang báo cáo tiếp theo, chưa có xử lý" styleClass="reports-page-button"/>
            </HBox>
        </VBox>
    </VBox>
    <VBox spacing="2">
        <Label fx:id="lblVisitsDemoNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblVisitsByDentist" text="—" styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
</VBox>
