<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="serviceSelectedDetails" stylesheets="@/css/manager-services.css" styleClass="services-page, service-details" spacing="16" minWidth="356" prefWidth="356" maxWidth="356" minHeight="-Infinity" maxHeight="-Infinity">
    <Label fx:id="lblSelectedServiceName" text="—" wrapText="true" minHeight="-Infinity" styleClass="services-card-title"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="lblSelectedServiceId" text="—" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="service-detail-summary"/>
        <Label fx:id="lblSelectedServiceStatus" text="—" styleClass="service-detail-badge"/>
    </HBox>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="service-detail-divider"/>
    <VBox spacing="4" minHeight="44">
        <Label text="Nhóm dịch vụ" styleClass="services-caption"/>
        <Label fx:id="lblServiceDetailGroup" text="—" wrapText="true" styleClass="service-detail-value"/>
    </VBox>
    <VBox spacing="4" minHeight="44">
        <Label text="Đơn vị tính" styleClass="services-caption"/>
        <Label fx:id="lblServiceDetailUnit" text="—" wrapText="true" styleClass="service-detail-value"/>
    </VBox>
    <VBox spacing="4" minHeight="44">
        <Label text="Giá niêm yết" styleClass="services-caption"/>
        <Label fx:id="lblServiceDetailPrice" text="—" wrapText="true" styleClass="service-detail-value"/>
    </VBox>
    <VBox spacing="4" minHeight="44">
        <Label text="Thời gian dự kiến" styleClass="services-caption"/>
        <Label fx:id="lblServiceDetailDuration" text="—" wrapText="true" styleClass="service-detail-value"/>
    </VBox>
    <VBox spacing="4" minHeight="44">
        <Label text="Vị trí điều trị" styleClass="services-caption"/>
        <Label fx:id="lblServiceDetailFdiRequirement" text="—" wrapText="true" styleClass="service-detail-value"/>
    </VBox>
    <VBox spacing="4" minHeight="67">
        <Label text="Mô tả" styleClass="services-caption"/>
        <Label fx:id="lblServiceDetailDescription" text="—" wrapText="true" minHeight="-Infinity" styleClass="service-detail-value"/>
    </VBox>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="service-detail-divider"/>
    <Label fx:id="lblServicePricePolicy" text="—" wrapText="true" minHeight="-Infinity" styleClass="services-caption"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnEditService" text="Sửa dịch vụ" graphicTextGap="8" minWidth="-Infinity" styleClass="secondary-button" disable="true">
            <graphic>
                <ImageView fx:id="imgEditService" fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/staff/edit-staff.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnToggleServiceStatus" text="Ngừng áp dụng" minWidth="-Infinity" styleClass="secondary-button" disable="true"/>
    </HBox>
</VBox>
