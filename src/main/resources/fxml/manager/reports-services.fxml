<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.layout.*?>
<!-- UC007 · Tab ServiceUsage · Figma 15:2435, file ROPzygiAnJyl1VudYGf0sm.
     Fragment của reports.fxml, không có Sidebar/Topbar hoặc Controller riêng.
     Toàn bộ ngày, KPI, cột và dòng bảng là DỮ LIỆU MINH HỌA từ Figma.
     HashMap/MapValueFactory là JavaFX/Java chuẩn để preview, không phải Entity.
     Nhi tự thay bằng dữ liệu thống kê thật, không trộn mẫu với SQL.
     Giá là chuỗi hiển thị; Backend dùng BigDecimal và thanh toán đã xác nhận. -->
<?import javafx.scene.chart.PieChart?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="serviceUsageReport" spacing="20" minWidth="0" prefHeight="1320">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="reports-filter-card">
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Từ ngày" styleClass="reports-field-label"/>
            <DatePicker fx:id="dpServiceUsageFrom" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Từ ngày, ngày mẫu 01/10/2026" styleClass="reports-date">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text="01/10/2026"/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Đến ngày" styleClass="reports-field-label"/>
            <DatePicker fx:id="dpServiceUsageTo" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Đến ngày, ngày mẫu 09/10/2026" styleClass="reports-date">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text="09/10/2026"/>
            </DatePicker>
        </VBox>
        <Button fx:id="btnApplyServiceUsageReport" text="Áp dụng" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
    <GridPane fx:id="ServiceUsageMetrics" hgap="16" minHeight="132" prefHeight="132" maxHeight="132">
        <rowConstraints>
            <RowConstraints percentHeight="100" fillHeight="true"/>
        </rowConstraints>
        <columnConstraints>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="0">
            <Label text="Tổng dịch vụ thực hiện" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblServiceUsageTotal" text="236" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblServiceUsageTotalNote" text="Chỉ dịch vụ DA_THUC_HIEN" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="1">
            <Label text="Dịch vụ phổ biến nhất" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblServiceUsagePopular" text="Cạo vôi răng" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblServiceUsagePopularNote" text="82 lượt · 34,7%" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="2">
            <Label text="Tổng doanh thu dịch vụ" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblServiceUsageRevenue" text="101.600.000 ₫" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblServiceUsageRevenueNote" text="Chỉ khoản thanh toán đã xác nhận" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="3">
            <Label text="Trung bình dịch vụ/lượt khám" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblServiceUsageAverage" text="1,75" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblServiceUsageAverageNote" text="236 dịch vụ / 135 phiếu hoàn tất" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
    </GridPane>
    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label fx:id="lblServiceUsageChartTitle" text="Tỷ trọng lượt dịch vụ đã thực hiện" styleClass="reports-card-title"/>
        <Label fx:id="lblServiceUsageChartSubtitle" text="Tính theo số lượt, không phải doanh thu · Dịch vụ ít phổ biến được gộp vào Khác" styleClass="reports-caption" wrapText="true"/>
        <!-- PieChart JavaFX 2D: dữ liệu mẫu theo lượt đã thực hiện, không phải doanh thu. -->
        <PieChart fx:id="chartServiceUsage" animated="false" labelsVisible="false" legendVisible="true" legendSide="BOTTOM" prefHeight="380" minHeight="380" maxHeight="380" styleClass="reports-pie">
            <!-- PieChart.Data cần constructor Java; ReportsController nạp dữ liệu DEMO khi mở trang. -->
        </PieChart>
        <Label fx:id="lblServiceUsageEmpty" text="Không có lượt dịch vụ đã thực hiện trong kỳ." styleClass="reports-caption" wrapText="true" minHeight="-Infinity" visible="false" managed="false"/>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="reports-divider"/>
        <Label fx:id="lblServiceUsageChartNote" text="82 + 68 + 86 = 236 lượt đã thực hiện · Bảng bên dưới giữ từng dịch vụ." styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label text="Dữ liệu chi tiết" styleClass="reports-card-title"/>
        <VBox styleClass="reports-table-frame">
            <!-- Chỉ đọc; không mở chi tiết, không hover/selected highlight.
                 editable=false không tắt selection: Nhi tự setSelectionModel(null) khi nối Controller. -->
            <TableView fx:id="tblServiceUsage" editable="false" focusTraversable="false" fixedCellSize="72" minHeight="254" prefHeight="254" maxHeight="254" styleClass="reports-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa có dữ liệu" styleClass="reports-caption"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colServiceUsageName" text="Tên dịch vụ" prefWidth="330" minWidth="215" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="name"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colServiceUsageCount" text="Số lượt thực hiện" prefWidth="178" minWidth="150" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="count"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colServiceUsagePrice" text="Đơn giá" prefWidth="168" minWidth="140" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="price"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colServiceUsageRevenue" text="Doanh thu" prefWidth="244" minWidth="160" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="revenue"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colServiceUsageUsageRate" text="Tỷ lệ sử dụng" prefWidth="188" minWidth="135" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="rate"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <HashMap name="Cạo vôi răng" count="82" price="300.000 ₫" revenue="24.600.000 ₫" rate="34.7%"/>
                        <HashMap name="Trám răng composite" count="68" price="500.000 ₫" revenue="34.000.000 ₫" rate="28.8%"/>
                        <HashMap name="Nhổ răng thường" count="40" price="400.000 ₫" revenue="16.000.000 ₫" rate="16.9%"/>
                        <HashMap name="Khám tổng quát" count="30" price="100.000 ₫" revenue="3.000.000 ₫" rate="12.7%"/>
                        <HashMap name="Điều trị tủy" count="16" price="1.500.000 ₫" revenue="24.000.000 ₫" rate="6.8%"/>
                    </FXCollections>
                </items>
            </TableView>
            <HBox spacing="6" alignment="CENTER_LEFT" minHeight="40" prefHeight="40" styleClass="reports-table-footer">
                <Label fx:id="lblServiceUsageRecordCount" text="Hiển thị 5 / 5 dịch vụ · Cuộn để xem đầy đủ" styleClass="reports-caption"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnServiceUsagePreviousPage" text="‹" disable="true" accessibleText="Trang báo cáo trước" styleClass="reports-page-button"/>
                <Label fx:id="lblServiceUsageCurrentPage" text="1" styleClass="reports-caption"/>
                <Button fx:id="btnServiceUsageNextPage" text="›" disable="true" accessibleText="Trang báo cáo tiếp theo" styleClass="reports-page-button"/>
            </HBox>
        </VBox>
    </VBox>
    <VBox spacing="2">
        <Label fx:id="lblServiceUsageDemoNotice" text="DỮ LIỆU MINH HỌA · Phòng khám nha khoa · 09/10/2026 · Không kết nối SQL Server" styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
</VBox>
