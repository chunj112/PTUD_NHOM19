<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="serviceUsageReport" spacing="20" minWidth="0" prefHeight="1088">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="reports-filter-card">
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Từ ngày" styleClass="reports-field-label"/>
            <DatePicker fx:id="dpServiceUsageFrom" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="reports-date">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Đến ngày" styleClass="reports-field-label"/>
            <DatePicker fx:id="dpServiceUsageTo" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="reports-date">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Dịch vụ" styleClass="reports-field-label"/>
            <ComboBox fx:id="cboServiceUsageService" maxWidth="Infinity" minWidth="0" styleClass="reports-filter" accessibleText="Lọc dịch vụ, dữ liệu mẫu" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Nha sĩ" styleClass="reports-field-label"/>
            <ComboBox fx:id="cboServiceUsageDentist" maxWidth="Infinity" minWidth="0" styleClass="reports-filter" accessibleText="Lọc nha sĩ, dữ liệu mẫu" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <Button fx:id="btnApplyServiceUsageReport" text="Áp dụng" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
    </HBox>
    <GridPane fx:id="ServiceUsageMetrics" hgap="16" minHeight="132" prefHeight="132" maxHeight="132">
        <rowConstraints>
            <RowConstraints percentHeight="100" fillHeight="true"/>
        </rowConstraints>
        <columnConstraints>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="0">
            <Label text="Tổng dịch vụ thực hiện" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblServiceUsageTotal" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblServiceUsageTotalNote" text="Chỉ định trong kỳ báo cáo" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="1">
            <Label text="Dịch vụ phổ biến nhất" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblServiceUsagePopular" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblServiceUsagePopularNote" text="Chưa tải dữ liệu" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="2">
            <Label text="Tổng doanh thu dịch vụ" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblServiceUsageRevenue" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblServiceUsageRevenueNote" text="Trong kỳ báo cáo" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="3">
            <Label text="Trung bình dịch vụ/lượt khám" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblServiceUsageAverage" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblServiceUsageAverageNote" text="Chưa tải dữ liệu" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
    </GridPane>
    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label fx:id="lblServiceUsageChartTitle" text="Top dịch vụ được sử dụng" styleClass="reports-card-title"/>
        <Label fx:id="lblServiceUsageChartSubtitle" text="Khác là nhóm dịch vụ gộp, không phải một dịch vụ riêng" styleClass="reports-caption" wrapText="true"/>
        <!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
        <HBox fx:id="chartServiceUsage" spacing="20" alignment="BOTTOM_CENTER" minHeight="222" prefHeight="222" maxHeight="222" styleClass="reports-chart" accessibleText="Top dịch vụ được sử dụng, dữ liệu minh họa">
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblServiceUsageBarValue1" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barServiceUsage1" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar, reports-bar-accent"/>
                <Label text="Cạo vôi răng" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblServiceUsageBarValue2" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barServiceUsage2" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="Trám răng composite" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblServiceUsageBarValue3" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barServiceUsage3" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="Khác (gộp)" styleClass="reports-axis-label"/>
            </VBox>
        </HBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="reports-divider"/>
        <Label fx:id="lblServiceUsageChartNote" text="Chưa tải dữ liệu" styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label text="Dữ liệu chi tiết" styleClass="reports-card-title"/>
        <VBox styleClass="reports-table-frame">
            <!-- Chỉ đọc; không mở chi tiết, không hover/selected highlight.
                 editable=false không tắt selection: Nhi tự setSelectionModel(null) khi nối Controller. -->
            <TableView fx:id="tblServiceUsage" editable="false" focusTraversable="false" fixedCellSize="72" minHeight="254" prefHeight="254" maxHeight="254" styleClass="reports-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colServiceUsageName" text="Tên dịch vụ" prefWidth="330" minWidth="215" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="name"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colServiceUsageCount" text="Số lượt thực hiện" prefWidth="178" minWidth="150" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="count"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colServiceUsagePrice" text="Đơn giá" prefWidth="168" minWidth="140" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="price"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colServiceUsageRevenue" text="Doanh thu" prefWidth="244" minWidth="160" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="revenue"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colServiceUsageUsageRate" text="Tỷ lệ sử dụng" prefWidth="188" minWidth="135" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="rate"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="6" alignment="CENTER_LEFT" minHeight="40" prefHeight="40" styleClass="reports-table-footer">
                <Label fx:id="lblServiceUsageRecordCount" text="Chưa tải dữ liệu" styleClass="reports-caption"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnServiceUsagePreviousPage" text="‹" disable="true" accessibleText="Trang báo cáo trước" styleClass="reports-page-button"/>
                <Label fx:id="lblServiceUsageCurrentPage" text="—" styleClass="reports-caption"/>
                <Button fx:id="btnServiceUsageNextPage" text="›" disable="true" accessibleText="Trang báo cáo tiếp theo, chưa có xử lý" styleClass="reports-page-button"/>
            </HBox>
        </VBox>
    </VBox>
    <VBox spacing="2">
        <Label fx:id="lblServiceUsageDemoNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
</VBox>
