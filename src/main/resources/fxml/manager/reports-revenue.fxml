<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="revenueReport" spacing="20" minWidth="0" prefHeight="1160">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="reports-filter-card">
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Từ ngày" styleClass="reports-field-label"/>
            <DatePicker fx:id="dpRevenueFrom" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="reports-date">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
            <Label text="Đến ngày" styleClass="reports-field-label"/>
            <DatePicker fx:id="dpRevenueTo" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="reports-date">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <Button fx:id="btnApplyRevenueReport" text="Xem báo cáo" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
    </HBox>
    <GridPane fx:id="RevenueMetrics" hgap="16" minHeight="132" prefHeight="132" maxHeight="132">
        <rowConstraints>
            <RowConstraints percentHeight="100" fillHeight="true"/>
        </rowConstraints>
        <columnConstraints>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="0">
            <Label text="Doanh thu thực thu" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblRevenueCollected" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblRevenueCollectedNote" text="Hóa đơn dịch vụ đã thanh toán" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="1">
            <Label text="Hóa đơn" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblRevenueInvoiceCount" text="Chưa tải dữ liệu" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblRevenueInvoiceCountNote" text="Trong kỳ báo cáo" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="2">
            <Label text="Trung bình / hóa đơn" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblRevenueAverage" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblRevenueAverageNote" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="3">
            <Label text="Chờ thu tiền" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblRevenuePending" text="—" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblRevenuePendingNote" text="Chưa tải dữ liệu" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
    </GridPane>
    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label fx:id="lblRevenueChartTitle" text="Doanh thu theo ngày" styleClass="reports-card-title"/>
        <Label fx:id="lblRevenueChartSubtitle" text="Chỉ tính các hóa đơn đã thanh toán" styleClass="reports-caption" wrapText="true"/>
        <!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
        <HBox fx:id="chartRevenue" spacing="20" alignment="BOTTOM_CENTER" minHeight="222" prefHeight="222" maxHeight="222" styleClass="reports-chart" accessibleText="Doanh thu theo ngày, dữ liệu minh họa">
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue1" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue1" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue2" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue2" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue3" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue3" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue4" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue4" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue5" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue5" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue6" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue6" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue7" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue7" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue8" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue8" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue9" text="—" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue9" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="reports-bar, reports-bar-accent"/>
                <Label text="—" styleClass="reports-axis-label"/>
            </VBox>
        </HBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="reports-divider"/>
        <Label fx:id="lblRevenueChartNote" text="Chưa tải dữ liệu" styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label text="Dữ liệu chi tiết" styleClass="reports-card-title"/>
        <VBox styleClass="reports-table-frame">
            <!-- Chỉ đọc; không mở chi tiết, không hover/selected highlight.
                 editable=false không tắt selection: Nhi tự setSelectionModel(null) khi nối Controller. -->
            <TableView fx:id="tblRevenue" editable="false" focusTraversable="false" fixedCellSize="72" minHeight="326" prefHeight="326" maxHeight="326" styleClass="reports-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colRevenueDate" text="Ngày" prefWidth="278" minWidth="140" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="date"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRevenueCompletedVisits" text="Lượt khám hoàn tất" prefWidth="278" minWidth="180" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="completed"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRevenuePaidInvoices" text="Hóa đơn đã thu" prefWidth="278" minWidth="150" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="paid"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRevenueAmount" text="Doanh thu" prefWidth="278" minWidth="160" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="amount"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="6" alignment="CENTER_LEFT" minHeight="40" prefHeight="40" styleClass="reports-table-footer">
                <Label fx:id="lblRevenueRecordCount" text="Chưa tải dữ liệu" styleClass="reports-caption"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRevenuePreviousPage" text="‹" disable="true" accessibleText="Trang báo cáo trước" styleClass="reports-page-button"/>
                <Label fx:id="lblRevenueCurrentPage" text="—" styleClass="reports-caption"/>
                <Button fx:id="btnRevenueNextPage" text="›" disable="true" accessibleText="Trang báo cáo tiếp theo, chưa có xử lý" styleClass="reports-page-button"/>
            </HBox>
        </VBox>
    </VBox>
    <VBox spacing="2">
        <Label fx:id="lblRevenueDemoNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
</VBox>
