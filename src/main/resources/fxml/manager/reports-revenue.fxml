<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.layout.*?>

<!-- UC007 · Tab Revenue · Figma 15:683, file ROPzygiAnJyl1VudYGf0sm.
     Fragment của reports.fxml, không có Sidebar/Topbar hoặc Controller riêng.
     Toàn bộ ngày, KPI, cột và dòng bảng là DỮ LIỆU MINH HỌA từ Figma.
     HashMap/MapValueFactory là JavaFX/Java chuẩn để preview, không phải Entity.
     Nhi tự thay bằng dữ liệu thống kê thật, không trộn mẫu với SQL.
     Giá là chuỗi hiển thị; Backend dùng BigDecimal và thanh toán đã xác nhận. -->
<VBox fx:id="revenueReport" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="20" minWidth="0" prefHeight="1160">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="reports-filter-card">
            <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
                <Label text="Từ ngày" styleClass="reports-field-label"/>
                <DatePicker fx:id="dpRevenueFrom" editable="false" maxWidth="Infinity" minWidth="0"
                            accessibleText="Từ ngày, ngày mẫu 01/10/2026" styleClass="reports-date">
                    <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                    <editor text="01/10/2026"/>
                </DatePicker>
            </VBox>
            <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="reports-field">
                <Label text="Đến ngày" styleClass="reports-field-label"/>
                <DatePicker fx:id="dpRevenueTo" editable="false" maxWidth="Infinity" minWidth="0"
                            accessibleText="Đến ngày, ngày mẫu 09/10/2026" styleClass="reports-date">
                    <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                    <editor text="09/10/2026"/>
                </DatePicker>
            </VBox>
        <Button fx:id="btnApplyRevenueReport" text="Xem báo cáo" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>

    <GridPane fx:id="RevenueMetrics" hgap="16" minHeight="132" prefHeight="132" maxHeight="132">
        <rowConstraints><RowConstraints percentHeight="100" fillHeight="true"/></rowConstraints>
        <columnConstraints>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="0">
            <Label text="Doanh thu thực thu" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblRevenueCollected" text="142.680.000 ₫" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblRevenueCollectedNote" text="Hóa đơn dịch vụ đã thanh toán" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="1">
            <Label text="Hóa đơn" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblRevenueInvoiceCount" text="186" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblRevenueInvoiceCountNote" text="Trong kỳ báo cáo" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="2">
            <Label text="Trung bình / hóa đơn" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblRevenueAverage" text="767.097 ₫" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblRevenueAverageNote" text="Giá trị minh họa" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="reports-card" GridPane.columnIndex="3">
            <Label text="Chờ thu tiền" styleClass="reports-metric-label" wrapText="true"/>
            <Label fx:id="lblRevenuePending" text="2.460.000 ₫" styleClass="reports-metric-value" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblRevenuePendingNote" text="3 hóa đơn chưa thanh toán" styleClass="reports-caption" minHeight="-Infinity" wrapText="true"/>
        </VBox>
    </GridPane>

    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label fx:id="lblRevenueChartTitle" text="Doanh thu theo ngày" styleClass="reports-card-title"/>
        <Label fx:id="lblRevenueChartSubtitle" text="Chỉ tính các hóa đơn đã thanh toán" styleClass="reports-caption" wrapText="true"/>
        <!-- Cột JavaFX thật, không ảnh biểu đồ. Chiều cao mẫu giữ theo Figma.
             Khi đổi kỳ, Nhi tự dựng lại các VBox/cột và nhãn từ số liệu thống kê. -->
        <HBox fx:id="chartRevenue" spacing="20" alignment="BOTTOM_CENTER" minHeight="222" prefHeight="222" maxHeight="222"
              styleClass="reports-chart" accessibleText="Doanh thu theo ngày, dữ liệu minh họa">
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue1" text="14.2 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue1" minHeight="99.4" prefHeight="99.4" maxHeight="99.4"
                        maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="01/10" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue2" text="17.6 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue2" minHeight="123.2" prefHeight="123.2" maxHeight="123.2"
                        maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="02/10" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue3" text="21.4 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue3" minHeight="149.8" prefHeight="149.8" maxHeight="149.8"
                        maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="03/10" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue4" text="8.8 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue4" minHeight="61.6" prefHeight="61.6" maxHeight="61.6"
                        maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="04/10" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue5" text="15.2 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue5" minHeight="106.4" prefHeight="106.4" maxHeight="106.4"
                        maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="05/10" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue6" text="19 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue6" minHeight="133" prefHeight="133" maxHeight="133"
                        maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="06/10" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue7" text="16 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue7" minHeight="112" prefHeight="112" maxHeight="112"
                        maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="07/10" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue8" text="18 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue8" minHeight="126" prefHeight="126" maxHeight="126"
                        maxWidth="Infinity" styleClass="reports-bar"/>
                <Label text="08/10" styleClass="reports-axis-label"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblRevenueBarValue9" text="12,48 tr" styleClass="reports-bar-value"/>
                <Region fx:id="barRevenue9" minHeight="128.94" prefHeight="128.94" maxHeight="128.94"
                        maxWidth="Infinity" styleClass="reports-bar, reports-bar-accent"/>
                <Label text="09/10" styleClass="reports-axis-label"/>
            </VBox>
        </HBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="reports-divider"/>
        <Label fx:id="lblRevenueChartNote" text="Trục giá trị: triệu đồng · Tổng kỳ 142,68 triệu đồng · Chỉ dịch vụ" styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>

    <VBox spacing="16" minWidth="0" styleClass="reports-card">
        <Label text="Dữ liệu chi tiết" styleClass="reports-card-title"/>
        <VBox styleClass="reports-table-frame">
            <!-- Chỉ đọc; không mở chi tiết, không hover/selected highlight.
                 editable=false không tắt selection: Nhi tự setSelectionModel(null) khi nối Controller. -->
            <TableView fx:id="tblRevenue" editable="false" focusTraversable="false" fixedCellSize="72"
                       minHeight="326" prefHeight="326" maxHeight="326" styleClass="reports-table">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
                <placeholder><Label text="Chưa có dữ liệu" styleClass="reports-caption"/></placeholder>
                <columns>
                    <TableColumn fx:id="colRevenueDate" text="Ngày" prefWidth="278" minWidth="140" sortable="false" reorderable="false">
                        <cellValueFactory><MapValueFactory key="date"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRevenueCompletedVisits" text="Lượt khám hoàn tất" prefWidth="278" minWidth="180" sortable="false" reorderable="false">
                        <cellValueFactory><MapValueFactory key="completed"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRevenuePaidInvoices" text="Hóa đơn đã thu" prefWidth="278" minWidth="150" sortable="false" reorderable="false">
                        <cellValueFactory><MapValueFactory key="paid"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRevenueAmount" text="Doanh thu" prefWidth="278" minWidth="160" sortable="false" reorderable="false">
                        <cellValueFactory><MapValueFactory key="amount"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <items><FXCollections fx:factory="observableArrayList">
                    <HashMap date="09/10/2026" completed="10" paid="23" amount="12.480.000 ₫"/>
                    <HashMap date="08/10/2026" completed="24" paid="22" amount="18.000.000 ₫"/>
                    <HashMap date="07/10/2026" completed="21" paid="20" amount="16.000.000 ₫"/>
                    <HashMap date="06/10/2026" completed="26" paid="24" amount="19.000.000 ₫"/>
                </FXCollections></items>
            </TableView>
            <HBox spacing="6" alignment="CENTER_LEFT" minHeight="40" prefHeight="40" styleClass="reports-table-footer">
                <Label fx:id="lblRevenueRecordCount" text="Hiển thị 4 / 4 bản ghi" styleClass="reports-caption"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRevenuePreviousPage" text="‹" disable="true" accessibleText="Trang báo cáo trước" styleClass="reports-page-button"/>
                <Label fx:id="lblRevenueCurrentPage" text="1" styleClass="reports-caption"/>
                <Button fx:id="btnRevenueNextPage" text="›" disable="true" accessibleText="Trang báo cáo tiếp theo, chưa có xử lý" styleClass="reports-page-button"/>
            </HBox>
        </VBox>
    </VBox>

    <VBox spacing="2">
        <Label fx:id="lblRevenueDemoNotice" text="DỮ LIỆU MINH HỌA · Phòng khám nha khoa · 09/10/2026 · Không kết nối SQL Server"
               styleClass="reports-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
</VBox>
