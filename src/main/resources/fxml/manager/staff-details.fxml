<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- UC004: panel gọn theo ảnh review; mã NV/chức vụ và trạng thái chỉ ở phần đầu. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="staffSelectedDetails" stylesheets="@/css/manager-staff.css"
      styleClass="staff-page, staff-details" spacing="12" minWidth="0">
    <Label fx:id="lblSelectedStaffName" text="Trần Minh Đức" wrapText="true" styleClass="staff-card-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="lblSelectedStaffSummary" text="NV002 · Nha sĩ" HBox.hgrow="ALWAYS" maxWidth="Infinity"
               minWidth="0" wrapText="true" styleClass="staff-detail-summary"/>
        <Label fx:id="lblDetailStatus" text="Hoạt động" minWidth="-Infinity" styleClass="staff-detail-badge"/>
    </HBox>
    <Separator/>
    <VBox spacing="3">
        <Label text="Họ tên" styleClass="staff-caption"/>
        <Label fx:id="lblDetailFullName" text="Trần Minh Đức" wrapText="true" styleClass="staff-detail-value"/>
    </VBox>
    <VBox spacing="3">
        <Label text="Chức vụ" styleClass="staff-caption"/>
        <Label fx:id="lblDetailPosition" text="Nha sĩ" styleClass="staff-detail-value"/>
    </VBox>
    <HBox spacing="12" alignment="TOP_LEFT">
        <VBox spacing="3" minWidth="92" prefWidth="92" maxWidth="92">
            <Label text="SĐT" styleClass="staff-caption"/>
            <Label fx:id="lblDetailPhone" text="0902 123 456" wrapText="true" styleClass="staff-detail-value"/>
        </VBox>
        <VBox spacing="3" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <Label text="Email" styleClass="staff-caption"/>
            <Label fx:id="lblDetailEmail" text="minhduc@example.com" wrapText="true" minHeight="-Infinity" styleClass="staff-detail-value"/>
        </VBox>
    </HBox>
    <Separator/>
    <Button fx:id="btnEditStaff" text="Sửa" graphicTextGap="8" styleClass="secondary-button">
        <graphic><ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
            <image><Image url="@/images/staff/edit-staff.png"/></image>
        </ImageView></graphic>
    </Button>
</VBox>
