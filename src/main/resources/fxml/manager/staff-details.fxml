<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="staffSelectedDetails" stylesheets="@/css/manager-staff.css" styleClass="staff-page, staff-details" spacing="16" minWidth="0">
    <Label fx:id="lblSelectedStaffName" text="—" wrapText="true" styleClass="staff-card-title"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="lblSelectedStaffSummary" text="—" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="staff-detail-summary"/>
        <Label fx:id="lblSelectedStaffStatusBadge" text="—" styleClass="staff-detail-badge"/>
    </HBox>
    <Separator/>
    <HBox spacing="12">
        <VBox spacing="3" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
            <Label text="Họ tên" styleClass="staff-caption"/>
            <Label fx:id="lblDetailFullName" text="—" wrapText="true" styleClass="staff-detail-value"/>
        </VBox>
        <VBox spacing="3" HBox.hgrow="ALWAYS" prefWidth="0" minWidth="0">
            <Label text="Mã NV" styleClass="staff-caption"/>
            <Label fx:id="lblDetailStaffId" text="—" styleClass="staff-detail-value"/>
        </VBox>
    </HBox>
    <VBox spacing="3">
        <Label text="Chức vụ" styleClass="staff-caption"/>
        <Label fx:id="lblDetailPosition" text="—" styleClass="staff-detail-value"/>
    </VBox>
    <VBox spacing="3">
        <Label text="SĐT" styleClass="staff-caption"/>
        <Label fx:id="lblDetailPhone" text="—" styleClass="staff-detail-value"/>
    </VBox>
    <VBox spacing="3">
        <Label text="Email" styleClass="staff-caption"/>
        <Label fx:id="lblDetailEmail" text="—" wrapText="true" styleClass="staff-detail-value"/>
    </VBox>
    <Label text="—" styleClass="staff-detail-value"/>
    <VBox spacing="3">
        <Label text="Trạng thái" styleClass="staff-caption"/>
        <Label fx:id="lblDetailStatus" text="—" styleClass="staff-detail-value"/>
    </VBox>
    <Separator/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnEditStaff" text="Sửa" graphicTextGap="8" styleClass="secondary-button" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/staff/edit-staff.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnStaffAccountPermissions" text="Tài khoản &amp; quyền" styleClass="secondary-button" disable="true"/>
    </HBox>
</VBox>
