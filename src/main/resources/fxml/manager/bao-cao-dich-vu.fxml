<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="dichVuSuDungBanBaoCao" spacing="20" minWidth="0" prefHeight="1088">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="bao-cao-bo-loc-the">
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="bao-cao-truong">
            <Label text="Từ ngày" styleClass="bao-cao-truong-nhan"/>
            <DatePicker fx:id="dpDichVuSuDungTu" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="bao-cao-ngay">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="bao-cao-truong">
            <Label text="Đến ngày" styleClass="bao-cao-truong-nhan"/>
            <DatePicker fx:id="dpDichVuSuDungDen" editable="false" maxWidth="Infinity" minWidth="0" accessibleText="Chưa tải dữ liệu" styleClass="bao-cao-ngay">
                <!-- Chỉ chữ xem trước; Nhi tự setValue(LocalDate) và converter khi viết Controller. -->
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="bao-cao-truong">
            <Label text="Dịch vụ" styleClass="bao-cao-truong-nhan"/>
            <ComboBox fx:id="cboDichVuSuDungDichVu" maxWidth="Infinity" minWidth="0" styleClass="bao-cao-bo-loc" accessibleText="Lọc dịch vụ, dữ liệu mẫu" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <VBox spacing="2" minWidth="0" HBox.hgrow="ALWAYS" styleClass="bao-cao-truong">
            <Label text="Nha sĩ" styleClass="bao-cao-truong-nhan"/>
            <ComboBox fx:id="cboDichVuSuDungNhaSi" maxWidth="Infinity" minWidth="0" styleClass="bao-cao-bo-loc" accessibleText="Lọc nha sĩ, dữ liệu mẫu" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <Button fx:id="btnApDungDichVuSuDungBanBaoCao" text="Áp dụng" minWidth="-Infinity" styleClass="chinh-nut" disable="true"/>
    </HBox>
    <GridPane fx:id="dichVuSuDungCacChiSo" hgap="16" minHeight="132" prefHeight="132" maxHeight="132">
        <rowConstraints>
            <RowConstraints percentHeight="100" fillHeight="true"/>
        </rowConstraints>
        <columnConstraints>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
            <ColumnConstraints percentWidth="25" fillWidth="true"/>
        </columnConstraints>
        <VBox spacing="8" minWidth="0" styleClass="bao-cao-the" GridPane.columnIndex="0">
            <Label text="Tổng dịch vụ thực hiện" styleClass="bao-cao-chi-so-nhan" wrapText="true"/>
            <Label fx:id="lblDichVuSuDungTong" text="—" styleClass="bao-cao-chi-so-gia-tri" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblDichVuSuDungTongGhiChu" text="Chỉ định trong kỳ báo cáo" styleClass="bao-cao-chu-thich" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="bao-cao-the" GridPane.columnIndex="1">
            <Label text="Dịch vụ phổ biến nhất" styleClass="bao-cao-chi-so-nhan" wrapText="true"/>
            <Label fx:id="lblDichVuSuDungPhoBien" text="—" styleClass="bao-cao-chi-so-gia-tri" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblDichVuSuDungPhoBienGhiChu" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="bao-cao-the" GridPane.columnIndex="2">
            <Label text="Tổng doanh thu dịch vụ" styleClass="bao-cao-chi-so-nhan" wrapText="true"/>
            <Label fx:id="lblDichVuSuDungDoanhThu" text="—" styleClass="bao-cao-chi-so-gia-tri" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblDichVuSuDungDoanhThuGhiChu" text="Trong kỳ báo cáo" styleClass="bao-cao-chu-thich" minHeight="-Infinity" wrapText="true"/>
        </VBox>
        <VBox spacing="8" minWidth="0" styleClass="bao-cao-the" GridPane.columnIndex="3">
            <Label text="Trung bình dịch vụ/lượt khám" styleClass="bao-cao-chi-so-nhan" wrapText="true"/>
            <Label fx:id="lblDichVuSuDungTrungBinh" text="—" styleClass="bao-cao-chi-so-gia-tri" minHeight="-Infinity" wrapText="true"/>
            <Label fx:id="lblDichVuSuDungTrungBinhGhiChu" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich" minHeight="-Infinity" wrapText="true"/>
        </VBox>
    </GridPane>
    <VBox spacing="16" minWidth="0" styleClass="bao-cao-the">
        <Label fx:id="lblDichVuSuDungBieuDoTieuDe" text="Top dịch vụ được sử dụng" styleClass="bao-cao-the-tieu-de"/>
        <Label fx:id="lblDichVuSuDungBieuDoPhuDe" text="Khác là nhóm dịch vụ gộp, không phải một dịch vụ riêng" styleClass="bao-cao-chu-thich" wrapText="true"/>
        <!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
        <HBox fx:id="bieuDoDichVuSuDung" spacing="20" alignment="BOTTOM_CENTER" minHeight="222" prefHeight="222" maxHeight="222" styleClass="bao-cao-bieu-do" accessibleText="Top dịch vụ được sử dụng, dữ liệu minh họa">
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblDichVuSuDungThanhGiaTri1" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhDichVuSuDung1" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh, bao-cao-thanh-nhan-manh"/>
                <Label text="Cạo vôi răng" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblDichVuSuDungThanhGiaTri2" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhDichVuSuDung2" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="Trám răng composite" styleClass="bao-cao-truc-nhan"/>
            </VBox>
            <VBox spacing="8" alignment="BOTTOM_CENTER" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <Label fx:id="lblDichVuSuDungThanhGiaTri3" text="—" styleClass="bao-cao-thanh-gia-tri"/>
                <Region fx:id="thanhDichVuSuDung3" minHeight="0" prefHeight="0" maxHeight="0" maxWidth="Infinity" styleClass="bao-cao-thanh"/>
                <Label text="Khác (gộp)" styleClass="bao-cao-truc-nhan"/>
            </VBox>
        </HBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="bao-cao-duong-phan-cach"/>
        <Label fx:id="lblDichVuSuDungBieuDoGhiChu" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="16" minWidth="0" styleClass="bao-cao-the">
        <Label text="Dữ liệu chi tiết" styleClass="bao-cao-the-tieu-de"/>
        <VBox styleClass="bao-cao-bang-vien">
            <!-- Chỉ đọc; không mở chi tiết, không hover/selected highlight.
                 editable=false không tắt selection: Nhi tự setSelectionModel(null) khi nối Controller. -->
            <TableView fx:id="tblDichVuSuDung" editable="false" focusTraversable="false" fixedCellSize="72" minHeight="254" prefHeight="254" maxHeight="254" styleClass="bao-cao-bang">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colDichVuSuDungTen" text="Tên dịch vụ" prefWidth="330" minWidth="215" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="name"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colDichVuSuDungSoLuong" text="Số lượt thực hiện" prefWidth="178" minWidth="150" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="count"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colDichVuSuDungDonGia" text="Đơn giá" prefWidth="168" minWidth="140" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="price"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colDichVuSuDungDoanhThu" text="Doanh thu" prefWidth="244" minWidth="160" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="revenue"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colDichVuSuDungSuDungTyLe" text="Tỷ lệ sử dụng" prefWidth="188" minWidth="135" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="rate"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="6" alignment="CENTER_LEFT" minHeight="40" prefHeight="40" styleClass="bao-cao-bang-chan">
                <Label fx:id="lblDichVuSuDungHoSoSoLuong" text="Chưa tải dữ liệu" styleClass="bao-cao-chu-thich"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnDichVuSuDungTruocTrang" text="‹" disable="true" accessibleText="Trang báo cáo trước" styleClass="bao-cao-trang-nut"/>
                <Label fx:id="lblDichVuSuDungHienTaiTrang" text="—" styleClass="bao-cao-chu-thich"/>
                <Button fx:id="btnDichVuSuDungTiepTrang" text="›" disable="true" accessibleText="Trang báo cáo tiếp theo, chưa có xử lý" styleClass="bao-cao-trang-nut"/>
            </HBox>
        </VBox>
    </VBox>
    <VBox spacing="2">
    </VBox>
</VBox>
