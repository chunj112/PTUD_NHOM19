<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- DENTIST · examination · Figma 104:17484.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Dữ liệu minh họa từ Figma; file trạng thái chỉ dùng preview, không tự lưu.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không có handler Java; Controller của nhóm sẽ nối sau. -->
<VBox fx:id="editPrescriptionMedicine" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/dentist-common.css, @/css/dentist-examination.css" styleClass="dentist-modal, dentist-examination" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Sửa thuốc trong đơn" styleClass="dt-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="dt-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng"/>
    </HBox>
    <Label fx:id="lblMedicinePatient" text="BN001 · Nguyễn Văn A · PK001 · DT001 · Trần Minh Đức" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="dt-divider"/>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
        <Label text="Tên thuốc *" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtMedicineName" text="Paracetamol" styleClass="dt-field-input"/>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Hàm lượng" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtMedicineStrength" text="500 mg" styleClass="dt-field-input"/>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Số lượng *" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtMedicineQuantity" text="10" styleClass="dt-field-input"/>
            </VBox>
        </VBox>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Đơn vị" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <ComboBox fx:id="cboMedicineUnit" value="Viên" maxWidth="Infinity" minWidth="0" styleClass="dt-field-choice">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Viên"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Số ngày" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtMedicineDays" text="5" styleClass="dt-field-input"/>
            </VBox>
        </VBox>
    </HBox>
    <Label text="LIỀU DÙNG" styleClass="dt-section-title" wrapText="true" minHeight="-Infinity"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
            <Label text="Sáng" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtDoseMorning" text="1" styleClass="dt-field-input"/>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
            <Label text="Trưa" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtDoseNoon" text="0" styleClass="dt-field-input"/>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
            <Label text="Chiều" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtDoseAfternoon" text="1" styleClass="dt-field-input"/>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
            <Label text="Tối" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtDoseNight" text="0" styleClass="dt-field-input"/>
        </VBox>
        <VBox minWidth="140" prefWidth="140" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field" maxWidth="140">
            <Label text="Cách dùng" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <ComboBox fx:id="cboMedicineRoute" value="Uống" maxWidth="Infinity" minWidth="0" styleClass="dt-field-choice">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Uống"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
        <Label text="Ghi chú" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtMedicineInstructions" text="Uống sau ăn khi đau. Tối đa 4 viên/ngày." styleClass="dt-field-input"/>
    </VBox>
    <Label fx:id="lblMedicineAllergy" text="Bệnh nhân dị ứng Penicillin. Kiểm tra chống chỉ định trước khi kê thuốc." styleClass="dt-alert, dt-alert-warning" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Label fx:id="lblManualPrescriptionRule" text="Thuốc được nhập thủ công. Bệnh nhân tự mua thuốc ngoài phòng khám." styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="dt-divider"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button"/>
        <Button fx:id="btnSaveMedicine" text="Lưu thay đổi" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
</VBox>
