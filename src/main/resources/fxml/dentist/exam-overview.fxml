<!-- DENTIST · examination · Figma 59:32334.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Dữ liệu minh họa từ Figma; file trạng thái chỉ dùng preview, không tự lưu.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không có handler Java; Controller của nhóm sẽ nối sau. -->
<VBox fx:id="dentistExamOverview" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/dentist-common.css, @/css/dentist-examination.css" styleClass="dentist-page, dentist-examination" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="720">
