<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="danhSachChoKham" fx:controller="iuh.se.nhom19.view.dentist.DanhSachChoKhamController"
      stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css"
      styleClass="khung-ung-dung, le-tan-trang" spacing="20" minWidth="900">
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Tổng quan nha sĩ" styleClass="trang-tieu-de"/>
            <Label text="Danh sách chờ của nha sĩ đang đăng nhập · Chi tiết chỉ đọc" wrapText="true" styleClass="mo"/>
        </VBox>
        <Button fx:id="btnLamMoiChoKham" text="Làm mới" styleClass="phu-nut" disable="true"/>
    </HBox>
    <Label fx:id="lblThongBao" text="" wrapText="true"/>
    <VBox styleClass="le-tan-the" spacing="12">
        <Label fx:id="lblSoLuongChoKham" text="Chưa tải dữ liệu" styleClass="le-tan-the-tieu-de"/>
        <TableView fx:id="tblChoKham" editable="false" prefHeight="380" fixedCellSize="60" styleClass="le-tan-bang">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="cotMaPhieu" text="Mã phiếu" prefWidth="190"/>
                <TableColumn fx:id="cotBenhNhan" text="Bệnh nhân" prefWidth="190"/>
                <TableColumn fx:id="cotTiepNhan" text="Tiếp nhận lúc" prefWidth="180"/>
                <TableColumn fx:id="cotPhong" text="Phòng" prefWidth="75"/>
                <TableColumn fx:id="cotLyDo" text="Lý do khám" prefWidth="220"/>
            </columns>
        </TableView>
    </VBox>
    <VBox fx:id="chiTietPhieuKham" visible="false" managed="false" styleClass="le-tan-the" spacing="12">
        <Label text="Chi tiết phiếu khám · Chỉ đọc" styleClass="le-tan-the-tieu-de"/>
        <Label fx:id="lblMaPhieu" text=""/>
        <Label fx:id="lblBenhNhan" text="" wrapText="true"/>
        <HBox spacing="16"><Label text="Tiếp nhận:"/><Label fx:id="lblThoiDiem" text=""/></HBox>
        <HBox spacing="16"><Label text="Phòng:"/><Label fx:id="lblPhong" text=""/></HBox>
        <Label fx:id="lblNguonTiepNhan" text="" wrapText="true"/>
        <Label fx:id="lblLyDo" text="" wrapText="true"/>
        <Label fx:id="lblTrangThai" text=""/>
    </VBox>
</VBox>
