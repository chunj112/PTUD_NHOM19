<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Mặc định Sidebar: hàng chờ, không chọn hàng, không mở phiếu.
     Panel theo User Flow mới; bảng và bộ lọc giữ nền Figma 59:32993.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Dữ liệu minh họa từ Figma; file trạng thái chỉ dùng preview, không tự lưu.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không có handler Java; Controller của nhóm sẽ nối sau. -->
<VBox fx:id="dentistNoPatient" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/dentist-common.css, @/css/dentist-examination.css" styleClass="dentist-page, dentist-examination" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPageTitle" text="Khám bệnh" styleClass="dt-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblPageSubtitle" text="Phiếu khám · Ghi nhận khám và chỉ định trong cùng một hồ sơ" styleClass="dt-subtitle" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtWaitingPatientSearch" promptText="Tìm bệnh nhân / mã phiếu khám" minWidth="0" HBox.hgrow="ALWAYS" styleClass="dt-search"/>
        <DatePicker fx:id="dpWaitingDate" prefWidth="190" minWidth="190" maxWidth="190" editable="false" styleClass="dt-filter">
            <editor text="09/10/2026"/>
        </DatePicker>
        <ComboBox fx:id="cboWaitingRoom" value="P01" prefWidth="150" minWidth="150" maxWidth="150" styleClass="dt-filter">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="P01"/>
                    <String fx:value="P02"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>
    <VBox fx:id="waitingQueueCard" spacing="16" minWidth="0" styleClass="dt-card">
        <Label text="Bệnh nhân chờ khám" styleClass="dt-card-title" wrapText="true" minHeight="-Infinity"/>
        <HBox spacing="16" alignment="TOP_LEFT">
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS">
                <VBox styleClass="dt-table-frame">
                    <TableView fx:id="tblWaitingPatients" editable="false" fixedCellSize="72" minHeight="332" prefHeight="332" maxHeight="332" styleClass="dt-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Chưa có dữ liệu" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="tblWaitingPatientsColTime" text="Giờ" minWidth="60" prefWidth="80" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v0"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblWaitingPatientsColExam" text="Phiếu khám" minWidth="80" prefWidth="100" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v1"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblWaitingPatientsColPatient" text="Bệnh nhân" minWidth="150" prefWidth="190" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v2"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblWaitingPatientsColReason" text="Lý do khám" minWidth="140" prefWidth="180" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v3"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblWaitingPatientsColStatus" text="Trạng thái" minWidth="110" prefWidth="130" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v4"/>
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <HashMap v0="09:00" v1="PK001" v2="BN001 · Nguyễn Văn A" v3="Đau răng hàm dưới">
                                    <v4>
                                        <Label text="Chờ khám" styleClass="dt-status-warning" wrapText="true" minHeight="-Infinity"/>
                                    </v4>
                                </HashMap>
                                <HashMap v0="09:15" v1="PK002" v2="BN002 · Trần Thị B" v3="Kiểm tra định kỳ">
                                    <v4>
                                        <Label text="Chờ khám" styleClass="dt-status-warning" wrapText="true" minHeight="-Infinity"/>
                                    </v4>
                                </HashMap>
                                <HashMap v0="09:30" v1="PK004" v2="BN004 · Phạm Thị D" v3="Ê buốt khi ăn">
                                    <v4>
                                        <Label text="Chờ khám" styleClass="dt-status-warning" wrapText="true" minHeight="-Infinity"/>
                                    </v4>
                                </HashMap>
                                <HashMap v0="09:45" v1="PK007" v2="BN007 · Vũ Văn G" v3="Kiểm tra sau điều trị">
                                    <v4>
                                        <Label text="Chờ khám" styleClass="dt-status-warning" wrapText="true" minHeight="-Infinity"/>
                                    </v4>
                                </HashMap>
                            </FXCollections>
                        </items>
                    </TableView>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="dt-table-footer">
                        <Label fx:id="tblWaitingPatientsCount" text="Hiển thị 4 / 4 bản ghi" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="tblWaitingPatientsPrevious" text="‹" minWidth="-Infinity" styleClass="dt-page-button" disable="true"/>
                        <Label fx:id="tblWaitingPatientsPage" text="1" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                        <Button fx:id="tblWaitingPatientsNext" text="›" minWidth="-Infinity" styleClass="dt-page-button" disable="true"/>
                    </HBox>
                </VBox>
            </VBox>
            <VBox fx:id="patientDetailArea" spacing="16" minWidth="300" prefWidth="300" maxWidth="300">
                <VBox fx:id="noPatientPanel" spacing="16" minWidth="0" styleClass="dt-card">
                    <Label text="Chưa chọn bệnh nhân" styleClass="dt-card-title" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblNoPatientHint" text="Chọn một dòng trong danh sách để xem thông tin và bắt đầu khám." styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
                    <Button fx:id="btnStartExamination" text="Bắt đầu khám" disable="true" styleClass="primary-button" minWidth="-Infinity"/>
                </VBox>
                <!-- Controller nạp queue-patient-detail.fxml sau khi chọn một phiếu; xóa children khi bỏ chọn. -->
                <VBox fx:id="selectedPatientDetail" spacing="16" minWidth="0" visible="false" managed="false"/>
            </VBox>
        </HBox>
        <Label fx:id="lblQueueNotice" text="Bệnh nhân đã tiếp nhận · Chưa chọn bệnh nhân" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <Label fx:id="lblDemoNotice" text="DỮ LIỆU MINH HỌA · Không kết nối SQL Server · 09/10/2026" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
