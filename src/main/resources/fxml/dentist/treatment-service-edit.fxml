<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- DENTIST · examination · Figma 285:10155.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Dữ liệu minh họa từ Figma; file trạng thái chỉ dùng preview, không tự lưu.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không có handler Java; Controller của nhóm sẽ nối sau. -->
<VBox fx:id="editTreatmentService" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/dentist-common.css, @/css/dentist-examination.css" styleClass="dentist-modal, dentist-examination" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Sửa dịch vụ" styleClass="dt-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="dt-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng"/>
    </HBox>
    <Label fx:id="lblServicePatient" text="BN001 · Nguyễn Văn A · PK001 · Trần Minh Đức" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="dt-divider"/>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
        <Label text="Tên dịch vụ *" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
        <ComboBox fx:id="cboTreatmentService" value="Trám răng composite" maxWidth="Infinity" minWidth="0" styleClass="dt-field-choice">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Trám răng composite"/>
                    <String fx:value="Cạo vôi răng"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="dt-field">
                <Label text="Vị trí răng" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="serviceTeethRemove36" text="36 ×" minWidth="-Infinity" styleClass="dt-tooth-chip"/>
                    <Button fx:id="serviceTeethSelect" text="+ Chọn răng" minWidth="-Infinity" styleClass="secondary-button, dt-mini-button"/>
                </HBox>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Số lượng *" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtServiceQuantity" text="1" styleClass="dt-field-input"/>
            </VBox>
        </VBox>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field, dt-field-readonly">
        <Label text="Đơn giá · Chỉ đọc" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtServiceUnitPrice" text="500.000 ₫" styleClass="dt-field-input" editable="false" focusTraversable="false"/>
    </VBox>
    <Label fx:id="lblServicePriceNote" text="Đơn giá theo danh mục dịch vụ phòng khám, không thể chỉnh sửa." styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="dt-total-row">
        <Label text="Thành tiền" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Label fx:id="lblServiceAmount" text="500.000 ₫" styleClass="dt-status-info" wrapText="true" minHeight="-Infinity"/>
    </HBox>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="dt-divider"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button"/>
        <Button fx:id="btnSaveService" text="Lưu thay đổi" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
</VBox>
