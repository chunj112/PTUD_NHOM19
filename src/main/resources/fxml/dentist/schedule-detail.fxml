<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- DENTIST · schedule · Figma 15:1451.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Dữ liệu minh họa từ Figma; file trạng thái chỉ dùng preview, không tự lưu.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không có handler Java; Controller của nhóm sẽ nối sau. -->
<VBox fx:id="dentistScheduleDetail" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/dentist-common.css, @/css/dentist-schedule.css" styleClass="dentist-page, dentist-schedule" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity">
    <VBox spacing="16" minWidth="0" styleClass="dt-card">
        <Label fx:id="lblShiftTitle" text="Chi tiết ca" styleClass="dt-card-title" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblShiftStatus" text="Đang thực hiện" styleClass="dt-status-info" wrapText="true" minHeight="-Infinity"/>
        <VBox spacing="4" minWidth="0" styleClass="dt-detail">
            <Label text="Nhân viên" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblShiftEmployee" text="NV002 · Trần Minh Đức" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="dt-detail">
            <Label text="Thời gian" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblShiftTime" text="09/10/2026 · 08:00–12:00" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="dt-detail">
            <Label text="Phòng" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblShiftRoom" text="P01 · Ghế nha khoa 01" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="dt-detail">
            <Label text="Công việc" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblShiftWork" text="Khám tổng quát và điều trị" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="dt-divider"/>
        <VBox spacing="4" minWidth="0" styleClass="dt-detail">
            <Label text="Ghi chú từ quản lý" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblShiftManagerNote" text="Ưu tiên ca đã tiếp nhận; kiểm tra dụng cụ đầu ca." styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Label fx:id="lblShiftReadonly" text="Thông tin phân công chỉ đọc." styleClass="dt-alert, dt-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    </VBox>
</VBox>
