<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- DENTIST · schedule · Figma 15:1451.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Dữ liệu minh họa từ Figma; file trạng thái chỉ dùng preview, không tự lưu.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không có handler Java; Controller của nhóm sẽ nối sau. -->
<VBox fx:id="dentistScheduleDay" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/dentist-common.css, @/css/dentist-schedule.css" styleClass="dentist-page, dentist-schedule" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="860">
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="20" minWidth="0" HBox.hgrow="ALWAYS">
            <VBox spacing="16" minWidth="0" styleClass="dt-card">
                <Label fx:id="lblDayScheduleDate" text="Thứ Sáu · 09/10/2026" styleClass="dt-card-title" wrapText="true" minHeight="-Infinity"/>
                <VBox styleClass="dt-table-frame">
                    <TableView fx:id="tblDailyShifts" editable="false" fixedCellSize="72" minHeight="188" prefHeight="188" maxHeight="188" styleClass="dt-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Chưa có dữ liệu" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="tblDailyShiftsColTime" text="Giờ" minWidth="110" prefWidth="150" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v0"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblDailyShiftsColRoom" text="Phòng" minWidth="70" prefWidth="100" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v1"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblDailyShiftsColWork" text="Công việc" minWidth="160" prefWidth="270" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v2"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblDailyShiftsColStatus" text="Trạng thái" minWidth="130" prefWidth="160" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v3"/>
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <HashMap v0="08:00–12:00" v1="P01" v2="Khám tổng quát và điều trị">
                                    <v3>
                                        <Label text="Đang thực hiện" styleClass="dt-status-info" wrapText="true" minHeight="-Infinity"/>
                                    </v3>
                                </HashMap>
                                <HashMap v0="13:30–17:00" v1="P01" v2="Điều trị theo lịch hẹn">
                                    <v3>
                                        <Label text="Chờ thực hiện" styleClass="dt-status-warning" wrapText="true" minHeight="-Infinity"/>
                                    </v3>
                                </HashMap>
                            </FXCollections>
                        </items>
                    </TableView>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="dt-table-footer">
                        <Label fx:id="tblDailyShiftsCount" text="Hiển thị 2 / 2 bản ghi" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="tblDailyShiftsPrevious" text="‹" minWidth="-Infinity" styleClass="dt-page-button" disable="true"/>
                        <Label fx:id="tblDailyShiftsPage" text="1" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                        <Button fx:id="tblDailyShiftsNext" text="›" minWidth="-Infinity" styleClass="dt-page-button" disable="true"/>
                    </HBox>
                </VBox>
                <Label fx:id="lblScheduleRule" text="Mọi thay đổi lịch vui lòng liên hệ quản lý. Lịch hẹn chi tiết được hiển thị trong hàng chờ khám." styleClass="dt-alert, dt-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            </VBox>
            <fx:include fx:id="upcomingSchedule" source="schedule-upcoming.fxml"/>
        </VBox>
        <VBox spacing="16" minWidth="330" prefWidth="330" maxWidth="330">
            <fx:include fx:id="selectedShiftDetail" source="schedule-detail.fxml"/>
        </VBox>
    </HBox>
</VBox>
