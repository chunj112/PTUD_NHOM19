<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- DENTIST · profile · Figma 104:17777.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Dữ liệu minh họa từ Figma; file trạng thái chỉ dùng preview, không tự lưu.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không có handler Java; Controller của nhóm sẽ nối sau. -->
<VBox fx:id="dentistProfileEdit" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/dentist-common.css, @/css/dentist-profile.css" styleClass="dentist-modal, dentist-profile" spacing="16" minWidth="640" prefWidth="640" maxWidth="640" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Chỉnh sửa hồ sơ" styleClass="dt-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="dt-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng"/>
    </HBox>
    <Label fx:id="lblEditProfileNotice" text="Chỉ cập nhật thông tin cá nhân của tài khoản đang đăng nhập." styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field, dt-field-readonly">
            <Label text="Mã NV · Chỉ đọc" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtProfileEmployeeId" text="NV002" styleClass="dt-field-input" editable="false" focusTraversable="false"/>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field, dt-field-readonly">
            <Label text="Chức vụ · Chỉ đọc" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtProfileRole" text="Nha sĩ" styleClass="dt-field-input" editable="false" focusTraversable="false"/>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field, dt-field-readonly">
            <Label text="Quyền · Chỉ đọc" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtProfilePermission" text="NHASI" styleClass="dt-field-input" editable="false" focusTraversable="false"/>
        </VBox>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
        <Label text="Họ tên *" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtProfileName" text="Trần Minh Đức" styleClass="dt-field-input"/>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Số điện thoại *" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtProfilePhone" text="0902 123 456" styleClass="dt-field-input"/>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Email" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtProfileEmail" text="minhduc@example.com" styleClass="dt-field-input"/>
            </VBox>
        </VBox>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Ngày sinh" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <DatePicker fx:id="dpProfileBirthDate" maxWidth="Infinity" minWidth="0" editable="false" styleClass="dt-field-date">
                    <editor text="15/08/1988"/>
                </DatePicker>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field">
                <Label text="Giới tính" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <ComboBox fx:id="cboProfileGender" value="Nam" maxWidth="Infinity" minWidth="0" styleClass="dt-field-choice">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Nam"/>
                            <String fx:value="Nữ"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
        </VBox>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="dt-field, dt-field-tall">
        <Label text="Địa chỉ" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
        <TextArea fx:id="txtProfileAddress" text="42 Nguyễn Trãi, TP. Hồ Chí Minh" wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="dt-field-area"/>
    </VBox>
    <Label fx:id="lblEditProfileRule" text="Không thể thay đổi mã nhân viên, chức vụ hoặc quyền truy cập trong hồ sơ cá nhân." styleClass="dt-alert, dt-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="dt-divider"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button"/>
        <Button fx:id="btnSaveProfile" text="Lưu thay đổi" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
</VBox>
