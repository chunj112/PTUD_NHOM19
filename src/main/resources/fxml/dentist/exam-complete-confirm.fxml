<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- DENTIST · examination · Figma 59:36191.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Dữ liệu minh họa từ Figma; file trạng thái chỉ dùng preview, không tự lưu.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không có handler Java; Controller của nhóm sẽ nối sau. -->
<VBox fx:id="completeExamConfirmation" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/dentist-common.css, @/css/dentist-examination.css" styleClass="dentist-modal, dentist-examination" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Xác nhận hoàn tất khám" styleClass="dt-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="dt-close, dt-plain-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng"/>
    </HBox>
    <Label fx:id="lblCompletePatient" text="BN001 · Nguyễn Văn A · PK001 · Trần Minh Đức" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="dt-divider"/>
    <Label fx:id="lblCompleteRule" text="Kiểm tra thông tin trước khi hoàn tất phiếu khám. Sau khi xác nhận, nội dung lâm sàng sẽ chuyển sang chỉ đọc." styleClass="dt-body" wrapText="true" minHeight="-Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="dt-detail">
                <Label text="Bệnh nhân" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblConfirmPatient" text="Nguyễn Văn A · BN001" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="dt-detail">
                <Label text="Phiếu khám" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblConfirmExam" text="PK001 · 09/10/2026" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
    </HBox>
    <VBox spacing="4" minWidth="0" styleClass="dt-detail">
        <Label text="Chẩn đoán" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblConfirmDiagnosis" text="Sâu ngà răng 36; cao răng toàn hàm" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox styleClass="dt-table-frame">
        <TableView fx:id="tblCompleteExamItems" editable="false" fixedCellSize="72" minHeight="260" prefHeight="260" maxHeight="260" styleClass="dt-table, dt-readonly-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Chưa có dữ liệu" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="tblCompleteExamItemsColItem" text="Dịch vụ / thuốc" minWidth="300" prefWidth="365" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v0"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="tblCompleteExamItemsColQuantity" text="Số lượng" minWidth="90" prefWidth="100" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v1"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="tblCompleteExamItemsColAmount" text="Thành tiền" minWidth="120" prefWidth="130" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v2"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <HashMap v0="Trám răng composite · 36" v1="1" v2="500.000 ₫"/>
                    <HashMap v0="Cạo vôi răng · Toàn hàm" v1="1" v2="300.000 ₫"/>
                    <HashMap v0="Paracetamol 500 mg (mua ngoài)" v1="10 viên" v2="—"/>
                </FXCollections>
            </items>
        </TableView>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="dt-detail">
                <Label text="Tổng tạm tính" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblConfirmTotal" text="800.000 ₫" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="dt-detail">
                <Label text="Nha sĩ xác nhận" styleClass="dt-caption" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblConfirmDentist" text="Trần Minh Đức" styleClass="dt-detail-value" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
    </HBox>
    <Label fx:id="lblConfirmCompleteRule" text="Chẩn đoán đầy đủ; dịch vụ đã thực hiện. Hoàn tất để chuyển ca khám sang Chờ lập hóa đơn." styleClass="dt-alert, dt-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="dt-divider"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button"/>
        <Button fx:id="btnConfirmCompleteExam" text="Xác nhận hoàn tất" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
</VBox>
