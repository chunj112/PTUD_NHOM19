<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- UC001: chỉ đăng nhập bằng tài khoản SQL Server; không có chế độ chọn Role. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="loginRoot" fx:controller="vn.edu.nhom19.nhakhoa.view.common.DangNhapController" styleClass="shell, login-shell" stylesheets="@/css/theme.css, @/css/login.css">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <ImageView fitWidth="40" fitHeight="40" preserveRatio="true" accessibleText="Logo DentaFlow">
                <image>
                    <Image url="@/images/dentaflow-logo.png"/>
                </image>
            </ImageView>
            <Label text="DentaFlow · Hệ thống quản lý phòng khám" styleClass="brand-name" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Ứng dụng nội bộ" styleClass="muted"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="shell-scroll, login-scroll">
            <content>
                <StackPane alignment="CENTER" styleClass="login-stage">
                    <HBox maxWidth="1056" minWidth="0" styleClass="login-card" alignment="TOP_LEFT">
                        <VBox prefWidth="500" minWidth="320" minHeight="600" spacing="28" HBox.hgrow="ALWAYS" styleClass="login-intro">
                            <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                                <image>
                                    <Image url="@/images/shell/login-shield.png"/>
                                </image>
                            </ImageView>
                            <Label text="HỆ THỐNG QUẢN LÝ PHÒNG KHÁM NHA KHOA" wrapText="true" styleClass="login-heading"/>
                            <Label text="Một không gian làm việc thống nhất cho tiếp nhận, khám bệnh và vận hành phòng khám." wrapText="true" styleClass="body-text"/>
                            <Separator/>
                            <VBox spacing="20">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/login-calendar.png"/>
                                        </image>
                                    </ImageView>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Tiếp nhận &amp; lịch hẹn" styleClass="identity-name"/>
                                        <Label text="Sắp xếp lịch, tiếp nhận đúng quy trình." wrapText="true" styleClass="muted"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/login-exam.png"/>
                                        </image>
                                    </ImageView>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Khám &amp; điều trị" styleClass="identity-name"/>
                                        <Label text="Hồ sơ, dịch vụ và đơn thuốc cùng một ca khám." wrapText="true" styleClass="muted"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/login-operations.png"/>
                                        </image>
                                    </ImageView>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Quản lý vận hành" styleClass="identity-name"/>
                                        <Label text="Nhân sự, phân công và báo cáo." wrapText="true" styleClass="muted"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            <Label text="Quản lý phòng khám theo quy trình thống nhất." wrapText="true" styleClass="muted"/>
                        </VBox>
                        <VBox xmlns:fx="http://javafx.com/fxml/1" prefWidth="556" minWidth="360" minHeight="600" spacing="20" HBox.hgrow="ALWAYS" styleClass="login-form">
                            <VBox spacing="6">
                                <Label fx:id="lblTieuDeDangNhap" text="Đăng nhập" styleClass="page-title"/>
                                <Label fx:id="lblMoTaDangNhap" text="Sử dụng tài khoản nhân viên của phòng khám." wrapText="true" styleClass="body-text"/>
                            </VBox>
                            <Label fx:id="lblThongBaoDangNhap" text="Các chức năng chưa hoàn thiện sẽ hiển thị trạng thái đang phát triển." wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="info-banner"/>
                            <VBox fx:id="vungDangNhap" spacing="16">
                                <VBox spacing="8">
                                    <Label text="Tên đăng nhập" styleClass="identity-name"/>
                                    <TextField fx:id="txtTenDangNhap" promptText="Nhập tên đăng nhập" maxWidth="Infinity" styleClass="login-input"/>
                                </VBox>
                                <VBox spacing="8">
                                    <Label text="Mật khẩu" styleClass="identity-name"/>
                                    <StackPane>
                                        <PasswordField fx:id="txtMatKhau" promptText="Nhập mật khẩu" maxWidth="Infinity" onAction="#xuLyDangNhap" styleClass="login-input"/>
                                        <TextField fx:id="txtMatKhauHien" promptText="Nhập mật khẩu" visible="false" managed="false" maxWidth="Infinity" onAction="#xuLyDangNhap" styleClass="login-input" accessibleText="Mật khẩu đang hiển thị"/>
                                    </StackPane>
                                    <CheckBox fx:id="chkHienMatKhau" text="Hiển thị mật khẩu" onAction="#doiHienThiMatKhau"/>
                                </VBox>
                                <Button fx:id="btnDangNhap" text="Đăng nhập" defaultButton="true" maxWidth="Infinity" onAction="#xuLyDangNhap" styleClass="primary-button"/>
                                <HBox fx:id="vungDangXuLy" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false">
                                    <ProgressIndicator prefWidth="20" prefHeight="20" maxWidth="20" maxHeight="20"/>
                                    <Label text="Đang đăng nhập…" styleClass="muted"/>
                                </HBox>
                            </VBox>
                            <Label fx:id="lblLoiDangNhap" text="" wrapText="true" minHeight="-Infinity" visible="false" managed="false" maxWidth="Infinity" styleClass="error-banner"/>
                            <Region VBox.vgrow="ALWAYS" minHeight="12"/>
                            <Label text="Quyền truy cập được xác định theo chức vụ của nhân viên." wrapText="true" styleClass="muted"/>
                        </VBox>
                    </HBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <Label text="DentaFlow · IUH · Nhóm 19" alignment="CENTER" maxWidth="Infinity" wrapText="true" styleClass="muted"/>
    </bottom>
</BorderPane>
