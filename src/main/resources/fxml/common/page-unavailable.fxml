<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<!-- One shared content-only placeholder; never implies successful CRUD or a working Backend. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" spacing="20">
    <Label fx:id="lblPageTitle" text="Màn hình" wrapText="true" styleClass="page-title"/>
    <VBox spacing="12" styleClass="notice-card">
        <Label text="CHƯA TRIỂN KHAI" styleClass="preview-badge"/>
        <Label fx:id="lblPageMessage" text="Màn hình đang được phát triển." wrapText="true" styleClass="body-text"/>
    </VBox>
</VBox>
