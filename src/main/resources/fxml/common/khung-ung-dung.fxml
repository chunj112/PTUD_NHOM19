<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="khungUngDung" fx:controller="iuh.se.nhom19.view.common.KhungUngDungController" styleClass="khung-ung-dung" stylesheets="@/css/chu-de.css" prefWidth="1280.0" prefHeight="800.0">
    <left>
        <VBox fx:id="thanhBen" minWidth="232.0" prefWidth="232.0" maxWidth="232.0" spacing="24.0" styleClass="thanh-ben">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <ImageView fx:id="imgThuongHieuLogo" fitWidth="38.0" fitHeight="38.0" preserveRatio="true" smooth="true" accessibleText="Logo DentaFlow">
                    <image>
                        <Image url="@/images/dentaflow-logo.png"/>
                    </image>
                </ImageView>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="DentaFlow" styleClass="thuong-hieu-ten"/>
                    <Label text="Quản lý phòng khám" styleClass="mo"/>
                </VBox>
            </HBox>
            <Label fx:id="lblVaiTro" text="" styleClass="vai-tro-nhan"/>
            <ScrollPane fx:id="thanhBenCuon" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" minHeight="0.0" VBox.vgrow="ALWAYS" styleClass="khung-ung-dung-cuon, dieu-huong-trang-cuon">
                <content>
                    <VBox fx:id="trinhDonDieuHuong" spacing="6.0" fillWidth="true">
                        <Button fx:id="btnTongQuan" text="Dashboard" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut, trinh-don-da-chon">
                            <graphic>
                                <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                    <image>
                                        <Image url="@/images/shell/dashboard.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <VBox fx:id="trinhDonQuanLy" spacing="6.0" fillWidth="true" visible="false" managed="false">
                            <Button fx:id="btnNhanSu" text="Nhân sự" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/users.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="btnPhanCong" text="Lịch &amp; Phân công" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/calendar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="btnDichVu" text="Dịch vụ" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/services.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="btnBaoCao" text="Báo cáo" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/reports.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </VBox>
                        <VBox fx:id="trinhDonLeTan" spacing="6.0" fillWidth="true" visible="false" managed="false">
                            <Button fx:id="btnTrangTiepNhanLichHen" text="Tiếp nhận &amp; Lịch hẹn" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/intake.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="btnThuNgan" text="Thu ngân" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/wallet.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="btnTraCuuBenhNhan" text="Tra cứu" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/search.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="btnLichLeTan" text="Lịch làm việc" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/calendar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </VBox>
                        <VBox fx:id="trinhDonNhaSi" spacing="6.0" fillWidth="true" visible="false" managed="false">
                            <Button fx:id="btnKhamBenh" text="Khám bệnh" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/exam.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="btnLichNhaSi" text="Lịch làm việc" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/calendar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </VBox>
                        <VBox fx:id="trinhDonYTa" spacing="6.0" fillWidth="true" visible="false" managed="false">
                            <Button fx:id="btnLichYTa" text="Lịch làm việc" maxWidth="Infinity" alignment="CENTER_LEFT" graphicTextGap="10.0" styleClass="dieu-huong-nut">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/calendar.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
            <VBox spacing="2.0" styleClass="thanh-ben-danh-tinh">
                <Label fx:id="lblTenThanhBen" text="" maxWidth="Infinity" styleClass="danh-tinh-ten"/>
                <Label fx:id="lblTrangThaiThanhBen" text="" wrapText="true" styleClass="mo"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <BorderPane fx:id="vungLamViec" minWidth="0.0">
            <top>
                <HBox fx:id="thanhTren" alignment="CENTER_LEFT" spacing="18.0" minHeight="68.0" prefHeight="68.0" maxHeight="68.0" styleClass="thanh-tren">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" minWidth="0.0">
                        <Label fx:id="lblVaiTroDuongDan" text="" styleClass="duong-dan"/>
                        <Label text="/" styleClass="duong-dan-phan-cach"/>
                        <Label fx:id="lblTrangDuongDan" text="" styleClass="duong-dan"/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" minWidth="0.0"/>
                    <Label fx:id="lblNgayHienTai" text="" styleClass="mo"/>
                    <Label fx:id="lblChuCaiDauHoTen" text="" alignment="CENTER" minWidth="32.0" prefWidth="32.0" maxWidth="32.0" minHeight="32.0" prefHeight="32.0" maxHeight="32.0" styleClass="anh-dai-dien"/>
                    <MenuButton fx:id="mnuTaiKhoan" text="" styleClass="tai-khoan-trinh-don" popupSide="BOTTOM">
                        <items>
                            <MenuItem fx:id="miThongTinCaNhan" text="Hồ sơ cá nhân">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/profile.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </MenuItem>
                            <MenuItem fx:id="miThayDoiMatKhau" text="Đổi mật khẩu">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/password.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </MenuItem>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="miDangXuat" text="Đăng xuất" onAction="#xuLyDangXuat">
                                <graphic>
                                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                                        <image>
                                            <Image url="@/images/shell/logout.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </MenuItem>
                        </items>
                    </MenuButton>
                </HBox>
            </top>
            <center>
                <ScrollPane fx:id="vungCuonNoiDung" fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="khung-ung-dung-cuon">
                    <content>
                        <StackPane fx:id="vungNoiDung" alignment="TOP_LEFT" minWidth="0.0" styleClass="chinh-noi-dung">
                            <!-- Prompt 02 supplies actual Dashboard and business pages. -->
                            <VBox fx:id="khungUngDungChoTrong" spacing="20.0" fillWidth="true">
                                <VBox spacing="4.0">
                                    <Label text="Chào mừng đến với DentaFlow" wrapText="true" styleClass="trang-tieu-de"/>
                                    <Label text="Hệ thống quản lý phòng khám nha khoa" wrapText="true" styleClass="noi-dung-chinh-van-ban"/>
                                </VBox>
                                <VBox spacing="12.0" styleClass="luu-y-the">
                                    <Label text="Không gian làm việc" styleClass="the-tieu-de"/>
                                    <Label text="Các màn hình nghiệp vụ sẽ được hiển thị tại đây." wrapText="true" styleClass="noi-dung-chinh-van-ban"/>
                                    <Label text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." wrapText="true" styleClass="mo"/>
                                </VBox>
                                <Region VBox.vgrow="ALWAYS" minHeight="24.0"/>
                                <Label text="DentaFlow · IUH · Nhóm 19" styleClass="mo"/>
                            </VBox>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
