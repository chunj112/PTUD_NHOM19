<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="appointmentDetail" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-intake.css" styleClass="receptionist-page, receptionist-intake" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity">
    <VBox spacing="16" minWidth="0" styleClass="rx-card">
        <Label fx:id="lblAppointmentTitle" text="Chi tiết lịch hẹn" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="rx-divider"/>
        <Label fx:id="lblAppointmentStatus" text="—" styleClass="rx-status-warning" wrapText="true" minHeight="-Infinity"/>
        <VBox spacing="4" minWidth="0" styleClass="rx-detail">
            <Label text="Bệnh nhân" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblAppointmentPatient" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                    <Label text="Điện thoại" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblAppointmentPhone" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                    <Label text="Tuổi / giới tính" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblAppointmentAgeGender" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
        </HBox>
        <VBox spacing="4" minWidth="0" styleClass="rx-detail">
            <Label text="Ngày / giờ" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblAppointmentDateTime" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="rx-detail">
            <Label text="Nha sĩ / phòng" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblAppointmentDentistRoom" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="rx-detail">
            <Label text="Lý do khám" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblAppointmentReason" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Label fx:id="lblAppointmentAllergy" text="—" styleClass="rx-alert, rx-alert-warning" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="btnEditAppointment" text="Sửa lịch" minWidth="-Infinity" styleClass="secondary-button" disable="true"/>
            <Button fx:id="btnCancelAppointment" text="Hủy lịch" minWidth="-Infinity" styleClass="secondary-button, rx-danger-button" disable="true"/>
        </HBox>
        <Button fx:id="btnAdmitAppointment" text="Tiếp nhận" minWidth="-Infinity" styleClass="primary-button" maxWidth="Infinity" disable="true"/>
    </VBox>
</VBox>
