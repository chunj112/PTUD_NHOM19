<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="cashFailedPreview" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-cashier.css" styleClass="receptionist-modal, receptionist-cashier, rx-state-card" spacing="16" minWidth="640" prefWidth="640" maxWidth="640" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Thanh toán thất bại" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Hóa đơn" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblCashFailedInvoice" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <Label fx:id="lblCashFailedMessage" text="—" styleClass="rx-alert, rx-alert-danger" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnRetryCashPayment" text="Thử lại" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
        <Button fx:id="btnClosePaymentResult" text="Đóng" minWidth="-Infinity" styleClass="secondary-button" disable="true"/>
    </HBox>
</VBox>
