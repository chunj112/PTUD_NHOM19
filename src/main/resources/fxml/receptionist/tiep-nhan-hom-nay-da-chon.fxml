<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="tiepNhanHomNayDaChon" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-tiep-nhan.css" styleClass="le-tan-trang, le-tan-tiep-nhan" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="800">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtLichHenTimKiem" promptText="Nhập số điện thoại bệnh nhân" minWidth="0" HBox.hgrow="ALWAYS" styleClass="le-tan-tim-kiem"/>
        <DatePicker fx:id="dpLichHenNgayLam" prefWidth="190" minWidth="190" maxWidth="190" editable="false" styleClass="le-tan-bo-loc">
            <editor text=""/>
        </DatePicker>
        <ComboBox fx:id="cboLichHenNhaSi" prefWidth="230" minWidth="230" maxWidth="230" styleClass="le-tan-bo-loc" promptText="Tất cả nha sĩ" value="Tất cả nha sĩ">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả nha sĩ"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="0" styleClass="le-tan-the" HBox.hgrow="ALWAYS">
            <Label text="Lịch hẹn hôm nay" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <Label text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <VBox styleClass="le-tan-bang-vien">
                <TableView fx:id="tblHomNayDanhSachLichHen" editable="false" fixedCellSize="72" minHeight="404" prefHeight="404" maxHeight="404" styleClass="le-tan-bang">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotGio" text="Giờ" minWidth="60" prefWidth="80" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v0"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotBenhNhan" text="Bệnh nhân" minWidth="150" prefWidth="200" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v1"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotNhaSi" text="Nha sĩ" minWidth="115" prefWidth="150" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v2"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotLyDo" text="Lý do khám" minWidth="125" prefWidth="170" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v3"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotTinhTrang" text="Trạng thái" minWidth="120" prefWidth="150" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v4"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="le-tan-bang-chan">
                    <Label fx:id="tblHomNayDanhSachLichHenSoLuong" text="Chưa tải dữ liệu" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="tblHomNayDanhSachLichHenTruoc" text="‹" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                    <Label fx:id="tblHomNayDanhSachLichHenTrang" text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Button fx:id="tblHomNayDanhSachLichHenTiep" text="›" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                </HBox>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="—" styleClass="le-tan-tinh-trang-canh-bao" wrapText="true" minHeight="-Infinity"/>
                <Label text="—" styleClass="le-tan-tinh-trang-thong-tin-ngan" wrapText="true" minHeight="-Infinity"/>
                <Label text="—" styleClass="le-tan-tinh-trang-nguy-hiem" wrapText="true" minHeight="-Infinity"/>
            </HBox>
        </VBox>
        <VBox spacing="16" minWidth="350" prefWidth="350" maxWidth="350">
            <VBox spacing="16" minWidth="0" styleClass="le-tan-the" visible="false" managed="false">
                <Label text="Chi tiết lịch hẹn" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
                <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="le-tan-duong-phan-cach"/>
                <Label fx:id="lblLichHenLuaChonGoiY" text="Chọn một lịch hẹn để xem chi tiết" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <VBox spacing="16" minWidth="0" fx:id="daChonLichHenKhung" visible="true" managed="true">
                <fx:include fx:id="daChonLichHenChiTiet" source="chi-tiet-lich-hen.fxml"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>
