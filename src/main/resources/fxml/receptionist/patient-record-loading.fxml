<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="patientRecordLoading" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-patients.css" styleClass="receptionist-page, receptionist-patients" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPageTitle" text="TRA CỨU BỆNH NHÂN" styleClass="rx-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblPageSubtitle" text="Tìm hồ sơ theo mã bệnh nhân, họ tên hoặc số điện thoại" styleClass="rx-subtitle" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="rx-card">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="VA" styleClass="rx-patient-avatar" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblSelectedPatientName" text="—" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="btnChangePatient" text="Đổi bệnh nhân" minWidth="-Infinity" styleClass="secondary-button" disable="true"/>
        </HBox>
        <Label fx:id="lblSelectedPatientSummary" text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <TabPane fx:id="loadingPatientTabs" tabClosingPolicy="UNAVAILABLE" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="${loadingPatientTabs.selectionModel.selectedItem.content.prefHeight + 66}" styleClass="rx-tabs">
        <tabs>
            <Tab fx:id="tabLoadingInformation" text="Thông tin">
                <content>
                    <fx:include fx:id="tabLoadingInformationContent" source="patient-loading-detail.fxml"/>
                </content>
            </Tab>
            <Tab fx:id="tabLoadingHistory" text="Lịch sử khám">
                <content>
                    <fx:include fx:id="tabLoadingHistoryContent" source="patient-loading-detail.fxml"/>
                </content>
            </Tab>
            <Tab fx:id="tabLoadingServices" text="Dịch vụ">
                <content>
                    <fx:include fx:id="tabLoadingServicesContent" source="patient-loading-detail.fxml"/>
                </content>
            </Tab>
            <Tab fx:id="tabLoadingPrescriptions" text="Đơn thuốc">
                <content>
                    <fx:include fx:id="tabLoadingPrescriptionsContent" source="patient-loading-detail.fxml"/>
                </content>
            </Tab>
            <Tab fx:id="tabLoadingInvoices" text="Hoá đơn">
                <content>
                    <fx:include fx:id="tabLoadingInvoicesContent" source="patient-loading-detail.fxml"/>
                </content>
            </Tab>
        </tabs>
    </TabPane>
    <Label fx:id="lblDemoNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
