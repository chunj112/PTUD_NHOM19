<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="matKhauDangXuLyXemTruoc" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-ca-nhan.css" styleClass="le-tan-hop-thoai-noi, le-tan-thong-tin-ca-nhan" spacing="16" minWidth="503" prefWidth="503" maxWidth="503" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblHopThoaiTieuDe" text="Đổi mật khẩu" styleClass="le-tan-hop-thoai-noi-tieu-de" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnDong" text="×" minWidth="32" styleClass="le-tan-dong" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" disable="true"/>
    </HBox>
    <Label text="Dùng chung · Quản lý / Lễ tân / Nha sĩ / Y tá" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
    <VBox spacing="2" styleClass="truong-nhap, le-tan-truong-chi-doc">
        <Label text="Mật khẩu hiện tại *" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <PasswordField fx:id="matKhauHienTaiMatKhau" promptText="••••••••" editable="false" styleClass="le-tan-mat-khau-nhap"/>
    </VBox>
    <VBox spacing="2" styleClass="truong-nhap, le-tan-truong-chi-doc">
        <Label text="Mật khẩu mới *" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <PasswordField fx:id="matKhauMoiMatKhau" promptText="••••••••••" editable="false" styleClass="le-tan-mat-khau-nhap"/>
    </VBox>
    <VBox spacing="2" styleClass="truong-nhap, le-tan-truong-chi-doc">
        <Label text="Xác nhận mật khẩu mới *" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <PasswordField fx:id="matKhauXacNhanMatKhau" promptText="••••••••••" editable="false" styleClass="le-tan-mat-khau-nhap"/>
    </VBox>
    <Label fx:id="lblMatKhauCacDieuKien" text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
    <Label fx:id="lblMatKhauDangXuLy" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thong-tin-ngan" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnHuy" text="Hủy" minWidth="-Infinity" styleClass="phu-nut" cancelButton="true" disable="true"/>
        <Button fx:id="btnCapNhatMatKhau" text="Đang xử lý" minWidth="-Infinity" styleClass="chinh-nut" disable="true" graphicTextGap="8">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/password-processing.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
</VBox>
