<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="leTanThongTinCaNhanBangTruot" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-ca-nhan.css" styleClass="le-tan-hop-thoai-noi, le-tan-thong-tin-ca-nhan" spacing="16" minWidth="503" prefWidth="503" maxWidth="503" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblHopThoaiTieuDe" text="Hồ sơ cá nhân" styleClass="le-tan-hop-thoai-noi-tieu-de" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnDong" text="×" minWidth="32" styleClass="le-tan-dong" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" disable="true"/>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="TH" styleClass="le-tan-thong-tin-ca-nhan-anh-dai-dien" wrapText="true" minHeight="-Infinity"/>
        <VBox spacing="4" minWidth="0">
            <Label fx:id="lblThongTinCaNhanTen" text="—" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblThongTinCaNhanMaVaiTro" text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="le-tan-duong-phan-cach"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                <Label text="Họ tên" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblThongTinCaNhanDayDuTen" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                <Label text="Mã NV" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblThongTinCaNhanNhanVienMa" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
    </HBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Chức vụ" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblThongTinCaNhanVaiTro" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Số điện thoại" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblThongTinCaNhanSoDienThoai" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Email" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblThongTinCaNhanEmail" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                <Label text="Ngày sinh" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblThongTinCaNhanSinhNgay" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                <Label text="Giới tính" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblThongTinCaNhanGioiTinh" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
    </HBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Địa chỉ" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblThongTinCaNhanDiaChi" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Trạng thái tài khoản" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblThongTinCaNhanTaiKhoanTinhTrang" text="—" styleClass="le-tan-chi-tiet-gia-tri, le-tan-thong-tin-ca-nhan-hoat-dong" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <Label fx:id="lblThongTinCaNhanChiDoc" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thong-tin-ngan" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="le-tan-duong-phan-cach"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnSuaCaNhanThongTinCaNhan" text="Chỉnh sửa hồ sơ" minWidth="-Infinity" styleClass="chinh-nut" disable="true"/>
        <Button fx:id="btnThayDoiMatKhau" text="Đổi mật khẩu" minWidth="-Infinity" styleClass="phu-nut" disable="true"/>
    </HBox>
</VBox>
