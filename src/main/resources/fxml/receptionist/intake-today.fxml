<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="intakeToday" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-intake.css" styleClass="receptionist-page, receptionist-intake" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="800">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtAppointmentSearch" promptText="Tìm bệnh nhân / mã lịch hẹn" minWidth="0" HBox.hgrow="ALWAYS" styleClass="rx-search"/>
        <DatePicker fx:id="dpAppointmentDay" prefWidth="190" minWidth="190" maxWidth="190" editable="false" styleClass="rx-filter">
            <editor text=""/>
        </DatePicker>
        <ComboBox fx:id="cboAppointmentDentist" prefWidth="230" minWidth="230" maxWidth="230" styleClass="rx-filter" promptText="Tất cả nha sĩ" value="Tất cả nha sĩ">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả nha sĩ"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="0" styleClass="rx-card" HBox.hgrow="ALWAYS">
            <Label text="Lịch hẹn hôm nay" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <VBox styleClass="rx-table-frame">
                <TableView fx:id="tblTodayAppointments" editable="false" fixedCellSize="72" minHeight="404" prefHeight="404" maxHeight="404" styleClass="rx-table">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="tblTodayAppointmentsColTime" text="Giờ" minWidth="60" prefWidth="80" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v0"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblTodayAppointmentsColPatient" text="Bệnh nhân" minWidth="150" prefWidth="200" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v1"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblTodayAppointmentsColDentist" text="Nha sĩ" minWidth="115" prefWidth="150" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v2"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblTodayAppointmentsColReason" text="Lý do khám" minWidth="125" prefWidth="170" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v3"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblTodayAppointmentsColStatus" text="Trạng thái" minWidth="120" prefWidth="150" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v4"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rx-table-footer">
                    <Label fx:id="tblTodayAppointmentsCount" text="Chưa tải dữ liệu" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="tblTodayAppointmentsPrevious" text="‹" minWidth="-Infinity" styleClass="rx-page-button" disable="true"/>
                    <Label fx:id="tblTodayAppointmentsPage" text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Button fx:id="tblTodayAppointmentsNext" text="›" minWidth="-Infinity" styleClass="rx-page-button" disable="true"/>
                </HBox>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="—" styleClass="rx-status-warning" wrapText="true" minHeight="-Infinity"/>
                <Label text="—" styleClass="rx-status-info" wrapText="true" minHeight="-Infinity"/>
                <Label text="—" styleClass="rx-status-danger" wrapText="true" minHeight="-Infinity"/>
            </HBox>
        </VBox>
        <!-- Chưa chọn dòng: ẩn và không giữ chỗ panel. Controller nạp đúng lịch hẹn
             rồi bật cả visible/managed; bỏ chọn thì tắt cả hai thuộc tính. -->
        <VBox fx:id="selectedAppointmentPane" spacing="16" minWidth="350" prefWidth="350" maxWidth="350" visible="false" managed="false">
            <fx:include fx:id="selectedAppointmentDetail" source="appointment-detail.fxml"/>
        </VBox>
    </HBox>
</VBox>
