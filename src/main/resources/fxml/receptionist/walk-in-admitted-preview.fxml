<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · intake · Figma 104:16410.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="walkInAdmittedPreview" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-intake.css" styleClass="receptionist-page, receptionist-intake" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="1040">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rx-step-bar">
        <Label fx:id="lblWalkInStepPatient" text="✓ Tìm và chọn bệnh nhân" styleClass="rx-status-info" wrapText="true" minHeight="-Infinity"/>
        <Label text="›" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblWalkInStepSlot" text="2  Chọn ca và tiếp nhận" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </HBox>
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="420" styleClass="rx-card" prefWidth="420" maxWidth="420">
            <Label text="Bước 1 · Tìm bệnh nhân" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label text="Kiểm tra hồ sơ trước khi tạo bệnh nhân mới." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
                <Label text="Tìm mã BN / họ tên / SĐT" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtWalkInPatientSearch" text="BN001" styleClass="rx-field-input"/>
            </VBox>
            <Button fx:id="btnSearchWalkInPatient" text="Tìm kiếm" minWidth="-Infinity" styleClass="primary-button"/>
            <Label text="1 hồ sơ phù hợp" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <VBox spacing="16" minWidth="0" styleClass="rx-card, rx-selected-card">
                <Label fx:id="lblWalkInSelectedName" text="Nguyễn Văn A" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
                <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                    <Label text="Mã bệnh nhân" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblWalkInSelectedId" text="BN001" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                    <Label text="SĐT" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblWalkInSelectedPhone" text="0912 345 678" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                    <Label text="Tuổi / giới tính" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblWalkInSelectedAge" text="34 tuổi · Nam" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <Label text="✓ Đã chọn" styleClass="rx-status-info" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <Label fx:id="lblWalkInAllergy" text="Dị ứng Penicillin · Thông tin được chuyển vào phiếu khám." styleClass="rx-alert, rx-alert-warning" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            <Button fx:id="btnChangeWalkInPatient" text="Chọn bệnh nhân khác" minWidth="-Infinity" styleClass="secondary-button"/>
        </VBox>
        <VBox spacing="16" minWidth="0" styleClass="rx-card" HBox.hgrow="ALWAYS">
            <Label text="Bước 2 · Chọn ca và tiếp nhận" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label text="Chọn ca trống của nha sĩ đang làm việc." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field" disable="false">
                    <Label text="Nha sĩ *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <ComboBox fx:id="cboWalkInDentist" value="Trần Minh Đức" maxWidth="Infinity" minWidth="0" styleClass="rx-field-choice">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Chọn nha sĩ"/>
                                <String fx:value="Trần Minh Đức"/>
                                <String fx:value="Nguyễn Lan Anh"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
                <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field" disable="false">
                    <Label text="Ngày khám *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <DatePicker fx:id="dpWalkInDate" maxWidth="Infinity" minWidth="0" editable="false" styleClass="rx-field-date">
                        <editor text="09/10/2026"/>
                    </DatePicker>
                </VBox>
            </HBox>
            <Label text="Ca trống trong ngày" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="0" styleClass="rx-card, rx-slot-selected" fx:id="walkInSlot0" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="lblWalkInSlotTime0" text="11:30–12:00" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                    <Label text="Trần Minh Đức · P01" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label text="✓ Đã chọn" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="4" minWidth="0" styleClass="rx-card" fx:id="walkInSlot1" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="lblWalkInSlotTime1" text="14:00–14:30" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                    <Label text="Nguyễn Lan Anh · P02" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label text="Còn trống" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="4" minWidth="0" styleClass="rx-card" fx:id="walkInSlot2" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="lblWalkInSlotTime2" text="14:30–15:00" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                    <Label text="Trần Minh Đức · P01" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label text="Còn trống" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </HBox>
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field, rx-field-tall" disable="false">
                <Label text="Lý do khám *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextArea fx:id="txtWalkInReason" text="Đau răng hàm dưới, răng 36" wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="rx-field-area"/>
            </VBox>
            <Label fx:id="lblWalkInRule" text="Xác nhận tiếp nhận sẽ tạo phiếu khám và đưa bệnh nhân vào hàng chờ của nha sĩ. Không cần lịch hẹn trước." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btnResetWalkIn" text="Làm mới" minWidth="-Infinity" styleClass="secondary-button"/>
                <Button fx:id="btnAdmitWalkIn" text="Tiếp nhận bệnh nhân" minWidth="-Infinity" styleClass="primary-button" disable="false"/>
            </HBox>
        </VBox>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="rx-card">
        <Label text="Minh họa sau khi tiếp nhận" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblWalkInAdmittedPreview" text="Đã tiếp nhận BN001. Phiếu PK001 đã được tạo, bệnh nhân vào hàng chờ." styleClass="rx-alert, rx-alert-success" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
        <VBox styleClass="rx-table-frame">
            <TableView fx:id="tblAdmittedWalkIn" editable="false" fixedCellSize="72" minHeight="116" prefHeight="116" maxHeight="116" styleClass="rx-table, rx-readonly-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa có dữ liệu" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="tblAdmittedWalkInColExam" text="Phiếu khám" minWidth="90" prefWidth="120" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v0"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblAdmittedWalkInColPatient" text="Bệnh nhân" minWidth="150" prefWidth="220" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v1"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblAdmittedWalkInColTime" text="Giờ tiếp nhận" minWidth="160" prefWidth="210" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v2"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblAdmittedWalkInColDentist" text="Nha sĩ / phòng" minWidth="160" prefWidth="220" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v3"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblAdmittedWalkInColStatus" text="Trạng thái" minWidth="110" prefWidth="150" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v4"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <HashMap v0="PK001" v1="BN001 · Nguyễn Văn A" v2="09/10/2026 · 11:25" v3="Trần Minh Đức · P01">
                            <v4>
                                <Label text="Chờ khám" styleClass="rx-status-warning" wrapText="true" minHeight="-Infinity"/>
                            </v4>
                        </HashMap>
                    </FXCollections>
                </items>
            </TableView>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rx-table-footer">
                <Label fx:id="tblAdmittedWalkInCount" text="Hiển thị 1 / 1 bản ghi" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="tblAdmittedWalkInPrevious" text="‹" minWidth="-Infinity" styleClass="rx-page-button" disable="true"/>
                <Label fx:id="tblAdmittedWalkInPage" text="1" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <Button fx:id="tblAdmittedWalkInNext" text="›" minWidth="-Infinity" styleClass="rx-page-button" disable="true"/>
            </HBox>
        </VBox>
    </VBox>
</VBox>
