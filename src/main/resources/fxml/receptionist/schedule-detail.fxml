<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="receptionistScheduleDetail" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-schedule.css" styleClass="receptionist-page, receptionist-schedule" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity">
    <VBox spacing="16" minWidth="0" styleClass="rx-card">
        <Label fx:id="lblScheduleDetailTitle" text="Chi tiết ca" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblScheduleStatus" text="—" styleClass="rx-shift-status" wrapText="true" minHeight="-Infinity"/>
        <VBox spacing="4" minWidth="0" styleClass="rx-detail">
            <Label text="Nhân viên" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblReceptionistEmployee" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="rx-detail">
            <Label text="Ngày / ca" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblReceptionistShift" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="rx-detail">
            <Label text="Thời gian / phòng" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblReceptionistTimeRoom" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="rx-detail">
            <Label text="Công việc" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblReceptionistWork" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="rx-divider"/>
        <Label fx:id="lblScheduleReadonlyNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    </VBox>
</VBox>
