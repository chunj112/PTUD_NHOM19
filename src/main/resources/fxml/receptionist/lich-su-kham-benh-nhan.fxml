<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="benhNhanLichSu" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-benh-nhan.css" styleClass="le-tan-trang, le-tan-danh-sach-benh-nhan" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="800">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
            <Label text="Từ ngày" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <DatePicker fx:id="dpLichSuTu" maxWidth="Infinity" minWidth="0" editable="false" styleClass="le-tan-truong-ngay">
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
            <Label text="Đến ngày" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <DatePicker fx:id="dpLichSuDen" maxWidth="Infinity" minWidth="0" editable="false" styleClass="le-tan-truong-ngay">
                <editor text=""/>
            </DatePicker>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
            <Label text="Nha sĩ" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <ComboBox fx:id="cboLichSuNhaSi" maxWidth="Infinity" minWidth="0" styleClass="le-tan-truong-lua-chon" promptText="Tất cả" value="Tất cả">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Tất cả"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <Button fx:id="btnApDungLichSuBoLoc" text="Áp dụng" minWidth="-Infinity" styleClass="phu-nut" disable="true"/>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="le-tan-the">
        <Label text="Lịch sử khám" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
        <VBox styleClass="le-tan-bang-vien">
            <TableView fx:id="tblBenhNhanLichSu" editable="false" fixedCellSize="72" minHeight="188" prefHeight="188" maxHeight="188" styleClass="le-tan-bang">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="tblBenhNhanLichSuCotNgay" text="Ngày khám" minWidth="130" prefWidth="160" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v0"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanLichSuCotPhieuKham" text="Mã phiếu khám" minWidth="130" prefWidth="160" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v1"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanLichSuCotNhaSi" text="Nha sĩ" minWidth="150" prefWidth="190" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v2"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanLichSuCotLyDo" text="Lý do khám" minWidth="150" prefWidth="190" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v3"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanLichSuCotChanDoan" text="Chẩn đoán" minWidth="160" prefWidth="230" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v4"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanLichSuCotTinhTrang" text="Trạng thái" minWidth="110" prefWidth="140" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v5"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="le-tan-bang-chan">
                <Label fx:id="tblBenhNhanLichSuSoLuong" text="Chưa tải dữ liệu" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="tblBenhNhanLichSuTruoc" text="‹" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                <Label fx:id="tblBenhNhanLichSuTrang" text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Button fx:id="tblBenhNhanLichSuTiep" text="›" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
            </HBox>
        </VBox>
    </VBox>
    <VBox spacing="16" minWidth="0" styleClass="le-tan-the">
        <Label fx:id="lblLichSuChiTietTieuDe" text="Chi tiết phiếu khám" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                            <Label text="Ngày khám" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                            <Label fx:id="lblLichSuPhieuKhamNgay" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                        </VBox>
                    </VBox>
                    <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                            <Label text="Nha sĩ" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                            <Label fx:id="lblLichSuNhaSi" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
            <Label text="—" styleClass="le-tan-tinh-trang-thong-tin-ngan" wrapText="true" minHeight="-Infinity"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                    <Label text="Triệu chứng" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblLichSuTrieuChung" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                    <Label text="Chẩn đoán" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblLichSuChanDoan" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
        </HBox>
        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
            <Label text="Ghi chú" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblLichSuCacGhiChu" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                    <Label text="Dịch vụ đã thực hiện" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblLichSuDanhMucDichVu" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                    <Label text="Đơn thuốc liên quan" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblLichSuDonThuoc" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
    <Label fx:id="lblBenhNhanLichSuChiDoc" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thong-tin-ngan" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
</VBox>
