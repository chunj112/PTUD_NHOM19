<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Controller chỉ hiển thị dữ liệu đã đọc/lưu bằng SQL Server. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="iuh.se.nhom19.view.receptionist.LichHenTuanController" fx:id="tiepNhanTuan" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-tiep-nhan.css" styleClass="le-tan-trang, le-tan-tiep-nhan" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity">
    <Label fx:id="lblKetQuaTiepNhanTuan" text="" wrapText="true"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnTruocLichHenTuan" text="‹" accessibleText="Tuần trước" minWidth="-Infinity" styleClass="phu-nut" disable="true"/>
        <DatePicker fx:id="dpLichHenTuanNgayChon" editable="false" prefWidth="160" minWidth="160" maxWidth="160" styleClass="le-tan-bo-loc"/>
        <Button fx:id="btnTiepLichHenTuan" text="›" accessibleText="Tuần sau" minWidth="-Infinity" styleClass="phu-nut" disable="true"/>
        <ComboBox fx:id="cboTuanNhaSi" prefWidth="190" minWidth="190" maxWidth="190" styleClass="le-tan-bo-loc" promptText="Nha sĩ: Tất cả" value="Nha sĩ: Tất cả">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Nha sĩ: Tất cả"/>
                </FXCollections>
            </items>
        </ComboBox>
        <ComboBox fx:id="cboTuanTinhTrang" prefWidth="200" minWidth="200" maxWidth="200" styleClass="le-tan-bo-loc" promptText="Trạng thái: Tất cả" value="Trạng thái: Tất cả">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Trạng thái: Tất cả"/>
                    <String fx:value="Chờ tiếp nhận"/>
                    <String fx:value="Đã tiếp nhận"/>
                    <String fx:value="Đã hoàn tất"/>
                </FXCollections>
            </items>
        </ComboBox>
    </HBox>
        <Label fx:id="lblTuanThongBao" text="" wrapText="true"/>
        <Label fx:id="lblTuanCanhBaoLichTuongLai" text="" wrapText="true" styleClass="loi-truong"/>
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="0" prefWidth="0" styleClass="le-tan-the" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTuanKhoangNgay" text="—" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <Label text="Chọn lịch hẹn để xem chi tiết · Thời gian lấy từ lịch hẹn đã lưu" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <ScrollPane minWidth="0" minHeight="-Infinity" prefHeight="500" maxHeight="-Infinity" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="khung-ung-dung-cuon">
            <content><GridPane fx:id="lichHenTuanLuoi" minWidth="0" maxWidth="Infinity" hgap="8" minHeight="460" prefHeight="-1">
                <columnConstraints>
                    <ColumnConstraints percentWidth="14.285714285714286"/>
                    <ColumnConstraints percentWidth="14.285714285714286"/>
                    <ColumnConstraints percentWidth="14.285714285714286"/>
                    <ColumnConstraints percentWidth="14.285714285714286"/>
                    <ColumnConstraints percentWidth="14.285714285714286"/>
                    <ColumnConstraints percentWidth="14.285714285714286"/>
                    <ColumnConstraints percentWidth="14.285714285714286"/>
                </columnConstraints>
            </GridPane></content></ScrollPane>
        </VBox>
        <!-- Controller chỉ hiện panel sau khi chọn lịch hẹn; bỏ chọn thì đặt
             visible=false và managed=false để lịch tuần dùng hết chiều rộng. -->
        <VBox fx:id="daChonTuanLichHenKhung" minWidth="280" prefWidth="300" maxWidth="300" visible="false" managed="false">
            <fx:include fx:id="tuanLichHenPhanChiTiet" source="chi-tiet-lich-hen.fxml"/>
        </VBox>
    </HBox>
</VBox>
