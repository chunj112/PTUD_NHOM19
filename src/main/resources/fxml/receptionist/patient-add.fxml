<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · intake · Figma 7:3364.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="addPatientForm" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-intake.css" styleClass="receptionist-modal, receptionist-intake" spacing="16" minWidth="655" prefWidth="655" maxWidth="655" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Thêm/Sửa bệnh nhân" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="" minWidth="32" styleClass="rx-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" graphicTextGap="8">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/close-circle.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field, rx-field-readonly">
        <Label text="Mã bệnh nhân · Chỉ đọc" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtPatientId" text="Cấp sau khi lưu" styleClass="rx-field-input" editable="false" focusTraversable="false"/>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Họ tên *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtPatientName" text="Nguyễn Thị H" styleClass="rx-field-input"/>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
            <Label text="Ngày sinh *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <DatePicker fx:id="dpPatientBirthDate" maxWidth="Infinity" minWidth="0" editable="false" styleClass="rx-field-date">
                <editor text="21/04/1990"/>
            </DatePicker>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
            <Label text="Giới tính" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <ComboBox fx:id="cboPatientGender" value="Nữ" maxWidth="Infinity" minWidth="0" styleClass="rx-field-choice">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Nữ"/>
                        <String fx:value="Nam"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Số điện thoại *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtPatientPhone" text="0988 765 432" styleClass="rx-field-input"/>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Email" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtPatientEmail" text="Chưa cung cấp" styleClass="rx-field-input"/>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Địa chỉ" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtPatientAddress" text="48 Lê Văn Sỹ, TP. Hồ Chí Minh" styleClass="rx-field-input"/>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Dị ứng đã biết" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtPatientReportedAllergy" text="Chưa ghi nhận" styleClass="rx-field-input"/>
    </VBox>
    <Label fx:id="lblAddPatientRule" text="Lưu hồ sơ sẽ trở lại thẻ Khách không hẹn để chọn ca và tiếp nhận. Không tự tạo phiếu khám khi chỉ lưu hồ sơ." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button" cancelButton="true"/>
        <Button fx:id="btnSavePatient" text="Lưu &amp; trở lại tiếp nhận" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
</VBox>
