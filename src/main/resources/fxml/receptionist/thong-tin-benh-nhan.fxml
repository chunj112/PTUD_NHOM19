            </VBox>
            <Label text="—" styleClass="le-tan-tinh-trang-thong-tin-ngan" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblBenhNhanDiUng" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-canh-bao" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            <Label text="Chỉ chỉnh sửa thông tin cá nhân. Hồ sơ khám và điều trị chỉ đọc." styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
