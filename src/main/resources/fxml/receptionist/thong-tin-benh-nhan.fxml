<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="benhNhanThongTin" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-benh-nhan.css" styleClass="le-tan-trang, le-tan-danh-sach-benh-nhan" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="530">
    <HBox spacing="12" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="0" styleClass="le-tan-the" HBox.hgrow="ALWAYS" prefWidth="0">
            <Label text="THÔNG TIN CÁ NHÂN" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                        <Label text="Mã bệnh nhân" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                        <Label fx:id="lblBenhNhanMa" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                    </VBox>
                </VBox>
                <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                        <Label text="Họ tên" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
