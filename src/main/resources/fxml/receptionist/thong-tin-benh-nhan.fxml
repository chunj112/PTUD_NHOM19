            <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                <Label text="Nha sĩ gần nhất" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblBenhNhanGanNhatNhaSi" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                <Label text="Lịch hẹn sắp tới" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblBenhNhanTiepLichHen" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                <Label text="Trạng thái hiện tại" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
