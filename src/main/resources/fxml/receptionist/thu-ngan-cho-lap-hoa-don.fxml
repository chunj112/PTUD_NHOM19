<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="thuNganSanSang" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-thu-ngan.css" styleClass="le-tan-trang, le-tan-thu-ngan" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="810">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtThuNganTimKiem" promptText="Tìm SĐT bệnh nhân / mã phiếu khám / mã hóa đơn" minWidth="0" HBox.hgrow="ALWAYS" styleClass="le-tan-tim-kiem"/>
        <DatePicker fx:id="dpThuNganNgay" prefWidth="190" minWidth="190" maxWidth="190" editable="false" styleClass="le-tan-bo-loc">
            <editor text=""/>
        </DatePicker>
    </HBox>
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="334" styleClass="le-tan-the" prefWidth="334" maxWidth="334">
            <Label text="Ca khám hoàn tất" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <Label text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <VBox styleClass="le-tan-bang-vien">
                <TableView fx:id="tblSanSangCacPhieuKham" editable="false" fixedCellSize="72" minHeight="188" prefHeight="188" maxHeight="188" styleClass="le-tan-bang">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="tblSanSangCacPhieuKhamCotPhieuKham" text="Phiếu khám" minWidth="80" prefWidth="95" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v0"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblSanSangCacPhieuKhamCotBenhNhan" text="Bệnh nhân" minWidth="105" prefWidth="140" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v1"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblSanSangCacPhieuKhamCotTinhTrang" text="Trạng thái" minWidth="85" prefWidth="100" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v2"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="le-tan-bang-chan">
                    <Label fx:id="tblSanSangCacPhieuKhamSoLuong" text="Chưa tải dữ liệu" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="tblSanSangCacPhieuKhamTruoc" text="‹" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                    <Label fx:id="tblSanSangCacPhieuKhamTrang" text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Button fx:id="tblSanSangCacPhieuKhamTiep" text="›" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                </HBox>
            </VBox>
            <Label fx:id="lblSanSangHoaDonQuyTac" text="Chỉ hiển thị phiếu đã hoàn tất khám. Phiếu chưa hoàn tất không thể lập hóa đơn." styleClass="le-tan-canh-bao, le-tan-canh-bao-thong-tin-ngan" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS">
            <fx:include fx:id="nhapHoaDonPhanChiTiet" source="chi-tiet-hoa-don-nhap.fxml"/>
        </VBox>
    </HBox>
</VBox>
