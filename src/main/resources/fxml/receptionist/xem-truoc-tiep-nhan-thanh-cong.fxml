<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="tiepNhanThanhCongXemTruoc" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-tiep-nhan.css" styleClass="le-tan-hop-thoai-noi, le-tan-tiep-nhan" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblHopThoaiTieuDe" text="Tiếp nhận" styleClass="le-tan-hop-thoai-noi-tieu-de" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnDong" text="" minWidth="32" styleClass="le-tan-dong" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" graphicTextGap="8" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/close-circle.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap, le-tan-truong-chi-doc">
        <Label text="Bệnh nhân · Chỉ đọc" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtTiepNhanBenhNhan" text="" styleClass="le-tan-truong-nhap" editable="false" focusTraversable="false"/>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap, le-tan-truong-chi-doc">
        <Label text="Lịch hẹn · Chỉ đọc" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtTiepNhanLichHen" text="" styleClass="le-tan-truong-nhap" editable="false" focusTraversable="false"/>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
        <Label text="Nha sĩ *" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <ComboBox fx:id="cboTiepNhanNhaSi" maxWidth="Infinity" minWidth="0" styleClass="le-tan-truong-lua-chon" promptText="Chọn nha sĩ">
            <items>
                <FXCollections fx:factory="observableArrayList"/>
            </items>
        </ComboBox>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
        <Label text="Phòng *" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <ComboBox fx:id="cboTiepNhanPhong" maxWidth="Infinity" minWidth="0" styleClass="le-tan-truong-lua-chon" promptText="Chọn phòng">
            <items>
                <FXCollections fx:factory="observableArrayList"/>
            </items>
        </ComboBox>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap, le-tan-truong-cao">
        <Label text="Lý do khám *" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <TextArea fx:id="txtTiepNhanLyDo" text="" wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="le-tan-truong-vung"/>
    </VBox>
    <Label fx:id="lblTiepNhanDiUng" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-canh-bao" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Label fx:id="lblTiepNhanKetQua" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thong-tin-ngan" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnHuy" text="Hủy" minWidth="-Infinity" styleClass="phu-nut" cancelButton="true" disable="true"/>
        <Button fx:id="btnXacNhanTiepNhan" text="Xác nhận tiếp nhận" minWidth="-Infinity" styleClass="chinh-nut" disable="true"/>
    </HBox>
</VBox>
