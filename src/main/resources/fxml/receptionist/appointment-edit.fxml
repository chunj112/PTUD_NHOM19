<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · intake · Figma 40:6003.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="appointmenteditForm" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-intake.css" styleClass="receptionist-modal, receptionist-intake" spacing="16" minWidth="705" prefWidth="705" maxWidth="705" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Sửa lịch hẹn" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Tìm bệnh nhân *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtAppointmentPatient" text="BN001" styleClass="rx-field-input"/>
    </VBox>
    <VBox styleClass="rx-table-frame">
        <TableView fx:id="tblAppointmentPatientResults" editable="false" fixedCellSize="72" minHeight="116" prefHeight="116" maxHeight="116" styleClass="rx-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Chưa có dữ liệu" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="tblAppointmentPatientResultsColId" text="Mã BN" minWidth="80" prefWidth="160" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v0"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="tblAppointmentPatientResultsColName" text="Họ tên" minWidth="120" prefWidth="220" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v1"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="tblAppointmentPatientResultsColPhone" text="SĐT" minWidth="120" prefWidth="210" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v2"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <HashMap v0="BN001" v1="Nguyễn Văn A" v2="0912 345 678"/>
                </FXCollections>
            </items>
        </TableView>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Nha sĩ *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <ComboBox fx:id="cboAppointmentDentist" value="Trần Minh Đức" maxWidth="Infinity" minWidth="0" styleClass="rx-field-choice">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Trần Minh Đức"/>
                    <String fx:value="Nguyễn Lan Anh"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
            <Label text="Ngày hẹn *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <DatePicker fx:id="dpAppointmentDate" maxWidth="Infinity" minWidth="0" editable="false" styleClass="rx-field-date">
                <editor text="09/10/2026"/>
            </DatePicker>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
            <Label text="Giờ hẹn *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <ComboBox fx:id="cboAppointmentTime" value="09:00" maxWidth="Infinity" minWidth="0" styleClass="rx-field-choice">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="09:00"/>
                        <String fx:value="09:30"/>
                        <String fx:value="11:30"/>
                        <String fx:value="14:00"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Lý do khám *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtAppointmentReason" text="Đau răng hàm dưới, kiểm tra răng 36." styleClass="rx-field-input"/>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field, rx-field-tall">
        <Label text="Ghi chú" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextArea fx:id="txtAppointmentNotes" text="Đau răng hàm dưới, kiểm tra răng 36." wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="rx-field-area"/>
    </VBox>
    <Label fx:id="lblAppointmentFormRule" text="Tìm bệnh nhân trước khi chọn. Sửa lịch sử dụng cùng biểu mẫu, giữ mã LH001." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button" cancelButton="true"/>
        <Button fx:id="btnSaveAppointment" text="Lưu thay đổi" minWidth="-Infinity" styleClass="primary-button" disable="false"/>
    </HBox>
</VBox>
