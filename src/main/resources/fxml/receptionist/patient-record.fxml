<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · patients · Figma 59:31712, 59:31818, 59:32192.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="patientRecord" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-patients.css" styleClass="receptionist-page, receptionist-patients" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPageTitle" text="TRA CỨU BỆNH NHÂN" styleClass="rx-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblPageSubtitle" text="Tìm hồ sơ theo mã bệnh nhân, họ tên hoặc số điện thoại" styleClass="rx-subtitle" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="rx-card">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="VA" styleClass="rx-patient-avatar" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblSelectedPatientName" text="Nguyễn Văn A · BN001" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="btnChangePatient" text="Đổi bệnh nhân" minWidth="-Infinity" styleClass="secondary-button"/>
        </HBox>
        <Label fx:id="lblSelectedPatientSummary" text="SĐT: 0912 345 678 · Ngày sinh: 15/06/1992 · Giới tính: Nam" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <TabPane fx:id="patientRecordTabs" tabClosingPolicy="UNAVAILABLE" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="${patientRecordTabs.selectionModel.selectedItem.content.prefHeight + 66}" styleClass="rx-tabs">
        <tabs>
            <Tab fx:id="tabPatientInformation" text="Thông tin">
                <content>
                    <fx:include fx:id="tabPatientInformationContent" source="patient-information.fxml"/>
                </content>
            </Tab>
            <Tab fx:id="tabPatientHistory" text="Lịch sử khám">
                <content>
                    <fx:include fx:id="tabPatientHistoryContent" source="patient-history.fxml"/>
                </content>
            </Tab>
            <Tab fx:id="tabPatientInvoices" text="Hoá đơn">
                <content>
                    <fx:include fx:id="tabPatientInvoicesContent" source="patient-invoices.fxml"/>
                </content>
            </Tab>
        </tabs>
    </TabPane>
    <Label fx:id="lblDemoNotice" text="DỮ LIỆU MINH HỌA · Không kết nối SQL Server · 09/10/2026" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
