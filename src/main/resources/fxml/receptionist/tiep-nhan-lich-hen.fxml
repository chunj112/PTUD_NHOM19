<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<!-- Trang chính của lễ tân dùng AppShell chung; các tab chỉ chứa nội dung lịch. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="iuh.se.nhom19.view.receptionist.TiepNhanController" fx:id="leTanTiepNhan" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-tiep-nhan.css" styleClass="le-tan-trang, le-tan-tiep-nhan" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTrangTieuDe" text="Tiếp nhận &amp; Lịch hẹn" styleClass="le-tan-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblTrangPhuDe" text="Quản lý lịch hẹn và tiếp nhận bệnh nhân trong cùng một quy trình" styleClass="le-tan-phu-de" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Button fx:id="btnMoTiepNhanKhongHen" text="Tiếp nhận không hẹn" styleClass="phu-nut" graphicTextGap="8" disable="true">
            <graphic><SVGPath content="M 5 3 H 2 V 16 H 14 V 11 M 5 1 H 11 V 5 H 5 Z M 14 2 V 8 M 11 5 H 17" fill="TRANSPARENT" stroke="#087E91" strokeWidth="1.5"/></graphic>
        </Button>
        <Button fx:id="btnDatLichHen" text="Đặt lịch hẹn" minWidth="-Infinity" styleClass="chinh-nut" graphicTextGap="8" disable="true">
            <graphic><SVGPath content="M 2 3 H 16 V 16 H 2 Z M 2 7 H 16 M 6 1 V 5 M 12 1 V 5 M 9 9 V 14 M 6.5 11.5 H 11.5" fill="TRANSPARENT" stroke="WHITE" strokeWidth="1.5"/></graphic>
        </Button>
    </HBox>
    <Label fx:id="lblKetQuaKhongHen" text="" wrapText="true"/>
    <TabPane fx:id="tiepNhanCacTab" tabClosingPolicy="UNAVAILABLE" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" styleClass="le-tan-cac-tab">
        <tabs>
            <Tab fx:id="tabHomNay" text="Hôm nay"><content><fx:include fx:id="tabHomNayNoiDung" source="tiep-nhan-hom-nay.fxml"/></content></Tab>
            <Tab fx:id="tabTuan" text="Lịch tuần"><content><fx:include fx:id="tabTuanNoiDung" source="tiep-nhan-trong-tuan.fxml"/></content></Tab>
        </tabs>
    </TabPane>
</VBox>
