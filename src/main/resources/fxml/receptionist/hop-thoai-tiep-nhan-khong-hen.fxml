<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="khongHenTrongHopThoaiNoi" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-tiep-nhan.css" styleClass="le-tan-hop-thoai-noi, le-tan-tiep-nhan" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblHopThoaiTieuDe" text="Tiếp nhận khách không hẹn" styleClass="le-tan-hop-thoai-noi-tieu-de" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnDong" text="" minWidth="32" styleClass="le-tan-dong" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" graphicTextGap="8" disable="true">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/close-circle.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <Label text="—" styleClass="le-tan-tinh-trang-thong-tin-ngan" wrapText="true" minHeight="-Infinity"/>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
        <Label text="Tìm mã BN / họ tên / SĐT *" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtKhongHenTrongHopThoaiNoiTimKiem" text="" styleClass="le-tan-truong-nhap"/>
    </VBox>
    <Label fx:id="lblKhongHenTrongHopThoaiNoiChuaDaTimThay" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thong-tin-ngan" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Button fx:id="btnKhongHenTrongHopThoaiNoiTaoBenhNhan" text="Tạo hồ sơ bệnh nhân" minWidth="-Infinity" styleClass="phu-nut" graphicTextGap="8" disable="true">
        <graphic>
            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                <image>
                    <Image url="@/images/staff/add-staff.png"/>
                </image>
            </ImageView>
        </graphic>
    </Button>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
        <Label text="Nha sĩ đang có ca" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <ComboBox fx:id="cboKhongHenTrongHopThoaiNoiNhaSi" maxWidth="Infinity" minWidth="0" styleClass="le-tan-truong-lua-chon" promptText="Chọn nha sĩ">
            <items>
                <FXCollections fx:factory="observableArrayList"/>
            </items>
        </ComboBox>
    </VBox>
    <VBox styleClass="le-tan-bang-vien">
        <TableView fx:id="tblKhongHenTrongHopThoaiNoiCacKhungGio" editable="false" fixedCellSize="72" minHeight="188" prefHeight="188" maxHeight="188" styleClass="le-tan-bang">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="tblKhongHenTrongHopThoaiNoiCacKhungGioCotGio" text="Ca trống" minWidth="140" prefWidth="210" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v0"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="tblKhongHenTrongHopThoaiNoiCacKhungGioCotNhaSi" text="Nha sĩ" minWidth="160" prefWidth="210" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v1"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="tblKhongHenTrongHopThoaiNoiCacKhungGioCotPhong" text="Phòng" minWidth="80" prefWidth="210" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v2"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap, le-tan-truong-cao">
        <Label text="Lý do khám *" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <TextArea fx:id="txtKhongHenTrongHopThoaiNoiLyDo" text="" wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="le-tan-truong-vung"/>
    </VBox>
    <Button fx:id="btnKhongHenTrongHopThoaiNoiTiepNhan" text="Tiếp nhận" minWidth="-Infinity" styleClass="chinh-nut" disable="true"/>
    <Label text="Chưa có bệnh nhân và lý do khám. Hoàn thành thông tin để tiếp nhận." styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
</VBox>
