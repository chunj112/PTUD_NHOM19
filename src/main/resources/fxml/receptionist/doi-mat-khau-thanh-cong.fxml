<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="matKhauThanhCongXemTruoc" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-ca-nhan.css" styleClass="le-tan-hop-thoai-noi, le-tan-thong-tin-ca-nhan" spacing="16" minWidth="503" prefWidth="503" maxWidth="503" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblHopThoaiTieuDe" text="Đổi mật khẩu" styleClass="le-tan-hop-thoai-noi-tieu-de" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnDong" text="×" minWidth="32" styleClass="le-tan-dong" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" disable="true"/>
    </HBox>
    <Label text="Dùng chung · Quản lý / Lễ tân / Nha sĩ / Y tá" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
    <VBox spacing="16" minWidth="0" alignment="CENTER" minHeight="100">
        <Label text="✓" styleClass="le-tan-thong-tin-ca-nhan-anh-dai-dien" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <Label fx:id="lblMatKhauThanhCong" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thanh-cong" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="le-tan-duong-phan-cach"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnDongMatKhauKetQua" text="Đóng" minWidth="-Infinity" styleClass="chinh-nut" disable="true"/>
    </HBox>
</VBox>
