<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="walkInfound" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-intake.css" styleClass="receptionist-page, receptionist-intake" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="750">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rx-step-bar">
        <Label fx:id="lblWalkInStepPatient" text="—" styleClass="rx-status-info" wrapText="true" minHeight="-Infinity"/>
        <Label text="›" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblWalkInStepSlot" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </HBox>
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="420" styleClass="rx-card" prefWidth="420" maxWidth="420">
            <Label text="Bước 1 · Tìm bệnh nhân" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label text="Kiểm tra hồ sơ trước khi tạo bệnh nhân mới." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
                <Label text="Tìm mã BN / họ tên / SĐT" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtWalkInPatientSearch" text="" styleClass="rx-field-input"/>
            </VBox>
            <Button fx:id="btnSearchWalkInPatient" text="Tìm kiếm" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
            <Label text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <VBox spacing="16" minWidth="0" styleClass="rx-card, rx-selected-card">
                <Label fx:id="lblWalkInSelectedName" text="—" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
                <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                    <Label text="Mã bệnh nhân" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblWalkInSelectedId" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                    <Label text="SĐT" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblWalkInSelectedPhone" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                    <Label text="Tuổi / giới tính" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblWalkInSelectedAge" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <Label text="—" styleClass="rx-status-info" wrapText="true" minHeight="-Infinity"/>
            </VBox>
            <Label fx:id="lblWalkInAllergy" text="—" styleClass="rx-alert, rx-alert-warning" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            <Button fx:id="btnChangeWalkInPatient" text="Chọn bệnh nhân khác" minWidth="-Infinity" styleClass="secondary-button" disable="true"/>
        </VBox>
        <VBox spacing="16" minWidth="0" styleClass="rx-card" HBox.hgrow="ALWAYS">
            <Label text="Bước 2 · Chọn ca và tiếp nhận" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label text="Chọn ca trống của nha sĩ đang làm việc." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field" disable="false">
                    <Label text="Nha sĩ *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <ComboBox fx:id="cboWalkInDentist" maxWidth="Infinity" minWidth="0" styleClass="rx-field-choice" promptText="Chọn nha sĩ">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Chọn nha sĩ"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
                <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field" disable="false">
                    <Label text="Ngày khám *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <DatePicker fx:id="dpWalkInDate" maxWidth="Infinity" minWidth="0" editable="false" styleClass="rx-field-date">
                        <editor text=""/>
                    </DatePicker>
                </VBox>
            </HBox>
            <Label text="Ca trống trong ngày" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="4" minWidth="0" styleClass="rx-card" fx:id="walkInSlot0" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="lblWalkInSlotTime0" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                    <Label text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label text="✓ Đã chọn" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="4" minWidth="0" styleClass="rx-card" fx:id="walkInSlot1" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="lblWalkInSlotTime1" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                    <Label text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label text="Còn trống" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="4" minWidth="0" styleClass="rx-card" fx:id="walkInSlot2" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label fx:id="lblWalkInSlotTime2" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
                    <Label text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <Label text="Còn trống" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </HBox>
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field, rx-field-tall" disable="false">
                <Label text="Lý do khám *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextArea fx:id="txtWalkInReason" text="" wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="rx-field-area"/>
            </VBox>
            <Label fx:id="lblWalkInRule" text="Xác nhận tiếp nhận sẽ tạo phiếu khám và đưa bệnh nhân vào hàng chờ của nha sĩ. Không cần lịch hẹn trước." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btnResetWalkIn" text="Làm mới" minWidth="-Infinity" styleClass="secondary-button" disable="true"/>
                <Button fx:id="btnAdmitWalkIn" text="Tiếp nhận bệnh nhân" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
