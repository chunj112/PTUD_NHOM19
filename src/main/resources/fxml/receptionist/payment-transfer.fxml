<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · cashier · Figma 104:2617.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="transferPaymentForm" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-cashier.css" styleClass="receptionist-modal, receptionist-cashier" spacing="16" minWidth="700" prefWidth="700" maxWidth="700" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Thanh toán chuyển khoản" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="rx-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng"/>
    </HBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Mã hóa đơn / bệnh nhân" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblTransferInvoicePatient" text="HD001 · BN001 · Nguyễn Văn A" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <HBox spacing="24" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="200" prefWidth="200" maxWidth="200" alignment="TOP_CENTER">
            <ImageView fx:id="imgTransferQrDemo" fitWidth="180" fitHeight="180" preserveRatio="true">
                <image>
                    <Image url="@/images/receptionist/transfer-qr-demo.png"/>
                </image>
            </ImageView>
            <Label text="QR minh họa · Không thanh toán" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS">
            <Label text="THÔNG TIN CHUYỂN KHOẢN" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
            <GridPane hgap="12" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="35"/>
                    <ColumnConstraints percentWidth="65"/>
                </columnConstraints>
                <Label text="Ngân hàng" styleClass="rx-caption" wrapText="true" minHeight="-Infinity" GridPane.rowIndex="0"/>
                <Label fx:id="lblTransferBank" text="Vietcombank · Minh họa" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" alignment="CENTER_RIGHT" maxWidth="Infinity"/>
                <Label text="Số tài khoản" styleClass="rx-caption" wrapText="true" minHeight="-Infinity" GridPane.rowIndex="1"/>
                <Label fx:id="lblTransferAccount" text="1234 5678 9000 (mẫu)" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" alignment="CENTER_RIGHT" maxWidth="Infinity"/>
                <Label text="Chủ tài khoản" styleClass="rx-caption" wrapText="true" minHeight="-Infinity" GridPane.rowIndex="2"/>
                <Label fx:id="lblTransferHolder" text="NHA KHOA ABC (mẫu)" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" alignment="CENTER_RIGHT" maxWidth="Infinity"/>
                <Label text="Số tiền" styleClass="rx-caption" wrapText="true" minHeight="-Infinity" GridPane.rowIndex="3"/>
                <Label fx:id="lblTransferAmount" text="800.000 ₫" styleClass="rx-status-info" wrapText="true" minHeight="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" alignment="CENTER_RIGHT" maxWidth="Infinity"/>
                <Label text="Nội dung CK" styleClass="rx-caption" wrapText="true" minHeight="-Infinity" GridPane.rowIndex="4"/>
                <Label fx:id="lblTransferContent" text="HD001" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" alignment="CENTER_RIGHT" maxWidth="Infinity"/>
            </GridPane>
            <Label fx:id="lblTransferInstructions" text="Yêu cầu khách quét mã QR và hoàn tất chuyển khoản." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            <Label fx:id="lblTransferVerification" text="Chỉ xác nhận thanh toán sau khi đã kiểm tra giao dịch trên tài khoản ngân hàng của phòng khám." styleClass="rx-alert, rx-alert-warning" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
        </VBox>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button" cancelButton="true"/>
        <Button fx:id="btnConfirmTransferReceived" text="Xác nhận đã nhận tiền" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
</VBox>
