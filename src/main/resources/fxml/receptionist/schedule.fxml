<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="receptionistSchedule" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-schedule.css" styleClass="receptionist-page, receptionist-schedule" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPageTitle" text="Lịch làm việc" styleClass="rx-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblPageSubtitle" text="Lịch được quản lý phân công · Chỉ xem, không chỉnh sửa ca" styleClass="rx-subtitle" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <StackPane minWidth="0">
        <TabPane fx:id="scheduleTabs" tabClosingPolicy="UNAVAILABLE" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="${scheduleTabs.selectionModel.selectedItem.content.prefHeight + 66}" styleClass="rx-tabs">
            <tabs>
                <Tab fx:id="tabScheduleDay" text="Ngày">
                    <content>
                        <fx:include fx:id="tabScheduleDayContent" source="schedule-day.fxml"/>
                    </content>
                </Tab>
                <Tab fx:id="tabScheduleWeek" text="Tuần">
                    <content>
                        <fx:include fx:id="tabScheduleWeekContent" source="schedule-week.fxml"/>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <ComboBox fx:id="cboScheduleWeek" prefWidth="200" minWidth="200" maxWidth="200" styleClass="rx-filter" StackPane.alignment="TOP_RIGHT" visible="${tabScheduleWeek.selected}" managed="${tabScheduleWeek.selected}" promptText="Chọn thông tin">
            <items>
                <FXCollections fx:factory="observableArrayList"/>
            </items>
        </ComboBox>
    </StackPane>
    <Label fx:id="lblDemoNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
