<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="editPatientForm" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-patients.css" styleClass="receptionist-modal, receptionist-patients" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Sửa thông tin bệnh nhân" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="rx-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" disable="true"/>
    </HBox>
    <Label fx:id="lblEditPatientSummary" text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="rx-divider"/>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Mã bệnh nhân · Không thay đổi" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblEditPatientId" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
            <Label text="Họ tên *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtPatientName" text="" styleClass="rx-field-input"/>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
            <Label text="Ngày sinh *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <DatePicker fx:id="dpPatientBirthDate" maxWidth="Infinity" minWidth="0" editable="false" styleClass="rx-field-date">
                <editor text=""/>
            </DatePicker>
        </VBox>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
            <Label text="Giới tính" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <ComboBox fx:id="cboPatientGender" maxWidth="Infinity" minWidth="0" styleClass="rx-field-choice" promptText="Chọn giới tính">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Nam"/>
                        <String fx:value="Nữ"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
            <Label text="Số điện thoại *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <TextField fx:id="txtPatientPhone" text="" styleClass="rx-field-input"/>
        </VBox>
    </HBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Email" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtPatientEmail" text="" styleClass="rx-field-input"/>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field, rx-field-tall">
        <Label text="Địa chỉ" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextArea fx:id="txtPatientAddress" text="" wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="rx-field-area"/>
    </VBox>
    <Label fx:id="lblEditPatientRule" text="Chỉ sửa thông tin cá nhân. Không thay đổi bệnh án, chẩn đoán hoặc điều trị." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="rx-divider"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button" cancelButton="true" disable="true"/>
        <Button fx:id="btnSavePatient" text="Lưu thay đổi" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
    </HBox>
</VBox>
