<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · profile · Figma 275:2240.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="passwordProcessingPreview" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-profile.css" styleClass="receptionist-modal, receptionist-profile" spacing="16" minWidth="503" prefWidth="503" maxWidth="503" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Đổi mật khẩu" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="rx-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng"/>
    </HBox>
    <Label text="Dùng chung · Quản lý / Lễ tân / Nha sĩ / Y tá" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
    <VBox spacing="2" styleClass="rx-field, rx-field-readonly">
        <Label text="Mật khẩu hiện tại *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <PasswordField fx:id="pwdCurrentPassword" promptText="••••••••" editable="false" styleClass="rx-password-input"/>
    </VBox>
    <VBox spacing="2" styleClass="rx-field, rx-field-readonly">
        <Label text="Mật khẩu mới *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <PasswordField fx:id="pwdNewPassword" promptText="••••••••••" editable="false" styleClass="rx-password-input"/>
    </VBox>
    <VBox spacing="2" styleClass="rx-field, rx-field-readonly">
        <Label text="Xác nhận mật khẩu mới *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <PasswordField fx:id="pwdConfirmPassword" promptText="••••••••••" editable="false" styleClass="rx-password-input"/>
    </VBox>
    <Label fx:id="lblPasswordRequirements" text="Tối thiểu 8 ký tự, gồm chữ và số. Không dùng lại mật khẩu hiện tại." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
    <Label fx:id="lblPasswordProcessing" text="Đang cập nhật mật khẩu. Vui lòng chờ và không gửi yêu cầu lần nữa." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnCancel" text="Hủy" minWidth="-Infinity" styleClass="secondary-button" cancelButton="true" disable="true"/>
        <Button fx:id="btnUpdatePassword" text="Đang xử lý" minWidth="-Infinity" styleClass="primary-button" disable="true" graphicTextGap="8">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/password-processing.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
</VBox>
