<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="patientssearchingPreview" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-patients.css" styleClass="receptionist-page, receptionist-patients" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPageTitle" text="TRA CỨU BỆNH NHÂN" styleClass="rx-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblPageSubtitle" text="Tìm hồ sơ theo mã bệnh nhân, họ tên hoặc số điện thoại" styleClass="rx-subtitle" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="rx-card" prefHeight="506">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
                <Label text="Điều kiện tìm kiếm" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtPatientSearch" text="" styleClass="rx-field-input"/>
            </VBox>
            <Button fx:id="btnSearchPatient" text="Đang tìm…" minWidth="-Infinity" styleClass="primary-button" disable="true" graphicTextGap="8">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                        <image>
                            <Image url="@/images/receptionist/search-button.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <VBox spacing="16" minWidth="0" alignment="CENTER" minHeight="300" VBox.vgrow="ALWAYS" styleClass="rx-search-center">
            <StackPane minWidth="64" prefWidth="64" maxWidth="64" minHeight="64" prefHeight="64" maxHeight="64" styleClass="rx-empty-circle">
                <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/searching.png"/>
                    </image>
                </ImageView>
            </StackPane>
            <Label fx:id="lblPatientSearchStateTitle" text="Chức năng đang phát triển" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity" alignment="CENTER" textAlignment="CENTER" maxWidth="600"/>
            <Label fx:id="lblPatientSearchStateMessage" text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity" alignment="CENTER" textAlignment="CENTER" maxWidth="620"/>
        </VBox>
        <Label fx:id="lblPatientLookupPrivacy" text="—" styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    </VBox>
    <Label fx:id="lblDemoNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
