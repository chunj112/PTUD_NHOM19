<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · intake · Figma 40:6121.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="walkInModal" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-intake.css" styleClass="receptionist-modal, receptionist-intake" spacing="16" minWidth="680" prefWidth="680" maxWidth="680" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Tiếp nhận khách không hẹn" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="" minWidth="32" styleClass="rx-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" graphicTextGap="8">
            <graphic>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/close-circle.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    <Label text="○ Hôm nay     ○ Lịch tuần     ● Khách không hẹn" styleClass="rx-status-info" wrapText="true" minHeight="-Infinity"/>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Tìm mã BN / họ tên / SĐT *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextField fx:id="txtWalkInModalSearch" text="0988 765 432" styleClass="rx-field-input"/>
    </VBox>
    <Label fx:id="lblWalkInModalNotFound" text="Không tìm thấy hồ sơ phù hợp. Chỉ tạo hồ sơ mới sau khi kiểm tra lại mã, họ tên hoặc SĐT." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Button fx:id="btnWalkInModalCreatePatient" text="Tạo hồ sơ bệnh nhân" minWidth="-Infinity" styleClass="secondary-button" graphicTextGap="8">
        <graphic>
            <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                <image>
                    <Image url="@/images/staff/add-staff.png"/>
                </image>
            </ImageView>
        </graphic>
    </Button>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
        <Label text="Nha sĩ đang có ca" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <ComboBox fx:id="cboWalkInModalDentist" value="Trần Minh Đức · P01" maxWidth="Infinity" minWidth="0" styleClass="rx-field-choice">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Trần Minh Đức · P01"/>
                    <String fx:value="Nguyễn Lan Anh · P02"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    <VBox styleClass="rx-table-frame">
        <TableView fx:id="tblWalkInModalSlots" editable="false" fixedCellSize="72" minHeight="188" prefHeight="188" maxHeight="188" styleClass="rx-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Chưa có dữ liệu" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="tblWalkInModalSlotsColTime" text="Ca trống" minWidth="140" prefWidth="210" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v0"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="tblWalkInModalSlotsColDentist" text="Nha sĩ" minWidth="160" prefWidth="210" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v1"/>
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="tblWalkInModalSlotsColRoom" text="Phòng" minWidth="80" prefWidth="210" sortable="false" reorderable="false">
                    <cellValueFactory>
                        <MapValueFactory key="v2"/>
                    </cellValueFactory>
                </TableColumn>
            </columns>
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <HashMap v0="11:30–12:00" v1="Trần Minh Đức" v2="P01"/>
                    <HashMap v0="14:00–14:30" v1="Nguyễn Lan Anh" v2="P02"/>
                </FXCollections>
            </items>
        </TableView>
    </VBox>
    <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field, rx-field-tall">
        <Label text="Lý do khám *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <TextArea fx:id="txtWalkInModalReason" text="" wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="rx-field-area"/>
    </VBox>
    <Button fx:id="btnWalkInModalAdmit" text="Tiếp nhận" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
    <Label text="Chưa có bệnh nhân và lý do khám. Hoàn thành thông tin để tiếp nhận." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
