<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="leTanLichLamViecChiTiet" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-lich-lam-viec.css" styleClass="le-tan-trang, le-tan-lich-lam-viec" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity">
    <VBox spacing="16" minWidth="0" styleClass="le-tan-the">
        <Label fx:id="lblLichLamViecChiTietTieuDe" text="Chi tiết ca" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblLichLamViecTinhTrang" text="—" styleClass="le-tan-ca-tinh-trang" wrapText="true" minHeight="-Infinity"/>
        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
            <Label text="Nhân viên" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblLeTanNhanVien" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
            <Label text="Ngày / ca" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblLeTanCa" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
            <Label text="Thời gian / phòng" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblLeTanGioPhong" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
            <Label text="Công việc" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblLeTanCongViec" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="le-tan-duong-phan-cach"/>
    </VBox>
</VBox>
