<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="walkIninitial" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-intake.css" styleClass="receptionist-page, receptionist-intake" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="610">
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rx-step-bar">
        <Label fx:id="lblWalkInStepPatient" text="—" styleClass="rx-status-info" wrapText="true" minHeight="-Infinity"/>
        <Label text="›" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblWalkInStepSlot" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </HBox>
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="420" styleClass="rx-card" prefWidth="420" maxWidth="420">
            <Label text="Bước 1 · Tìm bệnh nhân" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label text="Kiểm tra hồ sơ trước khi tạo bệnh nhân mới." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
                <Label text="Tìm mã BN / họ tên / SĐT" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtWalkInPatientSearch" text="" styleClass="rx-field-input"/>
            </VBox>
            <Button fx:id="btnSearchWalkInPatient" text="Tìm kiếm" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
            <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="rx-divider"/>
            <Label text="Tìm hồ sơ để bắt đầu" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label text="Nhập mã bệnh nhân, họ tên hoặc số điện thoại rồi chọn Tìm kiếm. Không tải danh sách bệnh nhân mặc định." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox spacing="16" minWidth="0" styleClass="rx-card" HBox.hgrow="ALWAYS">
            <Label text="Bước 2 · Chọn ca và tiếp nhận" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label text="Tìm và chọn bệnh nhân ở bước 1 để tiếp tục." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field" disable="true">
                    <Label text="Nha sĩ *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <ComboBox fx:id="cboWalkInDentist" maxWidth="Infinity" minWidth="0" styleClass="rx-field-choice" promptText="Chọn nha sĩ">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Chọn nha sĩ"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>
                <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field" disable="true">
                    <Label text="Ngày khám *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                    <DatePicker fx:id="dpWalkInDate" maxWidth="Infinity" minWidth="0" editable="false" styleClass="rx-field-date">
                        <editor text=""/>
                    </DatePicker>
                </VBox>
            </HBox>
            <Label fx:id="lblWalkInSlotHint" text="Chưa chọn bệnh nhân. Các ca khả dụng sẽ được hiển thị sau khi hoàn thành bước 1." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field, rx-field-tall" disable="true">
                <Label text="Lý do khám *" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextArea fx:id="txtWalkInReason" text="" wrapText="true" prefRowCount="3" minHeight="0" VBox.vgrow="ALWAYS" styleClass="rx-field-area"/>
            </VBox>
            <Label fx:id="lblWalkInRule" text="Xác nhận tiếp nhận sẽ tạo phiếu khám và đưa bệnh nhân vào hàng chờ của nha sĩ. Không cần lịch hẹn trước." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btnResetWalkIn" text="Làm mới" minWidth="-Infinity" styleClass="secondary-button" disable="true"/>
                <Button fx:id="btnAdmitWalkIn" text="Tiếp nhận bệnh nhân" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
