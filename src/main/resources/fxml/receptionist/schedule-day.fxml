<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="receptionistScheduleDay" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-schedule.css" styleClass="receptionist-page, receptionist-schedule" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity" prefHeight="570">
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="20" minWidth="0" HBox.hgrow="ALWAYS">
            <VBox spacing="16" minWidth="0" styleClass="rx-card">
                <Label fx:id="lblScheduleDayTitle" text="Lịch trong ngày" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
                <VBox styleClass="rx-table-frame">
                    <TableView fx:id="tblDailyShifts" editable="false" fixedCellSize="72" minHeight="116" prefHeight="116" maxHeight="116" styleClass="rx-table, rx-readonly-table">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="empty-data-note"/>
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="tblDailyShiftsColTime" text="Giờ" minWidth="100" prefWidth="140" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v0"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblDailyShiftsColRoom" text="Phòng" minWidth="80" prefWidth="100" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v1"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblDailyShiftsColWork" text="Công việc" minWidth="160" prefWidth="280" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v2"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="tblDailyShiftsColStatus" text="Trạng thái" minWidth="130" prefWidth="160" sortable="false" reorderable="false">
                                <cellValueFactory>
                                    <MapValueFactory key="v3"/>
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rx-table-footer">
                        <Label fx:id="tblDailyShiftsCount" text="Chưa tải dữ liệu" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="tblDailyShiftsPrevious" text="‹" minWidth="-Infinity" styleClass="rx-page-button" disable="true"/>
                        <Label fx:id="tblDailyShiftsPage" text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                        <Button fx:id="tblDailyShiftsNext" text="›" minWidth="-Infinity" styleClass="rx-page-button" disable="true"/>
                    </HBox>
                </VBox>
                <Label fx:id="lblScheduleDayNotice" text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
            </VBox>
            <fx:include fx:id="upcomingSchedule" source="schedule-upcoming.fxml"/>
        </VBox>
        <VBox spacing="16" minWidth="300" prefWidth="300" maxWidth="300">
            <fx:include fx:id="selectedScheduleDetail" source="schedule-detail.fxml"/>
        </VBox>
    </HBox>
</VBox>
