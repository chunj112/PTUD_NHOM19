<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="tiepNhanBieuMau" fx:controller="iuh.se.nhom19.view.receptionist.TiepNhanCoHenController" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-tiep-nhan.css" styleClass="khung-ung-dung, le-tan-hop-thoai-noi, luong-tiep-nhan, hop-thoai-co-cuon-noi" minWidth="760" prefWidth="820" maxWidth="900" prefHeight="650">
    <top><VBox spacing="4" styleClass="hop-thoai-tieu-de-khu-vuc"><Label text="Tiếp nhận bệnh nhân" styleClass="le-tan-hop-thoai-noi-tieu-de"/><Label text="Xác minh hồ sơ và đưa bệnh nhân vào hàng chờ khám" styleClass="le-tan-chu-thich"/></VBox></top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="khung-ung-dung-cuon">
            <content><VBox spacing="14" styleClass="hop-thoai-noi-dung">
                <VBox spacing="8" styleClass="le-tan-the">
                    <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Thông tin lịch hẹn" styleClass="le-tan-the-tieu-de"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblTrangThaiLichHen" text=""/></HBox>
                    <Label fx:id="lblTomTatLichHen" text="" wrapText="true" styleClass="le-tan-chi-tiet-gia-tri"/>
                    <Label fx:id="lblCaLichHen" text="" wrapText="true" styleClass="le-tan-chu-thich"/>
                </VBox>
                <VBox spacing="8" styleClass="le-tan-the">
                    <Label text="Thông tin bệnh nhân" styleClass="le-tan-the-tieu-de"/>
                    <fx:include fx:id="chonBenhNhan" source="them-benh-nhan.fxml"/>
                </VBox>
                <Label fx:id="lblTiepNhanKetQua" text="" wrapText="true"/>
            </VBox></content>
        </ScrollPane>
    </center>
    <bottom><HBox spacing="10" alignment="CENTER_RIGHT" styleClass="hop-thoai-chan"><Button fx:id="btnHuy" text="Hủy" cancelButton="true" styleClass="phu-nut" disable="true"/><Button fx:id="btnXacNhanTiepNhan" text="Xác nhận tiếp nhận" styleClass="chinh-nut" disable="true"/></HBox></bottom>
</BorderPane>
