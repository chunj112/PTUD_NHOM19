<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="themLichHenBieuMau" fx:controller="iuh.se.nhom19.view.receptionist.DatLichHenController" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-tiep-nhan.css" styleClass="khung-ung-dung, le-tan-hop-thoai-noi, luong-tiep-nhan, hop-thoai-dat-lich" minWidth="850" prefWidth="900" maxWidth="940" prefHeight="670">
    <top>
        <VBox spacing="4" styleClass="hop-thoai-tieu-de-khu-vuc">
            <Label fx:id="lblHopThoaiTieuDe" text="Đặt lịch hẹn khám" styleClass="le-tan-hop-thoai-noi-tieu-de"/>
            <Label text="Ghi nhận lịch dự kiến · Chưa tạo hồ sơ hoặc phiếu khám" styleClass="le-tan-chu-thich"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="khung-ung-dung-cuon">
            <content>
                <VBox spacing="16" styleClass="hop-thoai-dat-lich-noi-dung">
                    <VBox spacing="10" styleClass="le-tan-the">
                        <Label text="1. Thông tin khách hàng" styleClass="le-tan-the-tieu-de"/>
                        <HBox spacing="12">
                            <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS">
                                <HBox spacing="3"><Label text="Họ và tên"/><Label text="*" styleClass="dau-bat-buoc"/></HBox>
                                <TextField fx:id="txtHoTenNguoiHen" promptText="Nhập họ và tên"/>
                                <Label fx:id="lblLoiHoTen" text="" wrapText="true" minHeight="28" prefHeight="28" styleClass="loi-truong"/>
                            </VBox>
                            <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS">
                                <HBox spacing="3"><Label text="Số điện thoại"/><Label text="*" styleClass="dau-bat-buoc"/></HBox>
                                <TextField fx:id="txtSoDienThoaiLienHe" promptText="Nhập số điện thoại bệnh nhân"/>
                                <Label fx:id="lblLoiSDT" text="" wrapText="true" minHeight="28" prefHeight="28" styleClass="loi-truong"/>
                            </VBox>
                        </HBox>
                        <VBox spacing="6" styleClass="tra-cuu-goi-y">
                            <HBox alignment="CENTER_LEFT" spacing="8"><Label text="Hồ sơ theo số điện thoại" styleClass="le-tan-chu-thich"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="btnBoLienKet" text="Bỏ liên kết" styleClass="nut-nho" disable="true"/></HBox>
                            <ListView fx:id="lstLichHenBenhNhanGoiY" prefHeight="52" maxHeight="120" styleClass="ket-qua-goi-y"/>
                            <Label fx:id="lblNguoiHenDaChon" text="Chưa liên kết hồ sơ. Có thể đặt lịch chỉ với họ tên và SĐT." wrapText="true" styleClass="le-tan-chu-thich"/>
                        </VBox>
                    </VBox>
                    <VBox spacing="10" styleClass="le-tan-the">
                        <Label text="2. Thông tin lịch hẹn" styleClass="le-tan-the-tieu-de"/>
                        <GridPane hgap="12" maxWidth="Infinity" styleClass="lich-hen-luoi-chon">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33.333" minWidth="0" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33.334" minWidth="0" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <VBox spacing="5" minWidth="0" GridPane.columnIndex="0">
                                <HBox spacing="3"><Label text="Ngày hẹn"/><Label text="*" styleClass="dau-bat-buoc"/></HBox>
                                <DatePicker fx:id="dpLichHenNgay" editable="false" minWidth="0" prefWidth="200" maxWidth="Infinity"/>
                                <Label fx:id="lblLoiNgay" text="" wrapText="true" minHeight="28" prefHeight="28" styleClass="loi-truong"/>
                            </VBox>
                            <VBox spacing="5" minWidth="0" GridPane.columnIndex="1">
                                <HBox spacing="3"><Label text="Nha sĩ"/><Label text="*" styleClass="dau-bat-buoc"/></HBox>
                                <ComboBox fx:id="cboLichHenNhaSi" promptText="Chọn nha sĩ có phân công" minWidth="0" prefWidth="200" maxWidth="Infinity"/>
                                <Label fx:id="lblLoiNhaSi" text="" wrapText="true" minHeight="28" prefHeight="28" styleClass="loi-truong"/>
                            </VBox>
                            <VBox spacing="5" minWidth="0" GridPane.columnIndex="2">
                                <HBox spacing="3"><Label text="Ca làm việc"/><Label text="*" styleClass="dau-bat-buoc"/></HBox>
                                <ComboBox fx:id="cboCaLam" promptText="Chọn ca" minWidth="0" prefWidth="200" maxWidth="Infinity"/>
                                <Label fx:id="lblLoiCaLam" text="" wrapText="true" minHeight="28" prefHeight="28" styleClass="loi-truong"/>
                            </VBox>
                        </GridPane>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS">
                                <HBox spacing="3"><Label text="Giờ bắt đầu · HH:mm"/><Label text="*" styleClass="dau-bat-buoc"/></HBox>
                                <TextField fx:id="txtGioHen" promptText="Ví dụ 08:30"/>
                                <Label fx:id="lblLoiGio" text="" wrapText="true" minHeight="28" prefHeight="28" styleClass="loi-truong"/>
                            </VBox>
                            <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Khoảng giờ dự kiến"/><Label fx:id="lblKhungGioDuKien" text="Nhập giờ bắt đầu theo HH:mm" styleClass="khung-gio-du-kien" minHeight="38" prefHeight="38" maxHeight="38" maxWidth="Infinity"/></VBox>
                        </HBox>
                        <HBox spacing="12">
                            <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Lý do khám"/><TextField fx:id="txtLichHenLyDo" promptText="Ví dụ: Đau răng, khám định kỳ"/></VBox>
                        </HBox>
                    </VBox>
                    <Label fx:id="lblLichHenBieuMauQuyTac" text="Mỗi cuộc hẹn giữ 45 phút. Thời gian được xác minh lại khi lưu." wrapText="true" minHeight="44" prefHeight="44" styleClass="le-tan-chu-thich"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="hop-thoai-chan">
            <Button fx:id="btnHuy" text="Hủy" styleClass="phu-nut" cancelButton="true" disable="true"/>
            <Button fx:id="btnLuuLichHen" text="Kiểm tra &amp; đặt lịch" styleClass="chinh-nut" disable="true"/>
        </HBox>
    </bottom>
</BorderPane>
