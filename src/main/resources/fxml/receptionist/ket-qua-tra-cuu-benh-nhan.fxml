<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="benhNhanCoKetQuaXemTruoc" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-benh-nhan.css" styleClass="le-tan-trang, le-tan-danh-sach-benh-nhan" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTrangTieuDe" text="TRA CỨU BỆNH NHÂN" styleClass="le-tan-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblTrangPhuDe" text="Tìm hồ sơ bệnh nhân bằng số điện thoại" styleClass="le-tan-phu-de" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="le-tan-the" prefHeight="580">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
                <Label text="Điều kiện tìm kiếm" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtBenhNhanTimKiem" text="" styleClass="le-tan-truong-nhap"/>
            </VBox>
            <Button fx:id="btnTimKiemBenhNhan" text="Tìm kiếm" minWidth="-Infinity" styleClass="chinh-nut" disable="true" graphicTextGap="8">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                        <image>
                            <Image url="@/images/receptionist/search-button.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Label text="Kết quả tìm kiếm" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
        <Label text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <VBox styleClass="le-tan-bang-vien">
            <TableView fx:id="tblBenhNhanCacKetQua" editable="false" fixedCellSize="72" minHeight="260" prefHeight="260" maxHeight="260" styleClass="le-tan-bang">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="tblBenhNhanCacKetQuaCotMa" text="Mã BN" minWidth="90" prefWidth="120" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v0"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanCacKetQuaCotTen" text="Họ tên" minWidth="150" prefWidth="200" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v1"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanCacKetQuaCotSinhNgay" text="Ngày sinh" minWidth="120" prefWidth="170" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v2"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanCacKetQuaCotSoDienThoai" text="SĐT" minWidth="140" prefWidth="170" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v3"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanCacKetQuaCotGioiTinh" text="Giới tính" minWidth="90" prefWidth="130" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v4"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblBenhNhanCacKetQuaCotCuoiLuotKham" text="Lần khám gần nhất" minWidth="160" prefWidth="190" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v5"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="le-tan-bang-chan">
                <Label fx:id="tblBenhNhanCacKetQuaSoLuong" text="Chưa tải dữ liệu" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="tblBenhNhanCacKetQuaTruoc" text="‹" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                <Label fx:id="tblBenhNhanCacKetQuaTrang" text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Button fx:id="tblBenhNhanCacKetQuaTiep" text="›" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
            </HBox>
        </VBox>
        <Label text="Chưa chọn bệnh nhân. Dòng dưới con trỏ được tô nhẹ; không tự chọn bản ghi đầu tiên." styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblBenhNhanTraCuuBaoMat" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thong-tin-ngan" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    </VBox>
</VBox>
