<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="receptionistProfileDrawer" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-profile.css" styleClass="receptionist-modal, receptionist-profile" spacing="16" minWidth="503" prefWidth="503" maxWidth="503" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Hồ sơ cá nhân" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="rx-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng" disable="true"/>
    </HBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="TH" styleClass="rx-profile-avatar" wrapText="true" minHeight="-Infinity"/>
        <VBox spacing="4" minWidth="0">
            <Label fx:id="lblProfileName" text="—" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblProfileIdRole" text="—" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="rx-divider"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                <Label text="Họ tên" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblProfileFullName" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                <Label text="Mã NV" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblProfileEmployeeId" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
    </HBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Chức vụ" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblProfileRole" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Số điện thoại" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblProfilePhone" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Email" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblProfileEmail" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                <Label text="Ngày sinh" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblProfileBirthDate" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
        <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
            <VBox spacing="4" minWidth="0" styleClass="rx-detail">
                <Label text="Giới tính" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <Label fx:id="lblProfileGender" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
            </VBox>
        </VBox>
    </HBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Địa chỉ" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblProfileAddress" text="—" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Trạng thái tài khoản" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblProfileAccountStatus" text="—" styleClass="rx-detail-value, rx-profile-active" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <Label fx:id="lblProfileReadonly" text="—" styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="rx-divider"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnEditPersonalProfile" text="Chỉnh sửa hồ sơ" minWidth="-Infinity" styleClass="primary-button" disable="true"/>
        <Button fx:id="btnChangePassword" text="Đổi mật khẩu" minWidth="-Infinity" styleClass="secondary-button" disable="true"/>
    </HBox>
    <Label text="Chức năng đang phát triển · Chưa tải dữ liệu từ hệ thống." styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
