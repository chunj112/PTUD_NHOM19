<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="chuyenKhoanThanhCongXemTruoc" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-thu-ngan.css" styleClass="le-tan-hop-thoai-noi, le-tan-thu-ngan, le-tan-trang-thai-the" spacing="16" minWidth="640" prefWidth="640" maxWidth="640" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label text="✓" styleClass="le-tan-thanh-cong-dau" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblHopThoaiTieuDe" text="Chức năng đang phát triển" styleClass="le-tan-hop-thoai-noi-tieu-de" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
    <Label fx:id="lblChuyenKhoanThanhCongThongBao" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thanh-cong" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Mã hóa đơn" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblChuyenKhoanThanhCongHoaDon" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Số tiền" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblChuyenKhoanThanhCongSoTien" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Phương thức" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblChuyenKhoanThanhCongPhuongThuc" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Thời gian thanh toán" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblChuyenKhoanThanhCongGio" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
        <Label text="Nhân viên xác nhận" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblChuyenKhoanThanhCongNhanVien" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnHoanThanhChuyenKhoan" text="Hoàn tất" minWidth="-Infinity" styleClass="chinh-nut" disable="true"/>
    </HBox>
</VBox>
