<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="leTanDanhSachBenhNhan" fx:controller="iuh.se.nhom19.view.receptionist.TraCuuBenhNhanController" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-benh-nhan.css" styleClass="le-tan-trang, le-tan-danh-sach-benh-nhan" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblTrangTieuDe" text="Tra cứu bệnh nhân" styleClass="le-tan-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblTrangPhuDe" text="Tìm hồ sơ bệnh nhân bằng số điện thoại" styleClass="le-tan-phu-de" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="le-tan-the" prefHeight="612">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="truong-nhap">
                <Label text="Nhập số điện thoại bệnh nhân" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtBenhNhanTimKiem" text="" styleClass="le-tan-truong-nhap"/>
            </VBox>
            <Button fx:id="btnTimKiemBenhNhan" text="Tìm kiếm" minWidth="-Infinity" styleClass="chinh-nut" disable="true" graphicTextGap="8">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                        <image>
                            <Image url="@/images/receptionist/search-button.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <TableView fx:id="tblTraCuuBenhNhan" editable="false" prefHeight="380" fixedCellSize="60" styleClass="le-tan-bang">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
            <columns><TableColumn fx:id="cotTraCuuMa" text="Mã BN" prefWidth="190"/><TableColumn fx:id="cotTraCuuTen" text="Họ tên" prefWidth="300"/><TableColumn fx:id="cotTraCuuSDT" text="SĐT" prefWidth="190"/><TableColumn fx:id="cotTraCuuNgaySinh" text="Ngày sinh" prefWidth="150"/></columns>
        </TableView>
        <Label fx:id="lblChiTietTraCuu" text="" wrapText="true"/>
        <Label fx:id="lblBenhNhanTraCuuBaoMat" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thong-tin-ngan" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    </VBox>
</VBox>
