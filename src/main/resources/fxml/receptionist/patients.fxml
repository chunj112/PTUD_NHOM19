<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · patients · Figma 15:1186.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="receptionistPatients" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-patients.css" styleClass="receptionist-page, receptionist-patients" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPageTitle" text="Tra cứu bệnh nhân" styleClass="rx-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblPageSubtitle" text="Tìm hồ sơ theo mã bệnh nhân, họ tên hoặc số điện thoại" styleClass="rx-subtitle" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="rx-card" prefHeight="612">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
                <Label text="Điều kiện tìm kiếm" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtPatientSearch" text="" styleClass="rx-field-input"/>
            </VBox>
            <Button fx:id="btnSearchPatient" text="Tìm kiếm" minWidth="-Infinity" styleClass="primary-button" disable="true" graphicTextGap="8">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                        <image>
                            <Image url="@/images/receptionist/search-button.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <VBox spacing="16" minWidth="0" alignment="CENTER" minHeight="380" VBox.vgrow="ALWAYS" styleClass="rx-search-center">
            <StackPane minWidth="72" prefWidth="72" maxWidth="72" minHeight="72" prefHeight="72" maxHeight="72" styleClass="rx-empty-circle">
                <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/search-state.png"/>
                    </image>
                </ImageView>
            </StackPane>
            <Label fx:id="lblPatientSearchStateTitle" text="Tìm bệnh nhân để xem hồ sơ" styleClass="rx-card-title" wrapText="true" minHeight="-Infinity" alignment="CENTER" textAlignment="CENTER" maxWidth="600"/>
            <Label fx:id="lblPatientSearchStateMessage" text="Nhập ít nhất một điều kiện tìm kiếm. Danh sách bệnh nhân không được tải mặc định." styleClass="rx-caption" wrapText="true" minHeight="-Infinity" alignment="CENTER" textAlignment="CENTER" maxWidth="620"/>
            <Label text="Ví dụ: BN001 · Nguyễn Văn A · 0912 345 678" styleClass="rx-caption" wrapText="true" minHeight="-Infinity" alignment="CENTER" textAlignment="CENTER" maxWidth="620"/>
        </VBox>
        <Label fx:id="lblPatientLookupPrivacy" text="Lễ tân chỉ xem thông tin phục vụ tiếp nhận và thu ngân. Nội dung bệnh án nhạy cảm được giới hạn theo quyền." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    </VBox>
    <Label fx:id="lblDemoNotice" text="DỮ LIỆU MINH HỌA · Không kết nối SQL Server · 09/10/2026" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
