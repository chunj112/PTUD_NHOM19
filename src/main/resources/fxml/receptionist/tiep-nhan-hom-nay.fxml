<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Controller chỉ hiển thị dữ liệu đã đọc/lưu bằng SQL Server. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="iuh.se.nhom19.view.receptionist.LichHenNgayController" fx:id="tiepNhanHomNay" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-tiep-nhan.css" styleClass="le-tan-trang, le-tan-tiep-nhan" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity">
    <Label fx:id="lblKetQuaTiepNhanNgay" text="" wrapText="true"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtLichHenTimKiem" promptText="Nhập số điện thoại bệnh nhân" minWidth="0" HBox.hgrow="ALWAYS" styleClass="le-tan-tim-kiem"/>
        <DatePicker fx:id="dpLichHenNgayLam" prefWidth="190" minWidth="190" maxWidth="190" editable="false" styleClass="le-tan-bo-loc">
            <editor text=""/>
        </DatePicker>
        <ComboBox fx:id="cboLichHenNhaSi" prefWidth="230" minWidth="230" maxWidth="230" styleClass="le-tan-bo-loc" promptText="Tất cả nha sĩ" value="Tất cả nha sĩ">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả nha sĩ"/>
                </FXCollections>
            </items>
        </ComboBox>
        <Button fx:id="btnLamMoiLichHenNgay" text="Làm mới" styleClass="phu-nut" disable="true"/>
    </HBox>
    <Label fx:id="lblTrangThaiLichHenNgay" text="" wrapText="true"/>
    <HBox spacing="20" alignment="TOP_LEFT">
        <VBox spacing="16" minWidth="0" prefWidth="0" styleClass="le-tan-the" HBox.hgrow="ALWAYS">
            <Label text="Lịch hẹn theo ngày" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity"/>
            <VBox styleClass="le-tan-bang-vien" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <TableView fx:id="tblHomNayDanhSachLichHen" minWidth="0" maxWidth="Infinity" editable="false" fixedCellSize="62" minHeight="320" prefHeight="-1" styleClass="le-tan-bang, le-tan-bang-lich-hen-ngay" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="cotSoDienThoaiNguoiHen" text="SĐT" minWidth="72" prefWidth="90" sortable="false" reorderable="false"/>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotGio" text="Thời gian" minWidth="70" prefWidth="90" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v0"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotBenhNhan" text="Khách hàng" minWidth="80" prefWidth="110" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v1"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotNhaSi" text="Nha sĩ" minWidth="85" prefWidth="110" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v2"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotPhong" text="Phòng" minWidth="55" prefWidth="65" sortable="false" reorderable="false"/>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotLyDo" text="Lý do khám" minWidth="80" prefWidth="125" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v3"/>
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="tblHomNayDanhSachLichHenCotTinhTrang" text="Trạng thái" minWidth="75" prefWidth="105" sortable="false" reorderable="false">
                            <cellValueFactory>
                                <MapValueFactory key="v4"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="le-tan-bang-chan">
                    <Label fx:id="tblHomNayDanhSachLichHenSoLuong" text="Chưa tải dữ liệu" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="tblHomNayDanhSachLichHenTruoc" text="‹" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                    <Label fx:id="tblHomNayDanhSachLichHenTrang" text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Button fx:id="tblHomNayDanhSachLichHenTiep" text="›" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                </HBox>
            </VBox>
        </VBox>
        <!-- Chưa chọn dòng: ẩn và không giữ chỗ panel. Controller nạp đúng lịch hẹn
             rồi bật cả visible/managed; bỏ chọn thì tắt cả hai thuộc tính. -->
        <VBox fx:id="daChonLichHenKhung" spacing="16" minWidth="280" prefWidth="300" maxWidth="300" visible="false" managed="false">
            <fx:include fx:id="daChonLichHenChiTiet" source="chi-tiet-lich-hen.fxml"/>
        </VBox>
    </HBox>
</VBox>
