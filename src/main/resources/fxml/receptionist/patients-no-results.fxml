<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · patients · Figma 59:31058.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="patientsnonePreview" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-patients.css" styleClass="receptionist-page, receptionist-patients" spacing="20" minWidth="1000" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblPageTitle" text="TRA CỨU BỆNH NHÂN" styleClass="rx-title" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblPageSubtitle" text="Tìm hồ sơ theo mã bệnh nhân, họ tên hoặc số điện thoại" styleClass="rx-subtitle" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
    <VBox spacing="16" minWidth="0" styleClass="rx-card" prefHeight="506">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" spacing="2" styleClass="rx-field">
                <Label text="Điều kiện tìm kiếm" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
                <TextField fx:id="txtPatientSearch" text="0900 000 000" styleClass="rx-field-input"/>
            </VBox>
            <Button fx:id="btnSearchPatient" text="Tìm kiếm" minWidth="-Infinity" styleClass="primary-button" disable="false" graphicTextGap="8">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                        <image>
                            <Image url="@/images/receptionist/search-button.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <VBox spacing="16" minWidth="0" alignment="CENTER" minHeight="300" VBox.vgrow="ALWAYS" styleClass="rx-search-center">
            <StackPane minWidth="64" prefWidth="64" maxWidth="64" minHeight="64" prefHeight="64" maxHeight="64" styleClass="rx-empty-circle">
                <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                    <image>
                        <Image url="@/images/receptionist/search-state-small.png"/>
                    </image>
                </ImageView>
            </StackPane>
            <Label fx:id="lblPatientSearchStateTitle" text="Không tìm thấy bệnh nhân phù hợp." styleClass="rx-card-title" wrapText="true" minHeight="-Infinity" alignment="CENTER" textAlignment="CENTER" maxWidth="600"/>
            <Label fx:id="lblPatientSearchStateMessage" text="Kiểm tra mã bệnh nhân, họ tên hoặc số điện thoại và thử lại." styleClass="rx-caption" wrapText="true" minHeight="-Infinity" alignment="CENTER" textAlignment="CENTER" maxWidth="620"/>
        </VBox>
        <Label fx:id="lblPatientLookupPrivacy" text="Lễ tân chỉ xem thông tin phục vụ tiếp nhận và thu ngân. Nội dung lâm sàng chỉ đọc." styleClass="rx-alert, rx-alert-info" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    </VBox>
    <Label fx:id="lblDemoNotice" text="DỮ LIỆU MINH HỌA · Không kết nối SQL Server · 09/10/2026" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
</VBox>
