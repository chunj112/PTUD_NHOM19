<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · cashier · Figma 104:2657.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="confirmTransferForm" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-cashier.css" styleClass="receptionist-modal, receptionist-cashier" spacing="16" minWidth="640" prefWidth="640" maxWidth="640" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Xác nhận đã nhận tiền?" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="rx-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng"/>
    </HBox>
    <Label text="Bạn đã kiểm tra giao dịch ngân hàng và xác nhận phòng khám đã nhận đủ số tiền này?" styleClass="rx-body" wrapText="true" minHeight="-Infinity"/>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Bệnh nhân" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblConfirmTransferPatient" text="BN001 · Nguyễn Văn A" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Mã hóa đơn" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblConfirmTransferInvoice" text="HD001" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Số tiền" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblConfirmTransferAmount" text="800.000 ₫" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <VBox spacing="4" minWidth="0" styleClass="rx-detail">
        <Label text="Phương thức" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
        <Label fx:id="lblConfirmTransferMethod" text="Chuyển khoản" styleClass="rx-detail-value" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <Label fx:id="lblConfirmTransferWarning" text="Thao tác này không thể hoàn tác. Chỉ xác nhận khi đã kiểm tra tài khoản ngân hàng." styleClass="rx-alert, rx-alert-warning" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnBackToTransfer" text="Quay lại" minWidth="-Infinity" styleClass="secondary-button" cancelButton="true"/>
        <Button fx:id="btnConfirmTransferPayment" text="Xác nhận thanh toán" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
</VBox>
