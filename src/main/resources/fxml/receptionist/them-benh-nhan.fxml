<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<!-- Bản nháp chỉ được Service lưu khi xác nhận tiếp nhận thành công. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="themBenhNhanBieuMau"
      fx:controller="iuh.se.nhom19.view.receptionist.ThemBenhNhanController" spacing="10" minWidth="0">
    <HBox spacing="16"><RadioButton fx:id="radHoSoCu" text="Sử dụng hồ sơ đã có"/><RadioButton fx:id="radHoSoMoi" text="Tạo hồ sơ mới"/></HBox>
    <VBox fx:id="vungTimHoSo" spacing="6">
        <HBox spacing="8"><TextField fx:id="txtTimBenhNhan" promptText="Nhập số điện thoại bệnh nhân" HBox.hgrow="ALWAYS"/><Button fx:id="btnTimHoSo" text="Tìm" styleClass="phu-nut" disable="true"/></HBox>
        <ListView fx:id="lstChonBenhNhan" prefHeight="52" maxHeight="150" styleClass="ket-qua-goi-y"/>
        <Label fx:id="lblHoSoDaChon" text="Chưa chọn hồ sơ." wrapText="true"/>
    </VBox>
    <VBox fx:id="vungBenhNhanMoi" spacing="9" visible="false" managed="false">
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Họ tên *"/><TextField fx:id="txtBenhNhanTen" promptText="Nhập họ tên"/><Label fx:id="lblLoiTenBenhNhan" text="" wrapText="true" styleClass="loi-truong"/></VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Số điện thoại *"/><TextField fx:id="txtBenhNhanSoDienThoai" promptText="Nhập số điện thoại"/><Label fx:id="lblLoiSDTBenhNhan" text="" wrapText="true" styleClass="loi-truong"/></VBox>
        </HBox>
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Ngày sinh * · dd/MM/yyyy"/><TextField fx:id="txtBenhNhanSinhNgay" promptText="Ví dụ: 15/08/2005"/><Label fx:id="lblLoiNgaySinh" text="" wrapText="true" styleClass="loi-truong"/></VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0"><Label text="Giới tính *"/><ComboBox fx:id="cboBenhNhanGioiTinh" promptText="Chọn giới tính" maxWidth="Infinity"><items><FXCollections fx:factory="observableArrayList"><String fx:value="Nữ"/><String fx:value="Nam"/></FXCollections></items></ComboBox><Label fx:id="lblLoiGioiTinh" text="" wrapText="true" styleClass="loi-truong"/></VBox>
        </HBox>
        <VBox spacing="4"><Label text="Địa chỉ (nếu có)"/><TextField fx:id="txtBenhNhanDiaChi" promptText="Nhập địa chỉ nếu có"/><Label fx:id="lblLoiDiaChi" text="" wrapText="true" styleClass="loi-truong"/></VBox>
        <Label text="Ngày sinh phải là ngày hợp lệ, từ 01/01/1900 đến hôm nay." wrapText="true" styleClass="le-tan-chu-thich"/>
    </VBox>
    <Label fx:id="lblThongBaoHoSo" text="" wrapText="true"/>
</VBox>
