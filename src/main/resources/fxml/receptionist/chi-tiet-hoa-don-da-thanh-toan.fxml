<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- Dữ liệu ban đầu chưa tải; Controller chỉ điền thông tin sau khi đọc backend thật. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="hoaDonDaThanhToanPhanChiTiet" stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/le-tan-thu-ngan.css" styleClass="le-tan-trang, le-tan-thu-ngan" spacing="20" minWidth="0" minHeight="-Infinity" maxHeight="-Infinity">
    <VBox spacing="16" minWidth="0" styleClass="le-tan-the">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="lblHoaDonChiTietTieuDe" text="Chi tiết hóa đơn" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="lblHoaDonChiTietTinhTrang" text="—" styleClass="le-tan-tinh-trang-thanh-cong" wrapText="true" minHeight="-Infinity"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                    <Label text="Bệnh nhân" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblHoaDonBenhNhan" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                    <Label text="Phiếu khám / nha sĩ" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblHoaDonPhieuKhamNhaSi" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
        </HBox>
        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
            <Label text="Ngày lập hóa đơn" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblHoaDonDaTao" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="le-tan-duong-phan-cach"/>
        <Label text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        <VBox styleClass="le-tan-bang-vien">
            <TableView fx:id="tblHoaDonDanhMucDichVu" editable="false" fixedCellSize="72" minHeight="188" prefHeight="188" maxHeight="188" styleClass="le-tan-bang, le-tan-chi-doc-bang">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Chưa tải dữ liệu · Chức năng đang phát triển" wrapText="true" styleClass="trong-du-lieu-ghi-chu"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="tblHoaDonDanhMucDichVuCotDichVu" text="Tên dịch vụ" minWidth="150" prefWidth="250" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v0"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblHoaDonDanhMucDichVuCotChucVu" text="Vị trí" minWidth="80" prefWidth="110" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v1"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblHoaDonDanhMucDichVuCotSoLuong" text="SL" minWidth="45" prefWidth="60" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v2"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblHoaDonDanhMucDichVuCotDonGia" text="Đơn giá" minWidth="100" prefWidth="130" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v3"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="tblHoaDonDanhMucDichVuCotSoTien" text="Thành tiền" minWidth="110" prefWidth="150" sortable="false" reorderable="false">
                        <cellValueFactory>
                            <MapValueFactory key="v4"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="le-tan-bang-chan">
                <Label fx:id="tblHoaDonDanhMucDichVuSoLuong" text="Chưa tải dữ liệu" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="tblHoaDonDanhMucDichVuTruoc" text="‹" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
                <Label fx:id="tblHoaDonDanhMucDichVuTrang" text="—" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                <Button fx:id="tblHoaDonDanhMucDichVuTiep" text="›" minWidth="-Infinity" styleClass="le-tan-trang-nut" disable="true"/>
            </HBox>
        </VBox>
        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
            <Label text="Tổng dịch vụ" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblHoaDonDichVuTong" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="le-tan-duong-phan-cach"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Tổng đã thanh toán" styleClass="le-tan-the-tieu-de" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="lblHoaDonSoTien" text="—" styleClass="le-tan-tong" wrapText="true" minHeight="-Infinity"/>
        </HBox>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                    <Label text="Phương thức" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblHoaDonDaThanhToanPhuongThuc" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
            <VBox spacing="16" minWidth="0" HBox.hgrow="ALWAYS" prefWidth="0">
                <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
                    <Label text="Thời gian thanh toán" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblHoaDonDaThanhToanTai" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </VBox>
        </HBox>
        <VBox spacing="4" minWidth="0" styleClass="le-tan-chi-tiet">
            <Label text="Nhân viên xác nhận" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="lblHoaDonDaXacNhanTheo" text="—" styleClass="le-tan-chi-tiet-gia-tri" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <Label fx:id="lblHoaDonDaThanhToanBuocXacNhan" text="—" styleClass="le-tan-canh-bao, le-tan-canh-bao-thanh-cong" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Hóa đơn đã hoàn tất · Chỉ đọc" styleClass="le-tan-chu-thich" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnInHoaDon" text="In hóa đơn" minWidth="-Infinity" styleClass="phu-nut" disable="true"/>
        </HBox>
    </VBox>
</VBox>
