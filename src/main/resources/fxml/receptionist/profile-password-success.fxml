<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import java.util.HashMap?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.MapValueFactory?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<!-- RECEPTIONIST · profile · Figma 275:2226.
     Chỉ FXML/CSS, không Controller/SQL hoặc thao tác lưu/thanh toán thật.
     Mọi tên, ngày, số tiền là mẫu Figma; file trạng thái chỉ dùng preview.
     DatePicker.editor chỉ là text xem trước; Controller tự gán LocalDate/converter.
     Không fx:controller hoặc onAction trỏ Java chưa tồn tại. -->
<VBox fx:id="passwordSuccessPreview" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@/css/theme.css, @/css/receptionist-common.css, @/css/receptionist-profile.css" styleClass="receptionist-modal, receptionist-profile" spacing="16" minWidth="503" prefWidth="503" maxWidth="503" minHeight="-Infinity" maxHeight="-Infinity">
    <HBox spacing="12" alignment="CENTER_LEFT" minHeight="32">
        <Label fx:id="lblDialogTitle" text="Đổi mật khẩu" styleClass="rx-modal-title" wrapText="true" minHeight="-Infinity" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button fx:id="btnClose" text="×" minWidth="32" styleClass="rx-close" prefWidth="32" maxWidth="32" minHeight="32" prefHeight="32" maxHeight="32" accessibleText="Đóng"/>
    </HBox>
    <Label text="Dùng chung · Quản lý / Lễ tân / Nha sĩ / Y tá" styleClass="rx-caption" wrapText="true" minHeight="-Infinity"/>
    <VBox spacing="16" minWidth="0" alignment="CENTER" minHeight="100">
        <Label text="✓" styleClass="rx-profile-avatar" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <Label fx:id="lblPasswordSuccess" text="Đổi mật khẩu thành công. Mật khẩu mới sẽ được dùng cho lần đăng nhập tiếp theo." styleClass="rx-alert, rx-alert-success" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
    <Region minHeight="1" prefHeight="1" maxHeight="1" styleClass="rx-divider"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnClosePasswordResult" text="Đóng" minWidth="-Infinity" styleClass="primary-button"/>
    </HBox>
</VBox>
