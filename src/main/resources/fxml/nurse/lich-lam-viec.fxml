<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="trangLichYTa" fx:controller="iuh.se.nhom19.view.nurse.LichLamViecYTaController"
      stylesheets="@/css/chu-de.css, @/css/le-tan-dung-chung.css, @/css/y-ta-danh-sach.css"
      styleClass="khung-ung-dung, y-ta-trang-cho" spacing="18" minWidth="850">
    <HBox spacing="14" alignment="CENTER_LEFT">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Lịch làm việc" styleClass="trang-tieu-de"/>
            <Label text="Ca, thời gian và phòng được phân công · Chỉ xem" styleClass="mo"/>
        </VBox>
        <Button fx:id="btnTuanTruocYTa" text="‹" styleClass="phu-nut"/>
        <DatePicker fx:id="dpNgayLichYTa" editable="false" prefWidth="155"/>
        <Button fx:id="btnHomNayYTa" text="Hôm nay" styleClass="phu-nut"/>
        <Button fx:id="btnTuanSauYTa" text="›" styleClass="phu-nut"/>
        <Button fx:id="btnLamMoiLichYTa" text="Làm mới" styleClass="phu-nut"/>
    </HBox>
    <Label fx:id="lblKhoangTuanYTa" text="Tuần đang xem" styleClass="le-tan-the-tieu-de"/>
    <Label fx:id="lblThongBaoLichYTa" text="" wrapText="true" styleClass="y-ta-thong-bao"/>
    <VBox spacing="12" styleClass="le-tan-the" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblLichYTa" editable="false" fixedCellSize="58" prefHeight="500" VBox.vgrow="ALWAYS" styleClass="le-tan-bang">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="cotNgay" text="Ngày" minWidth="100" prefWidth="140" sortable="false" reorderable="false"/>
                <TableColumn fx:id="cotCa" text="Ca làm" minWidth="140" prefWidth="190" sortable="false" reorderable="false"/>
                <TableColumn fx:id="cotGio" text="Giờ làm" minWidth="110" prefWidth="140" sortable="false" reorderable="false"/>
                <TableColumn fx:id="cotPhong" text="Phòng" minWidth="80" prefWidth="100" sortable="false" reorderable="false"/>
                <TableColumn fx:id="cotCongViec" text="Nội dung công việc" minWidth="150" prefWidth="240" sortable="false" reorderable="false"/>
                <TableColumn fx:id="cotTrangThai" text="Trạng thái" minWidth="120" prefWidth="150" sortable="false" reorderable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
