# Sao chep thanh .env tai thu muc chua pom.xml; KHONG commit .env.
# Bien moi truong Eclipse uu tien hon .env. Gia tri sau = khong can escape ky tu.
# Moi thanh vien dung SQL Server LOCAL, cung ten database DENTAFLOW_DB.
# trustServerCertificate=true CHI cho phat trien local; production phai xac minh chung chi.
DENTAFLOW_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=DENTAFLOW_DB;encrypt=true;trustServerCertificate=true;loginTimeout=10;socketTimeout=15000
DENTAFLOW_DB_USER=
DENTAFLOW_DB_PASSWORD=

# Mac dinh KHONG seed va KHONG chay SQL integration tests.
DENTAFLOW_ALLOW_ACCOUNT_SEED=false
DENTAFLOW_SQL_IT=0

# Chi dien sau khi nhom dong y tao 4 tai khoan mau. Khong co mat khau mac dinh.
DENTAFLOW_TEST_MANAGER_PASSWORD=
DENTAFLOW_TEST_RECEPTIONIST_PASSWORD=
DENTAFLOW_TEST_DENTIST_PASSWORD=
DENTAFLOW_TEST_NURSE_PASSWORD=

# Chi bat DENTAFLOW_SQL_IT=1 khi muon test SQL CHI DOC voi tai khoan da ton tai.
# Dung ten va mat khau that do nhom cap; khong gui vao chat hoac commit.
DENTAFLOW_IT_MANAGER_USER=
DENTAFLOW_IT_MANAGER_PASSWORD=
DENTAFLOW_IT_RECEPTIONIST_USER=
DENTAFLOW_IT_RECEPTIONIST_PASSWORD=
DENTAFLOW_IT_DENTIST_USER=
DENTAFLOW_IT_DENTIST_PASSWORD=
DENTAFLOW_IT_NURSE_USER=
DENTAFLOW_IT_NURSE_PASSWORD=
